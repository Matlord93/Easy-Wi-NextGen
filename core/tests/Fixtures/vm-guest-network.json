[
  {
    "name": "dual_stack_windows_and_loopback",
    "input": [
      {
        "name": "Ethernet 2",
        "hardware-address": "AA:BB:CC:DD:EE:FF",
        "ip-addresses": [
          {
            "ip-address-type": "ipv4",
            "ip-address": "192.0.2.15",
            "prefix": 24
          },
          {
            "ip-address-type": "ipv6",
            "ip-address": "2001:0DB8:0:0:0:0:0:1",
            "prefix": 64
          }
        ]
      },
      {
        "name": "lo",
        "ip-addresses": [
          {
            "ip-address-type": "ipv4",
            "ip-address": "127.0.0.1",
            "prefix": 8
          },
          {
            "ip-address-type": "ipv6",
            "ip-address": "::1",
            "prefix": 128
          }
        ]
      }
    ],
    "expected": {
      "state": "available",
      "interfaces": [
        {
          "name": "Ethernet 2",
          "mac": "aa:bb:cc:dd:ee:ff",
          "addresses": [
            {
              "family": "ipv4",
              "address": "192.0.2.15",
              "prefix": 24
            },
            {
              "family": "ipv6",
              "address": "2001:db8::1",
              "prefix": 64
            }
          ]
        },
        {
          "name": "lo",
          "mac": null,
          "addresses": [
            {
              "family": "ipv4",
              "address": "127.0.0.1",
              "prefix": 8
            },
            {
              "family": "ipv6",
              "address": "::1",
              "prefix": 128
            }
          ]
        }
      ],
      "limited": false
    }
  },
