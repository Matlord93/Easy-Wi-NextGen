{% extends 'customer/base.html.twig' %}
{% block title %}Mietverträge und Guthaben{% endblock %}
{% block content %}
<div class="pm-workspace" data-panel-tabs="contracts">
<header class="pm-page-head">
    <div><h1>{{ 'workspace_my_contracts'|trans({},'panel_modules') }}</h1><p>{{ 'workspace_contract_intro'|trans({},'panel_modules') }}</p></div>
    <div class="pm-page-head__actions">
        {% if marketplaceVisible %}
            <a class="ui-button ui-button--primary" href="{{ path('customer_shop') }}">{{ 'workspace_rent_product'|trans({},'panel_modules') }}</a>
        {% endif %}
        <a class="ui-button ui-button--ghost" href="{{ path('customer_wallet') }}">{{ 'workspace_wallet'|trans({},'panel_modules') }}</a>
        {% if moduleBilling %}
            <a class="ui-button ui-button--ghost" href="{{ path('customer_billing') }}">{{ 'workspace_invoices'|trans({},'panel_modules') }}</a>
        {% endif %}
    </div>
</header>
{% include 'components/panel/_tabs.html.twig' with {panelKey:'contracts',panelTabs:{overview:'workspace_inventory',costs:'workspace_cost_overview',accounts:'workspace_wallet'}} %}
<div class="pm-stats">
    {% include 'components/panel/_stat.html.twig' with {value:contracts|length,label:'workspace_contracts_on_page'|trans({},'panel_modules')} only %}
    {% include 'components/panel/_stat.html.twig' with {value:contracts|filter(contract => contract.status == 'active')|length,label:'workspace_active_on_page'|trans({},'panel_modules')} only %}
    {% include 'components/panel/_stat.html.twig' with {value:contracts|filter(contract => contract.status == 'ended')|length,label:'workspace_ended_on_page'|trans({},'panel_modules')} only %}
</div>
{% for account in accounts %}<section class="cust-panel p-6 space-y-3" data-panel-section="accounts"><h2>Guthaben {{ account.currency }}</h2><p>{{ (account.balanceCents/100)|number_format(2,',','.') }} {{ account.currency }} · Rechnungslimit {{ (account.creditLimitCents/100)|number_format(2,',','.') }} {{ account.currency }}</p><p>Guthabenaufladungen und alle Buchungen findest du in der Guthabenübersicht.</p></section>{% else %}<section class="cust-panel p-6" data-panel-section="accounts"><p>Noch keine Mietkonten.</p><a href="{{ path('customer_wallet') }}">{{ 'workspace_wallet'|trans({},'panel_modules') }}</a></section>{% endfor %}
<section class="cust-panel p-6 space-y-3" data-panel-section="costs"><h2>Kostenübersicht</h2><p>Schätzung bei unveränderter Nutzung bis Monatsende. Kündigung beendet weitere Nutzungsgebühren; Domains werden gesondert berechnet.</p>{% for row in costs %}<p>Vertrag #{{ row.contract.id }} · noch nicht abgerechnet {{ (row.pending_units/4320000)|number_format(6,',','.') }} {{ row.contract.account.currency }} · voraussichtlich bis Monatsende {{ (row.forecast_units/4320000)|number_format(2,',','.') }} {{ row.contract.account.currency }}.</p>{% else %}<p>Keine laufende minutenbasierte Nutzung.</p>{% endfor %}</section><section class="cust-panel" data-panel-section="overview" data-panel-list>
<div class="pm-filters"><label class="sr-only" for="contract-search">{{ 'search'|trans({},'panel_modules') }}</label><input class="form-input" id="contract-search" type="search" data-panel-filter placeholder="{{ 'workspace_contract_search'|trans({},'panel_modules') }}"></div>
<div class="infra-table-wrap"><table class="cust-table"><thead><tr><th>{{ 'workspace_contract'|trans({},'panel_modules') }}</th><th>{{ 'workspace_product_type'|trans({},'panel_modules') }}</th><th>Status</th><th>{{ 'workspace_billing_mode'|trans({},'panel_modules') }}</th><th>{{ 'workspace_term'|trans({},'panel_modules') }}</th><th>{{ 'actions'|trans({},'panel_modules') }}</th></tr></thead><tbody>
{% for contract in contracts %}<tr data-panel-row><td><a class="pm-server-name" href="{{ path('customer_contract_detail',{id:contract.id}) }}">{{ contract.configuration.name }}</a><small class="pm-cell-sub">#{{ contract.id }}</small></td><td>{{ contract.kind.label }}</td><td><span class="ui-badge ui-badge--{{ contract.status == 'active' ? 'success' : 'neutral' }}">{{ {pending:'Bestellt',provisioning:'Einrichtung',active:'Aktiv',stopping:'Wird beendet',ended:'Beendet'}[contract.status] }}</span></td><td>{{ contract.billingMode == 'wallet' ? 'Guthaben' : 'Rechnung' }}</td><td>{% if contract.kind.value == 'domain' %}{{ contract.configuration.hostname }}<small class="pm-cell-sub">{{ contract.termEndsAt ? contract.termEndsAt|date('d.m.Y') : 'Registrierung noch offen' }}</small>{% else %}{{ (contract.monthlyCents/100)|number_format(2,',','.') }} {{ contract.account.currency }} / 30 Tage<small class="pm-cell-sub">{{ contract.chargedMinutes }} angefangene Minuten</small>{% endif %}</td><td><a class="ui-button ui-button--ghost" href="{{ path('customer_contract_detail',{id:contract.id}) }}">{{ 'management'|trans({},'panel_modules') }}</a></td></tr>{% else %}<tr><td colspan="6" class="cust-table__empty">Noch keine Mietverträge.</td></tr>{% endfor %}
</tbody></table></div><nav class="flex gap-4">{% if page > 1 %}<a href="?page={{ page-1 }}">Zurück</a>{% endif %}{% if contracts|length == 25 %}<a href="?page={{ page+1 }}">Weitere Verträge</a>{% endif %}</nav>
</section>
</div>
{% endblock %}
