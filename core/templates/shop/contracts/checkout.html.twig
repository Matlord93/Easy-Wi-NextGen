{% extends layout %}
{% block title %}{{ product.name }} mieten{% endblock %}
{% block content %}
<div class="ng-container ng-section cust-page space-y-6">
<section class="cust-panel ng-card p-6 space-y-4">
    <h1 class="text-2xl font-semibold">{{ product.name }}</h1>
    <p>{{ product.kind.label }} · {{ product.description }}</p><p>{{ availability.label }}</p>
    {% if product.imageUrl %}<img src="{{ product.imageUrl }}" alt="{{ product.name }}" loading="lazy" class="rounded-lg" style="max-height:220px">{% endif %}
    {% if domain_available is same as(true) %}<p>Die Domain ist laut Registrar verfügbar.</p>{% elseif domain_available is same as(false) %}<p role="alert">Die Domain ist nicht verfügbar oder benötigt eine gesonderte Preisprüfung.</p>{% endif %}
    {% if error %}<p role="alert" class="ng-alert">{{ error }}</p>{% endif %}
    {% if selection_expired %}<p role="status">{{ t('checkout_intent_expired', page_locale()) }}</p>{% endif %}
    <form method="post" class="ng-form space-y-3">
        <input type="hidden" name="_token" value="{{ csrf_token('rental-contract') }}">
        <input type="hidden" name="stage" value="preview">
        <label>Variante<select class="form-input" name="variant_id"><option value="0">Standard</option>{% for variant in variants %}<option value="{{ variant.id }}"{% if input.variant_id|default(0) == variant.id %} selected{% endif %}>{{ variant.name }} · {{ (variant.priceMonthlyCents/100)|number_format(2,',','.') }} {{ quote.currency|default('EUR') }} / {{ product.kind.value == 'domain' ? 'Monat der festen Laufzeit' : '30 Tage' }}</option>{% endfor %}</select></label>
        <label>Abrechnung<select class="form-input" name="billing_mode"><option value="postpaid"{% if input.billing_mode|default('postpaid') == 'postpaid' %} selected{% endif %}>Rechnung nach Nutzung</option><option value="wallet"{% if input.billing_mode|default('') == 'wallet' %} selected{% endif %}>Guthaben</option></select></label>
        {% if product.kind.value in ['webspace','domain','kvm','proxmox'] %}<label>{{ product.kind.virtualMachine ? 'Hostname' : 'Gewünschter Domainname' }}<input class="form-input" name="hostname" maxlength="253" value="{{ input.hostname|default('') }}" required></label>{% endif %}
        {% if product.kind.virtualMachine %}<label>SSH-Public-Keys<textarea class="form-input" name="ssh_keys" rows="4" maxlength="32768" required>{{ input.ssh_keys|default('') }}</textarea></label><p>Nur öffentliche SSH-Schlüssel eintragen.</p>{% endif %}
        {% if product.kind.value == 'domain' and product.provisioningOptions.registrar|default('manual') == 'autodns' %}<label>Domainauftrag<select class="form-input" name="domain_action"><option value="register">Neue Domain registrieren</option><option value="transfer"{% if input.domain_action|default('register') == 'transfer' %} selected{% endif %}>Vorhandene Domain zu uns übertragen</option></select></label><label>Authcode (nur beim Transfer)<input class="form-input" type="password" name="auth_code" value="{{ input.auth_code|default('') }}" maxlength="255" autocomplete="off"></label>{% endif %}
        <label>Gutschein<input class="form-input" name="coupon" value="{{ input.coupon|default('') }}" maxlength="40"></label>
        <button class="ui-button ui-button--primary ng-btn" type="submit">Tarif und Vertrag prüfen</button>
    </form>
</section>
{% if quote %}
<section class="cust-panel ng-card p-6 space-y-4">
    <h2 class="text-xl font-semibold">Vertragsübersicht</h2>
    <p>{{ quote.name }} {{ quote.variant }} · {{ quote.billing_mode == 'wallet' ? 'Guthabenabrechnung' : 'Rechnung nach Nutzung' }}</p>
    {% if product.kind.value == 'domain' %}
        <p><strong>{{ (quote.period_cents/100)|number_format(2,',','.') }} {{ quote.currency }} für {{ quote.term_months }} Monate feste Domainlaufzeit.</strong></p>
        <p>Die Kündigung verhindert die nächste Verlängerung. Der bereits bestätigte Registrierungszeitraum wird vollständig berechnet und bleibt bis zum Laufzeitende nutzbar. {{ product.provisioningOptions.registrar|default('manual') == 'autodns' ? 'Der Registrar bestätigt Registrierung und Verlängerung automatisch. Vollständige Inhaberkontaktdaten im Kundenprofil sind erforderlich.' : 'Der Betreiber bestätigt Registrierung und Verlängerung.' }} Vor der Bestätigung entstehen keine Domaingebühren.</p>
    {% else %}
        <p><strong>{{ (quote.monthly_cents/100)|number_format(2,',','.') }} {{ quote.currency }} je 30 Tage, entsprechend {{ (quote.monthly_cents/4320000)|number_format(8,',','.') }} {{ quote.currency }} je angefangener Minute.</strong></p>
        <p>Unbefristeter Mietvertrag, jederzeit ohne Kündigungsfrist kündbar. Abrechnung ab bestätigter Bereitstellung bis zum Kündigungszeitpunkt in angefangenen Minuten. Kein vorausbezahlter Monatsblock.</p>
        {% if product.kind.virtualMachine and quote.address_mode|default('dhcp') == 'pool' %}<p>Feste IP-Adressen aus dem IP-Pool sind im Tarif enthalten.</p>{% endif %}
        {% if product.kind.value in ['gameserver','kvm','proxmox'] %}<p>{{ quote.cpu }} {{ product.kind.value == 'webspace' ? 'CPU-Tarif' : 'CPU-Kerne' }} · {{ quote.ram }} GiB RAM · {{ quote.disk }} GiB Speicher</p>{% elseif product.kind.value == 'webspace' %}<p>{{ quote.disk }} GiB Webspace · PHP {{ quote.php_version|default('8.4') }}</p>{% else %}<p>{{ quote.slots|default(32) }} Voice-Slots</p>{% endif %}
        {% if product.kind.value == 'gameserver' %}<p>{{ quote.game_slots }} gebuchte Spielerslots</p>{% endif %}
    {% endif %}
    {% if quote.discount_cents > 0 %}<p>Gutschein berücksichtigt. Der bestätigte Tarif gilt für die Vertragslaufzeit; bei Domains gilt der Preis je bestätigtem Registrierungszeitraum.</p>{% endif %}
    <p>Alle Preise enthalten die anfallenden Steuern. Cent-Bruchteile werden über Verträge und Abrechnungen hinweg fortgeschrieben.</p>
    <p>{{ quote.billing_mode == 'wallet' ? 'Die Nutzung wird vom Guthaben abgezogen. Vor Bereitstellung wird der Preis der ersten Minute reserviert; bei Domains der feste Laufzeitpreis. Bei nicht ausreichendem Guthaben endet die Nutzung.' : 'Monatliche Rechnung nach tatsächlicher Nutzung; bei Kündigung erfolgt die Abschlussabrechnung. Das vom Betreiber festgelegte Rechnungslimit gilt für offene Rechnungen und laufende Nutzung zusammen.' }}</p>
    {% if ready and (requires_account or is_customer) %}
    {% if requires_account %}
        <p>{{ t(can_register ? 'checkout_account_intro' : 'portal_problem_login_required_message', page_locale()) }}</p>
    {% elseif profile_required %}
        <h3>{{ t('checkout_profile_action', page_locale()) }}</h3>
        <p>{{ t('checkout_profile_required', page_locale()) }}</p>
        {% if billing_errors %}
            <ul class="ng-alert ng-alert--danger" role="alert">
                {% for error in billing_errors %}<li>{{ t(error, page_locale()) }}</li>{% endfor %}
            </ul>
        {% endif %}
    {% endif %}
    <form method="post" class="space-y-3">
        <input type="hidden" name="_token" value="{{ csrf_token('rental-contract') }}">
        <input type="hidden" name="stage" value="{{ requires_account ? 'account' : (profile_required ? 'profile' : 'order') }}"><input type="hidden" name="digest" value="{{ digest }}"><input type="hidden" name="nonce" value="{{ nonce }}">
        {% for key in ['variant_id','billing_mode','hostname','ssh_keys','coupon','domain_action'] %}<input type="hidden" name="{{ key }}" value="{{ quote[key] }}">{% endfor %}
        {% if product.kind.value == 'domain' %}<input type="hidden" name="auth_code" value="{{ input.auth_code|default('') }}">{% endif %}
        {% if requires_account %}
            <button class="ui-button ui-button--primary ng-btn" type="submit">{{ t('log_in', page_locale()) }}</button>
            {% if can_register %}<button class="ui-button ui-button--ghost ng-btn" type="submit" name="register" value="1">{{ t('registration_customer_heading', page_locale()) }}</button>{% endif %}
        {% elseif profile_required %}
            {% include 'public/auth/_billing_fields.html.twig' %}
            <button class="ui-button ui-button--primary ng-btn" type="submit">{{ t('checkout_profile_save', page_locale()) }}</button>
        {% else %}
            <label><input type="checkbox" name="rental_terms" value="1" required> Ich bestätige den angezeigten Mietvertrag, Tarif und die Kündigungs- und Abrechnungsbedingungen.</label>
            <button class="ui-button ui-button--primary ng-btn" type="submit">Verbindlich mieten</button>
        {% endif %}
    </form>
    {% elseif ready %}<p role="status">{{ t('checkout_account_customer_only', page_locale()) }}</p><a href="{{ path('public_login', {target: app.request.pathInfo}) }}">{{ t('log_in', page_locale()) }}</a>
    {% elseif not availability.orderable %}<p role="status">Dieser Tarif kann derzeit nicht bestellt werden. Bitte später erneut versuchen oder einen anderen Tarif auswählen.</p>{% else %}<p>Bitte die erforderlichen Angaben ergänzen und den Tarif erneut prüfen.</p>{% endif %}
</section>
{% endif %}
<p><a href="{{ public_shop ? path('public_cms_shop') : path('customer_shop') }}">Zurück zum Shop</a> · <a href="{{ path('customer_contracts') }}">Meine Verträge und Guthaben</a></p>
</div>
{% endblock %}
