{% extends 'customer/base.html.twig' %}
{% block title %}Guthabenaufladung{% endblock %}
{% block content %}<div class="cust-page space-y-6"><section class="cust-panel p-6 space-y-3"><h1>Guthabenaufladung {{ topup.number }}</h1><p>{{ (topup.amountCents/100)|number_format(2,',','.') }} {{ topup.currency }}</p>{% if error %}<p role="alert">{{ error }}</p>{% endif %}
{% if topup.paidAt %}<p>Zahlung bestätigt am {{ topup.paidAt|date('d.m.Y H:i') }}. Gutgeschrieben: {{ (topup.creditedCents/100)|number_format(2,',','.') }} {{ topup.currency }}.</p>{% else %}<p>Die Rückkehr von einem Zahlungsanbieter allein bestätigt keine Zahlung. Eine noch ausstehende Bestätigung kann etwas Zeit benötigen.</p><form method="post" class="ng-form space-y-3"><input type="hidden" name="_token" value="{{ csrf_token('wallet-pay-' ~ topup.id) }}"><label>Zahlungsart<select class="form-input" name="provider">{% for method in methods %}<option value="{{ method }}">{{ {card:'Karte',klarna:'Klarna',sepa_debit:'SEPA-Lastschrift',paypal:'PayPal',bank_transfer:'Überweisung'}[method] }}</option>{% endfor %}</select></label><button class="ui-button" type="submit">Zahlung starten</button></form>
{% if 'bank_transfer' in methods %}<h2>Überweisung</h2><p>Empfänger: {{ billing.company_name }} · IBAN: {{ billing.company_iban }} · BIC: {{ billing.company_bic }}</p><p>Verwendungszweck: <strong>{{ topup.number }}</strong>. Der Betreiber bestätigt den tatsächlichen Geldeingang.</p>{% endif %}{% endif %}<p>Dieser Beleg dokumentiert eine Guthabenaufladung. Die Rechnung über steuerpflichtige Leistungen entsteht bei der Nutzungsabrechnung.</p><a href="{{ path('customer_wallet') }}">Guthaben und Buchungen</a></section></div>{% endblock %}
