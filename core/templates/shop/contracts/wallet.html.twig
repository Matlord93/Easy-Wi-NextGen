{% extends 'customer/base.html.twig' %}
{% block title %}Guthaben und Buchungen{% endblock %}
{% block content %}<div class="pm-workspace" data-panel-tabs="wallet">
<header class="pm-page-head"><div><h1>{{ 'workspace_wallet'|trans({},'panel_modules') }}</h1><p>{{ 'workspace_wallet_intro'|trans({},'panel_modules') }}</p></div><a class="ui-button ui-button--ghost" href="{{ path('customer_contracts') }}">{{ 'workspace_my_contracts'|trans({},'panel_modules') }}</a></header>
{% include 'components/panel/_tabs.html.twig' with {panelKey:'wallet',panelTabs:{overview:'overview',usage:'workspace_current_usage',history:'workspace_transactions',topups:'workspace_topups'}} %}
<section class="cust-panel p-6 space-y-3" data-panel-section="overview"><h2>Guthaben und Buchungen</h2><a href="{{ path('customer_contracts') }}">Meine Verträge</a>{% if error %}<p role="alert">{{ error }}</p>{% endif %}
{% for account in accounts %}<p>{{ (account.balanceUnits/4320000)|number_format(6,',','.') }} {{ account.currency }} Guthaben · {{ (account.availableUnits/4320000)|number_format(6,',','.') }} {{ account.currency }} verfügbar nach Reservierungen.</p>{% endfor %}
<form method="post" class="ng-form space-y-3"><input type="hidden" name="_token" value="{{ csrf_token('wallet') }}"><input type="hidden" name="nonce" value="{{ nonce }}"><input type="hidden" name="currency" value="{{ currency }}"><label>Aufladebetrag {{ currency }}<input class="form-input" name="amount" value="10.00" required></label><button class="ui-button" type="submit">Aufladung vorbereiten</button></form><p>Die Gutschrift erfolgt nach bestätigtem Zahlungseingang. Aufladungen sind Guthabenbelege; die Nutzung wird gesondert abgerechnet.</p></section>
<section class="cust-panel p-6 space-y-3" data-panel-section="usage"><h2>Laufende, bereits abgezogene Nutzung</h2>{% for contract in pending %}<p>Vertrag #{{ contract.id }} · {{ contract.chargedMinutes - contract.invoicedMinutes }} Minuten · {{ (contract.pendingUnits/4320000)|number_format(6,',','.') }} {{ contract.account.currency }}. Die abgeschlossene Buchung folgt mit der Nutzungsabrechnung.</p>{% else %}<p>Keine noch abzurechnende Guthabennutzung.</p>{% endfor %}</section>
<section class="cust-panel p-6 space-y-3" data-panel-section="history"><h2>Buchungshistorie</h2>{% for entry in entries %}<p>{{ entry.createdAt|date('d.m.Y H:i') }} · {{ entry.description }} · {{ (entry.units/4320000)|number_format(6,',','.') }} {{ entry.account.currency }} · {{ entry.reference }}{% if entry.invoice %} · <a href="{{ path('customer_billing_invoice',{id:entry.invoice.id}) }}">Rechnung {{ entry.invoice.number }}</a>{% endif %}</p>{% else %}<p>Noch keine Buchungen.</p>{% endfor %}<nav>{% if page > 1 %}<a href="?page={{ page-1 }}">Zurück</a>{% endif %} {% if entries|length == 50 %}<a href="?page={{ page+1 }}">Weitere Buchungen</a>{% endif %}</nav></section>
<section class="cust-panel p-6 space-y-3" data-panel-section="topups"><h2>Aufladungen</h2>{% for topup in topups %}<p><a href="{{ path('customer_wallet_topup',{id:topup.id}) }}">{{ topup.number }}</a> · {{ (topup.amountCents/100)|number_format(2,',','.') }} {{ topup.currency }} · {{ topup.paidAt ? 'Zahlung eingegangen' : 'Zahlung offen' }}</p>{% endfor %}</section></div>{% endblock %}
