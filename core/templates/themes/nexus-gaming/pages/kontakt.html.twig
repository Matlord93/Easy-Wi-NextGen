{% extends 'themes/' ~ (active_theme|default('nexus-gaming')) ~ '/base.html.twig' %}
{% set locale = page_locale() %}

{% block title %}Kontakt – {{ app_setting('branding_name', 'Easy-Wi NextGen') }}{% endblock %}

{% block content %}
<div class="ng-contact-page">
  <div class="ng-contact-page__header">
    <h1 class="ng-contact-page__title">{{ t('theme_contact_title', page_locale()) }}</h1>
    <p class="ng-contact-page__subtitle">{{ t('theme_contact_subtitle', page_locale()) }}</p>
  </div>

  {% if success %}
    <div class="ng-contact-success" role="status">
      <strong>{{ t('theme_contact_success_title', page_locale()) }}</strong> {{ t('theme_contact_success_body', page_locale()) }}
    </div>
  {% else %}
    {% if error is not null %}
      <div class="ng-contact-error" style="margin-bottom:16px" role="alert">{{ t(error, locale) }}</div>
    {% endif %}

    <form method="post" action="{{ path('public_kontakt') }}" class="ng-contact-form"
          {% if protection.pow_difficulty > 0 %}data-form-pow="{{ protection.pow_difficulty }}" data-form-nonce="{{ protection.nonce }}"{% endif %}>
      <div class="ng-contact-form__row">
        <div class="ng-contact-form__field">
          <label class="ng-contact-form__label" for="contact_name">{{ t('theme_contact_label_name', page_locale()) }}</label>
          <input class="ng-contact-form__input" type="text" id="contact_name" name="name" value="{{ form.name|default('') }}" required maxlength="140" placeholder="{{ t('theme_contact_placeholder_name', page_locale()) }}">
        </div>
        <div class="ng-contact-form__field">
          <label class="ng-contact-form__label" for="contact_email">E-Mail *</label>
          <input class="ng-contact-form__input" type="email" id="contact_email" name="email" value="{{ form.email|default('') }}" required maxlength="180" placeholder="{{ t('theme_contact_placeholder_email', page_locale()) }}">
        </div>
      </div>

      <div class="ng-contact-form__field">
        <label class="ng-contact-form__label" for="contact_subject">{{ t('theme_contact_label_subject', page_locale()) }}</label>
        <input class="ng-contact-form__input" type="text" id="contact_subject" name="subject" value="{{ form.subject|default('') }}" required maxlength="255" placeholder="{{ t('theme_contact_placeholder_subject', page_locale()) }}">
      </div>

      <div class="ng-contact-form__field">
        <label class="ng-contact-form__label" for="contact_message">{{ t('theme_contact_label_message', page_locale()) }}</label>
        <textarea class="ng-contact-form__textarea" id="contact_message" name="message" required maxlength="5000" placeholder="{{ t('theme_contact_placeholder_message', page_locale()) }}">{{ form.message|default('') }}</textarea>
      </div>

      {% include 'public/_contact_challenge.html.twig' with {
        form_key: 'public_kontakt', field_class: 'ng-contact-form__field', label_class: 'ng-contact-form__label', input_class: 'ng-contact-form__input'
      } %}
      <div class="ng-contact-form__actions">
        <button type="submit" class="ng-btn ng-btn--primary" {{ protection.pow_difficulty > 0 ? 'disabled' : '' }}>{{ t('theme_contact_submit', page_locale()) }}</button>
      </div>
    </form>
  {% endif %}
</div>
{% endblock %}
