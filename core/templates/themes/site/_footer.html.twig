{% import 'cms/layout/_navigation_link.html.twig' as navigation %}
<footer class="cms-footer"><div class="cms-container cms-footer__inner"><div><a class="cms-brand" href="/">{{ brandName }}</a><p>© {{ 'now'|date('Y') }} {{ brandName }}</p></div><nav aria-label="{{ 'footer_navigation'|cms_trans({}) }}">{% set hasPolicy = false %}{% set hasSettings = false %}{% for item in cmsSite.footer %}{% set localPath = not item.external ? item.url|split('?')[0]|split('#')[0]|trim('/') : '' %}{% set isPolicy = localPath in ['cookies','cookie-richtlinie'] %}{% set isSettings = localPath in ['cookie-preferences','cookie-preferenzen','cookie-einstellungen'] %}{% if not (isPolicy and hasPolicy) and not (isSettings and hasSettings) %}{{ navigation.link(item) }}{% endif %}{% set hasPolicy = hasPolicy or isPolicy %}{% set hasSettings = hasSettings or isSettings %}{% endfor %}{% if not hasPolicy %}<button class="cms-text-button" type="button" data-cookie-policy>{{ t('cookie_policy',page_locale()) }}</button>{% endif %}{% if not hasSettings %}<button class="cms-text-button" type="button" data-cookie-open>{{ t('cookie_settings',page_locale()) }}</button>{% endif %}</nav>{% if cmsSite.branding.socials|default({}) %}<div class="cms-socials">{% for name,url in cmsSite.branding.socials %}{% if url and (url starts with 'https://' or url starts with 'http://') %}<a href="{{ url }}" target="_blank" rel="noopener noreferrer">{{ name|capitalize }}</a>{% endif %}{% endfor %}</div>{% endif %}</div></footer>
