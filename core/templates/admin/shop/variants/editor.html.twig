{% extends 'admin/shop/base.html.twig' %}
{% block title %}Shop · Variante {{ variant ? 'bearbeiten' : 'anlegen' }}{% endblock %}
{% block content %}<div class="pm-workspace shop-workspace">
<header class="pm-page-head"><div><p class="shop-eyebrow">Shop / {{ product.kind.label }} / {{ product.name }}</p><h1>{{ variant ? variant.name ~ ' bearbeiten' : 'Variante anlegen' }}</h1><p>Tarif und passende Ressourcen für dieses Produkt konfigurieren.</p></div><a class="ui-button" href="{{ path('admin_shop_variants',{id:product.id}) }}">Zur Variantenliste</a></header>
{% include 'admin/shop/_navigation.html.twig' %}{% include 'admin/shop/_product_navigation.html.twig' with {section:'variants'} %}
{% if error %}<p class="shop-alert" role="alert">{{ error }} Deine Eingaben bleiben erhalten.</p>{% elseif app.request.query.get('saved') %}<p class="shop-note" role="status">Variante gespeichert.</p>{% endif %}
{% set defaults={sku:variant ? variant.sku : '',name:variant ? variant.name : '',price:((variant ? variant.priceMonthlyCents : product.priceMonthlyCents)/100)|number_format(2,'.',''),cpu:variant ? variant.cpuLimit : product.cpuLimit,ram:variant ? variant.ramLimit : product.ramLimit,disk:variant ? variant.diskLimit : product.diskLimit,slots:variant ? variant.slots : ''} %}{% set form = input is not null ? defaults|merge(input) : defaults %}
<form method="post" class="ng-form shop-editor" data-variant-editor="{{ product.kind.value }}"><input type="hidden" name="_token" value="{{ csrf_token('shop-variant-' ~ product.id) }}">
<fieldset class="shop-form-section"><legend>Variante & Tarif</legend><div class="shop-fields">
<label>SKU<input class="form-input" name="sku" maxlength="80" value="{{ variant ? variant.sku : form.sku }}" pattern="[A-Za-z0-9][A-Za-z0-9_-]{1,79}" required{% if variant %} readonly{% endif %}></label><label>Name<input class="form-input" name="name" maxlength="120" value="{{ form.name }}" required></label><label>{{ product.kind.value == 'domain' ? 'Monatlicher Anteil der festen Laufzeit' : 'Preis je 30 Tage' }} ({{ currency }})<input class="form-input" name="price" inputmode="decimal" value="{{ form.price }}" required></label>
{% if product.kind.value in ['gameserver','kvm','proxmox'] %}<label>CPU-Kerne<input class="form-input" type="number" name="cpu" min="1" max="{{ product.kind.virtualMachine ? 256 : 21474836 }}" value="{{ form.cpu }}" required></label><label>RAM (GiB)<input class="form-input" type="number" name="ram" min="1" max="{{ product.kind.virtualMachine ? 1024 : 2097151 }}" value="{{ form.ram }}" required></label>{% endif %}
{% if product.kind.value in ['gameserver','kvm','proxmox','webspace'] %}<label>Speicher (GiB)<input class="form-input" type="number" name="disk" min="1" max="{{ product.kind.virtualMachine ? 2048 : 2097151 }}" value="{{ form.disk }}" required></label>{% endif %}
{% if product.kind.value in ['gameserver','teamspeak3','teamspeak6'] %}
    {% set game = product.kind.value == 'gameserver' %}
    <label>{{ game ? 'Gebuchte Spielerslots' : 'Voice-Slots' }} (leer = Standardprodukt)<input class="form-input" type="number" name="slots" min="1" max="1024" value="{{ form.slots }}"><span class="shop-field-hint">Standardprodukt: {{ game ? product.gameserverSlots : product.provisioningOptions.slots|default(32) }} Slots</span></label>
{% endif %}
</div><label class="shop-check"><input type="checkbox" name="active" value="1"{% if input is not null ? input.active|default('0') == '1' : (not variant or variant.active) %} checked{% endif %}> Für neue Bestellungen aktiv</label><p>Die SKU bleibt nach der Anlage unverändert. Bestehende Verträge und Bestellungen werden durch spätere Änderungen nicht neu berechnet.</p></fieldset>
<div class="shop-editor-actions"><a class="ui-button" href="{{ path('admin_shop_variants',{id:product.id}) }}">Abbrechen</a><button class="ui-button ui-button--primary" type="submit">Variante speichern</button></div>
</form></div>{% endblock %}
