{% extends 'admin/shop/base.html.twig' %}
{% block title %}Shop · Varianten für {{ product.name }}{% endblock %}
{% block content %}<div class="pm-workspace shop-workspace">
<header class="pm-page-head"><div><p class="shop-eyebrow">Shop / {{ product.kind.label }}</p><h1>{{ product.name }} · Varianten</h1><p>Weitere Tarife desselben Produkts. Bestätigte Verträge behalten ihre gespeicherten Preise und Ressourcen.</p></div><a class="ui-button ui-button--primary" href="{{ path('admin_shop_variant_new',{id:product.id}) }}">+ Variante anlegen</a></header>
{% include 'admin/shop/_navigation.html.twig' %}{% include 'admin/shop/_product_navigation.html.twig' with {section:'variants'} %}
<aside class="shop-note"><p>Der Standardtarif bleibt immer verfügbar, solange das Produkt freigegeben ist. Varianten teilen sich Bereitstellungsziel und Kapazitätspool. Deaktivierte Varianten werden für neue Bestellungen ausgeblendet.</p></aside>
<section class="shop-product-list" aria-label="Varianten">{% for variant in variants %}<article class="shop-product-row" data-shop-variant="{{ variant.id }}"><div><p class="shop-eyebrow">{{ variant.sku }}</p><h2>{{ variant.name }}</h2><p>{{ (variant.priceMonthlyCents/100)|number_format(2,',','.') }} {{ currency }} / {{ product.kind.value == 'domain' ? 'Monat der festen Laufzeit' : '30 Tage' }}</p></div><div><p>{{ variant.active ? 'Aktiv' : 'Deaktiviert' }}</p>{% if product.kind.value in ['gameserver','kvm'] %}<p>{{ variant.cpuLimit }} CPU · {{ variant.ramLimit }} GiB RAM · {{ variant.diskLimit }} GiB Speicher</p>{% elseif product.kind.value == 'webspace' %}<p>{{ variant.diskLimit }} GiB Webspace</p>{% elseif product.kind.value in ['teamspeak3','teamspeak6'] %}<p>{{ variant.slots is not null ? variant.slots ~ ' Voice-Slots' : 'Slotzahl des Standardprodukts' }}</p>{% else %}<p>{{ product.provisioningOptions.term_months|default(12) }} Monate feste Laufzeit</p>{% endif %}</div><a class="ui-button" href="{{ path('admin_shop_variant_edit',{id:product.id,variantId:variant.id}) }}">Bearbeiten</a></article>{% else %}<div class="shop-empty"><h2>Noch keine zusätzlichen Varianten</h2><p>Der Standardtarif wird über die Produktdaten verwaltet.</p></div>{% endfor %}</section>
{% if page > 1 or has_more %}<nav class="shop-pagination" aria-label="Variantenseiten">{% if page > 1 %}<a class="ui-button" href="{{ path('admin_shop_variants',{id:product.id,page:page-1}) }}">Zurück</a>{% endif %}<span>Seite {{ page }}</span>{% if has_more %}<a class="ui-button" href="{{ path('admin_shop_variants',{id:product.id,page:page+1}) }}">Weitere Varianten</a>{% endif %}</nav>{% endif %}
</div>{% endblock %}
