{% extends 'admin/shop/base.html.twig' %}
{% block title %}Shop · {{ selected ? selected.label : 'Produkte' }}{% endblock %}
{% block content %}
<div class="pm-workspace shop-workspace">
<header class="pm-page-head"><div><p class="shop-eyebrow">Shop-Verwaltung</p><h1>{{ selected ? selected.label ~ '-Produkte' : 'Produkte & Tarife' }}</h1><p>{{ selected ? 'Tarife, Bereitstellungsziele und Verkaufsfreigaben dieser Produktart.' : 'Zuerst die Produktart wählen. Danach Tarif und Bereitstellung passend zum System einrichten.' }}</p></div>{% if selected %}<a class="ui-button ui-button--primary" href="{{ path('admin_rental_product_new',{kind:selected.value}) }}">+ Produkt anlegen</a>{% endif %}</header>
{% include 'admin/shop/_navigation.html.twig' %}
{% if not selected %}
<section class="shop-kind-grid" aria-label="Produktart auswählen">
{% set descriptions = {gameserver:'Gameserver-Template, Agent, Ressourcen und Portbedarf zuordnen.',kvm:'KVM-Tarife mit Image, Netzwerk und festen Ressourcen einrichten.',teamspeak3:'Voice-Node auswählen und TeamSpeak-3-Tarife nach Slots anbieten.',teamspeak6:'TeamSpeak 6 mit eigenem Node und passender Slotzahl anbieten.',webspace:'Webserver-Agent, PHP-Version und Speicherplatz konfigurieren.',domain:'Domainendung, Registrar und feste Laufzeit festlegen.'} %}
{% set symbols = {gameserver:'G',kvm:'VM',teamspeak3:'TS3',teamspeak6:'TS6',webspace:'WEB',domain:'DNS'} %}
{% for kind in kinds %}<a class="shop-kind-card" href="{{ path('admin_rental_product_kind',{kind:kind.value}) }}" data-shop-kind="{{ kind.value }}"><span class="shop-kind-icon" aria-hidden="true">{{ symbols[kind.value] }}</span><span class="shop-kind-card__count">{{ counts[kind.value]|default(0) }} {{ counts[kind.value]|default(0) == 1 ? 'Produkt' : 'Produkte' }}</span><h2>{{ kind.value == 'kvm' ? 'KVM / Proxmox' : (kind.value == 'webspace' ? 'Webserver / Webspace' : kind.label) }}</h2><p>{{ descriptions[kind.value] }}</p><span class="shop-kind-card__action">Produkte verwalten <span aria-hidden="true">→</span></span></a>{% endfor %}
</section>
<section class="shop-note"><h2>Vom Tarif zur Bestellung</h2><p>Produkt anlegen → Zielsystem zuordnen → Verkaufskapazität freigeben → im CMS oder Kundenbereich anbieten. Eine Veröffentlichung reserviert noch keine Ressourcen.</p><p>Proxmox-Systeme werden derzeit in der <a href="{{ path('admin_proxmox') }}">Proxmox-Verwaltung</a> angelegt und zugewiesen. Die automatische Shop-Bereitstellung virtueller Server verwendet den KVM-Agenten.</p></section>
{% else %}
<nav class="shop-kind-tabs" aria-label="Produktarten"><a href="{{ path('admin_rental_products') }}">Alle Produktarten</a>{% for kind in kinds %}<a href="{{ path('admin_rental_product_kind',{kind:kind.value}) }}"{% if selected == kind %} aria-current="page"{% endif %}>{{ kind.label }} <span>{{ counts[kind.value]|default(0) }}</span></a>{% endfor %}</nav>
{% if selected.value == 'kvm' %}<aside class="shop-note"><p>Diese Tarife werden über den KVM-Agenten bereitgestellt. <a href="{{ path('admin_proxmox') }}">Proxmox-Systeme separat verwalten</a>. Proxmox-Cluster sind keine KVM-Agenten und werden hier nicht als solche hinterlegt.</p></aside>{% endif %}
<form method="get" class="shop-search" role="search"><label for="shop-product-search">Produkt suchen</label><div><input class="form-input" type="search" id="shop-product-search" name="q" maxlength="100" value="{{ search }}" placeholder="Name des Produkts"><button class="ui-button" type="submit">Suchen</button>{% if search != '' %}<a href="{{ path('admin_rental_product_kind',{kind:selected.value}) }}">Zurücksetzen</a>{% endif %}</div></form>
<section class="shop-product-list" aria-label="Produkte">
{% for product in products %}{% set availability = rental_readiness(product) %}<article class="shop-product-row" data-shop-product="{{ product.id }}"><div><p class="shop-eyebrow">{{ product.category.name }}</p><h2><a href="{{ path('admin_rental_product_edit',{kind:product.kind.value,id:product.id}) }}">{{ product.name }}</a></h2><p>{{ (product.priceMonthlyCents/100)|number_format(2,',','.') }} {{ currency }} / {{ product.kind.value == 'domain' ? 'Monat der festen Laufzeit' : '30 Tage' }}</p><div class="shop-badges"><span>{{ product.active ? 'Aktiv' : 'Deaktiviert' }}</span><span>{{ product.publicActive ? 'CMS sichtbar' : 'CMS ausgeblendet' }}</span><span>{{ product.customerActive ? 'Kundenbereich sichtbar' : 'Kundenbereich ausgeblendet' }}</span>{% if not product.category.active %}<span>Kategorie deaktiviert</span>{% endif %}</div></div><div class="shop-product-row__status"><span class="shop-status" data-state="{{ availability.state }}">{{ availability.label }}</span><p>{{ availability.detail }}</p></div><div class="shop-row-actions"><a href="{{ path('admin_shop_variants',{id:product.id}) }}">Varianten</a><a class="ui-button" href="{{ path('admin_rental_product_edit',{kind:product.kind.value,id:product.id}) }}">Bearbeiten</a>{% if availability.target %}<a href="{{ path('admin_rental_product_capacity',{kind:product.kind.value,id:product.id}) }}">Kapazität prüfen</a>{% endif %}</div></article>
{% else %}<div class="shop-empty"><h2>{{ search != '' ? 'Keine passenden Produkte' : 'Noch keine Produkte dieser Art' }}</h2><p>{{ search != '' ? 'Suche ändern oder zurücksetzen.' : 'Ein Produkt fasst Tarif, Zielsystem und Sichtbarkeit zusammen.' }}</p><a class="ui-button ui-button--primary" href="{{ path('admin_rental_product_new',{kind:selected.value}) }}">Produkt anlegen</a></div>{% endfor %}
</section>
{% if page > 1 or has_more %}<nav class="shop-pagination" aria-label="Produktseiten">{% if page > 1 %}<a class="ui-button" href="{{ path('admin_rental_product_kind',{kind:selected.value,page:page-1,q:search}) }}">Zurück</a>{% endif %}<span>Seite {{ page }}</span>{% if has_more %}<a class="ui-button" href="{{ path('admin_rental_product_kind',{kind:selected.value,page:page+1,q:search}) }}">Weitere Produkte</a>{% endif %}</nav>{% endif %}
{% endif %}
</div>
{% endblock %}
