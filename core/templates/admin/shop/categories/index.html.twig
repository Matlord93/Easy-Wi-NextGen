{% extends 'admin/shop/base.html.twig' %}
{% set activeNav = 'shop-categories' %}
{% set locale = page_locale() %}
{% block content %}
<div class="pm-workspace" data-panel-tabs="shop-categories">
    <header class="pm-page-head"><div><h1>{{ 'workspace_shop_categories'|trans({},'panel_modules') }}</h1><p>{{ 'workspace_shop_categories_intro'|trans({},'panel_modules') }}</p></div><a class="ui-button ui-button--primary" href="#pm-shop-categories-create" hx-get="/admin/shop/categories/form" hx-target="#shop-categories-form" hx-swap="outerHTML" data-panel-reveal="create">+ {{ 'create'|trans({},'panel_modules') }}</a></header>
    {% include 'admin/shop/_navigation.html.twig' %}
    {% include 'components/panel/_tabs.html.twig' with {panelKey:'shop-categories',panelTabs:{overview:'workspace_inventory',create:'workspace_shop_editor'}} %}
    <div class="pm-stats">
        {% include 'components/panel/_stat.html.twig' with {value:categories|length,label:'workspace_listed_entries'|trans({},'panel_modules')} only %}
        {% include 'components/panel/_stat.html.twig' with {value:categories|filter(row => row.active)|length,label:'workspace_active'|trans({},'panel_modules')} only %}
        {% include 'components/panel/_stat.html.twig' with {value:categories|filter(row => not row.active)|length,label:'workspace_inactive'|trans({},'panel_modules')} only %}
    </div>
    <section data-panel-section="overview">{% include 'admin/shop/categories/_table.html.twig' with {categories:categories} %}</section>
    <section data-panel-section="create">{% include 'admin/shop/categories/_form.html.twig' with {form:form} %}</section>
</div>
{% endblock %}
