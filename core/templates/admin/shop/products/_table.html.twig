<div id="shop-products-table" class="ng-data-card" data-panel-list hx-get="/admin/shop/products/table" hx-trigger="shop-products-changed from:body" hx-swap="outerHTML">
    <div class="ng-data-card__header"><h2 class="ng-data-card__title">{{ 'workspace_shop_products'|trans({},'panel_modules') }}</h2><button class="ui-button ui-button--ghost" type="button" hx-get="/admin/shop/products/table" hx-target="#shop-products-table" hx-swap="outerHTML">{{ t('refresh',page_locale()) }}</button></div>
    <div class="pm-filters"><label class="sr-only" for="shop-products-search">{{ 'search'|trans({},'panel_modules') }}</label><input class="form-input" id="shop-products-search" type="search" data-panel-filter placeholder="{{ 'workspace_catalog_search'|trans({},'panel_modules') }}"></div>
{% set locale = page_locale() %}
<div class="overflow-x-auto">
    <table class="cust-table">
        <thead class="border-b border-slate-200 bg-slate-50 text-left text-xs uppercase text-slate-600">
            <tr>
                <th class="px-5 py-3">Name</th>
                <th class="px-5 py-3">Kategorie</th>
                <th class="px-5 py-3">Preis/Monat</th>
                <th class="px-5 py-3">Ressourcen</th>
                <th class="px-5 py-3">Status</th>
                <th class="px-5 py-3">Bereiche</th>
                <th class="px-5 py-3 text-right">Aktion</th>
            </tr>
        </thead>
        <tbody class="divide-y divide-slate-200">
            {% for product in products %}
                <tr data-panel-row>
                    <td class="px-5 py-4 font-medium text-slate-900">{{ product.name }}</td>
                    <td class="px-5 py-4 text-slate-600">{{ product.category }}</td>
                    <td class="px-5 py-4 text-slate-600">€ {{ product.price_monthly }}</td>
                    <td class="px-5 py-4 text-slate-600">{{ product.cpu_limit }} CPU · {{ product.ram_limit }} GB RAM · {{ product.disk_limit }} GB</td>
                    <td class="px-5 py-4">
                        <span class="inline-flex rounded-full border px-2.5 py-1 text-xs font-semibold {{ product.is_active ? 'border-emerald-200 bg-emerald-50 text-emerald-700' : 'border-slate-200 bg-slate-50 text-slate-600' }}">
                            {{ (product.is_active ? 'workspace_active' : 'workspace_inactive')|trans({},'panel_modules') }}
                        </span>
                    </td>
                    <td class="px-5 py-4">
                        <div class="flex flex-wrap gap-2">
                            <span class="inline-flex rounded-full border px-2.5 py-1 text-xs font-semibold {{ product.is_public_active ? 'border-indigo-200 bg-indigo-50 text-indigo-700' : 'border-slate-200 bg-slate-50 text-slate-500' }}">
                                Seite
                            </span>
                            <span class="inline-flex rounded-full border px-2.5 py-1 text-xs font-semibold {{ product.is_customer_active ? 'border-emerald-200 bg-emerald-50 text-emerald-700' : 'border-slate-200 bg-slate-50 text-slate-500' }}">
                                Kundenbereich
                            </span>
                        </div>
                    </td>
                    <td class="px-5 py-4 text-right">
                        <div class="flex items-center justify-end gap-2">
                            {% if product.kind|default('gameserver') != 'gameserver' %}<a class="ui-button" href="{{ path('admin_rental_products') }}#product-{{ product.id }}">Konfigurieren</a>{% else %}<button class="ui-button ui-button--ghost ui-button--sm" hx-get="/admin/shop/products/{{ product.id }}/edit" hx-target="#shop-products-form" data-panel-reveal="create">
                                {{ t('admin_shop_edit', locale) }}
                            </button>{% endif %}
                            <button class="rounded-lg border border-rose-200 bg-rose-50 px-3 py-2 text-xs font-semibold text-rose-600" hx-post="/admin/shop/products/{{ product.id }}/delete" hx-headers='{"X-CSRF-TOKEN":"{{ csrf_token("admin-shop") }}"}' hx-confirm="{{ t('admin_shop_delete_confirm', locale) }}" hx-swap="none">
                                {{ t('admin_shop_delete', locale) }}
                            </button>
                        </div>
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="7" class="px-5 py-6 text-center text-slate-600">Noch keine Produkte.</td>
                </tr>
            {% endfor %}
        </tbody>
    </table>
</div>

</div>
