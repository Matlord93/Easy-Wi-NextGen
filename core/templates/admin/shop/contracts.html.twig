{% extends 'admin/shop/base.html.twig' %}
{% block title %}Mietverträge und Guthaben{% endblock %}
{% block content %}
<div class="pm-workspace ng-form" data-panel-tabs="admin-contracts">
<header class="pm-page-head"><div><h1 class="text-2xl font-semibold">Mietverträge, Guthaben und Nutzungsabrechnung</h1></div></header>
{% include 'admin/shop/_navigation.html.twig' %}
{% if error %}<p role="alert" class="ng-alert">{{ error }}</p>{% endif %}
{% include 'components/panel/_tabs.html.twig' with {panelKey:'admin-contracts',panelTabs:{overview:'workspace_contracts',accounts:'workspace_customer_accounts',booking:'workspace_account_booking',credits:'workspace_transactions'}} %}
<section data-panel-section="booking" class="ng-card p-5 space-y-4"><h2>Guthaben buchen oder Rechnungslimit festlegen</h2>
<p>Guthaben nur nach tatsächlichem Zahlungseingang oder als bewusst gewährte Gutschrift buchen. Eindeutige Referenzen verhindern doppelte Buchungen. Die Buchung wird protokolliert; Kunden können ihr Guthaben nicht selbst verändern.</p>
<form method="post" class="space-y-3"><input type="hidden" name="_token" value="{{ csrf_token('rental-admin') }}">
<label>Kunde<select class="form-input" name="customer_id">{% for customer in customers %}<option value="{{ customer.id }}">{{ customer.email }}</option>{% endfor %}</select></label>
<label>Währung<select class="form-input" name="currency">{% for currency in ['EUR','USD','GBP','CHF','SEK','NOK','DKK','PLN'] %}<option>{{ currency }}</option>{% endfor %}</select></label>
<label>Aktion<select class="form-input" name="action"><option value="credit">Guthaben gutschreiben</option><option value="limit">Rechnungslimit setzen</option></select></label>
<label>Betrag<input class="form-input" name="amount" placeholder="100.00" required></label><label>Eindeutige Buchungsreferenz<input class="form-input" name="reference" minlength="8" maxlength="120"></label><label>Buchungsgrund<input class="form-input" name="reason" maxlength="500"></label><button class="ui-button" type="submit">Buchen</button>
</form></section>
<section data-panel-section="accounts" class="ng-card p-5 space-y-3"><h2>Kundenkonten</h2>{% for account in accounts %}<p>{{ account.customer.email }} · {{ (account.balanceCents/100)|number_format(2,',','.') }} {{ account.currency }} Guthaben · Rechnungslimit {{ (account.creditLimitCents/100)|number_format(2,',','.') }} {{ account.currency }}</p>{% else %}<p>Noch keine Mietkonten.</p>{% endfor %}</section>
<section data-panel-section="overview" data-panel-list class="ng-card p-5 space-y-4"><div class="pm-filters"><label class="sr-only" for="admin-contract-search">{{ 'search'|trans({},'panel_modules') }}</label><input class="form-input" id="admin-contract-search" type="search" data-panel-filter placeholder="{{ 'workspace_contract_search'|trans({},'panel_modules') }}"></div><h2>Verträge</h2>{% for contract in contracts %}<details class="cust-panel pm-contract-editor" data-panel-row><summary><strong>#{{ contract.id }} · {{ contract.configuration.name }} · {{ contract.customer.email }}</strong><span class="ui-badge ui-badge--neutral">{{ contract.status }}</span></summary><p>{{ contract.kind.label }} · {{ contract.status }} · {{ contract.billingMode }} · {{ contract.chargedMinutes }} Minuten</p>{% if contract.startedAt %}<p>Beginn {{ contract.startedAt|date('d.m.Y H:i:s') }}{% if contract.endedAt %} · Ende {{ contract.endedAt|date('d.m.Y H:i:s') }}{% endif %}</p>{% endif %}{% if contract.error %}<p role="status">{{ contract.error }}</p>{% endif %}
{% if contract.kind.value == 'domain' and contract.configuration.registrar|default('manual') != 'autodns' and contract.status in ['provisioning','active'] and not contract.cancelledAt %}<form method="post" class="space-y-2"><input type="hidden" name="_token" value="{{ csrf_token('rental-admin') }}"><input type="hidden" name="action" value="domain-confirm"><input type="hidden" name="contract_id" value="{{ contract.id }}"><p>{{ contract.configuration.hostname }} · {{ (contract.configuration.period_cents/100)|number_format(2,',','.') }} {{ contract.account.currency }} / {{ contract.configuration.term_months }} Monate{% if contract.termEndsAt %} · Laufzeitende {{ contract.termEndsAt|date('d.m.Y') }}{% endif %}</p><label>Referenz der tatsächlich erfolgten Registrierung oder Verlängerung<input class="form-input" name="reference" minlength="3" maxlength="120" required></label><button class="ui-button" type="submit">Erfolgte Registrierung / Verlängerung bestätigen und berechnen</button></form>{% endif %}
{% if not contract.cancelledAt and contract.status not in ['ended','stopping'] %}<form method="post"><input type="hidden" name="_token" value="{{ csrf_token('rental-admin') }}"><input type="hidden" name="action" value="cancel"><input type="hidden" name="contract_id" value="{{ contract.id }}"><button class="ui-button" type="submit">Vertrag kündigen</button></form>{% endif %}</details>{% else %}<p>Keine Verträge.</p>{% endfor %}<nav>{% if page > 1 %}<a href="?page={{ page-1 }}">Zurück</a>{% endif %} {% if contracts|length == 25 %}<a href="?page={{ page+1 }}">Weitere</a>{% endif %}</nav></section>
<section data-panel-section="credits" class="ng-card p-5 space-y-3"><h2>Letzte Guthabenbuchungen</h2>{% for credit in credits %}<p>{{ credit.createdAt|date('d.m.Y H:i') }} · {{ credit.account.customer.email }} · {{ (credit.amountCents/100)|number_format(2,',','.') }} {{ credit.account.currency }} · {{ credit.reference }} · {{ credit.reason }}</p>{% endfor %}</section>
</div>
{% endblock %}
