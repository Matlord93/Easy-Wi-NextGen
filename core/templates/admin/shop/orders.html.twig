{% extends 'admin/shop/base.html.twig' %}
{% block title %}Shop · Bestellungen{% endblock %}
{% block content %}<div class="pm-workspace shop-workspace"><header class="pm-page-head"><div><p class="shop-eyebrow">Shop-Verwaltung</p><h1>Bestellungen</h1><p>Bestellhistorie, Rechnungen und Bearbeitungsbedarf.</p></div></header>{% include 'admin/shop/_navigation.html.twig' %}
<aside class="shop-note"><p>„provisioned“ bedeutet bei älteren Bestellungen: Verlängerung verbucht oder Installationsjob übergeben. Den technischen Installationsstatus zeigt die Instanz. Laufende Minutenverträge werden unter „Verträge“ verwaltet.</p></aside>
<section class="shop-product-list" aria-label="Bestellhistorie">{% for order in orders %}<article class="shop-product-row" data-shop-order="{{ order.id }}"><div><p class="shop-eyebrow">Bestellung #{{ order.id }}</p><h2>{{ order.configuration.name|default(order.product.name) }}</h2><p>{{ order.customer.email }}</p></div><div><p>{{ order.status.value }} · {{ (order.totalPriceCents/100)|number_format(2,',','.') }} {{ order.configuration.currency|default('EUR') }}</p>{% if order.invoice %}<p>Rechnung {{ order.invoice.number }} · {{ order.invoice.status.value }}</p>{% endif %}{% if order.processingError %}<p role="status">Bearbeitungsbedarf: {{ order.processingError }}</p>{% endif %}</div><div class="shop-row-actions">{% if order.contract %}<a class="ui-button" href="{{ path('admin_rental_contracts') }}">Verträge öffnen</a>{% elseif order.instance %}<a class="ui-button" href="/admin/instances/{{ order.instance.id }}">Instanz #{{ order.instance.id }}</a>{% endif %}</div></article>{% else %}<div class="shop-empty"><h2>Keine Bestellungen</h2></div>{% endfor %}</section>
{% if page > 1 or has_more %}<nav class="shop-pagination" aria-label="Bestellseiten">{% if page > 1 %}<a class="ui-button" href="{{ path('admin_shop_orders',{page:page-1}) }}">Zurück</a>{% endif %}<span>Seite {{ page }}</span>{% if has_more %}<a class="ui-button" href="{{ path('admin_shop_orders',{page:page+1}) }}">Weitere Bestellungen</a>{% endif %}</nav>{% endif %}</div>{% endblock %}
