{% extends 'admin/shop/base.html.twig' %}
{% block title %}Shop · Gutscheine{% endblock %}
{% block content %}<div class="pm-workspace shop-workspace">
<header class="pm-page-head"><div><p class="shop-eyebrow">Shop-Verwaltung</p><h1>Gutscheine & Rabatte</h1><p>Gültigkeit, Limits und verfügbare Rabattaktionen getrennt verwalten.</p></div><a class="ui-button ui-button--primary" href="{{ path('admin_shop_coupon_new') }}">+ Gutschein anlegen</a></header>
{% include 'admin/shop/_navigation.html.twig' %}
<aside class="shop-note"><p>Rabatte gelten auf den bestätigten Miettarif, bei Domains auf den festen Laufzeitpreis. Reservierungen und Verwendungen zählen gemeinsam gegen das Nutzungslimit. Änderungen betreffen neue Bestellungen; bestätigte Vertragstarife bleiben erhalten.</p></aside>
<section class="shop-product-list" aria-label="Gutscheine">{% for coupon in coupons %}<article class="shop-product-row" data-shop-coupon="{{ coupon.id }}"><div><h2>{{ coupon.code }}</h2><p>{{ coupon.discountType == 'percent' ? coupon.discountValue ~ ' %' : (coupon.discountValue/100)|number_format(2,',','.') ~ ' ' ~ currency }} Rabatt</p><p>Mindestbetrag {{ (coupon.minimumCents/100)|number_format(2,',','.') }} {{ currency }}</p></div><div><p>{{ coupon.active ? 'Aktiv' : 'Deaktiviert' }} · {{ coupon.usedCount }} / {{ coupon.maximumUses|default('unbegrenzt') }} reserviert/verwendet</p><p>{{ coupon.validFrom ? 'Ab ' ~ coupon.validFrom|date('d.m.Y') : 'Ohne Startdatum' }} · {{ coupon.validUntil ? 'bis ' ~ coupon.validUntil|date('d.m.Y') : 'ohne Enddatum' }}</p></div><a class="ui-button" href="{{ path('admin_shop_coupon_edit',{id:coupon.id}) }}">Bearbeiten</a></article>{% else %}<div class="shop-empty"><h2>Noch keine Gutscheine</h2><p>Eine neue Rabattaktion über „Gutschein anlegen“ einrichten.</p></div>{% endfor %}</section>
{% if page > 1 or has_more %}<nav class="shop-pagination" aria-label="Gutscheinseiten">{% if page > 1 %}<a class="ui-button" href="{{ path('admin_shop_coupons',{page:page-1}) }}">Zurück</a>{% endif %}<span>Seite {{ page }}</span>{% if has_more %}<a class="ui-button" href="{{ path('admin_shop_coupons',{page:page+1}) }}">Weitere Gutscheine</a>{% endif %}</nav>{% endif %}
</div>{% endblock %}
