{% extends 'admin/shop/base.html.twig' %}
{% block title %}Shop · Gutschein {{ coupon ? 'bearbeiten' : 'anlegen' }}{% endblock %}
{% block content %}<div class="pm-workspace shop-workspace">
<header class="pm-page-head"><div><p class="shop-eyebrow">Shop / Gutscheine</p><h1>{{ coupon ? coupon.code ~ ' bearbeiten' : 'Gutschein anlegen' }}</h1><p>Rabatt und Gültigkeit festlegen. Bereits bestätigte Verträge behalten ihren Tarif.</p></div><a class="ui-button" href="{{ path('admin_shop_coupons') }}">Zur Gutscheinliste</a></header>
{% include 'admin/shop/_navigation.html.twig' %}
{% if error %}<p class="shop-alert" role="alert">{{ error }} Deine Eingaben bleiben erhalten.</p>{% elseif app.request.query.get('saved') %}<p class="shop-note" role="status">Gutschein gespeichert.</p>{% endif %}
{% set defaults={code:coupon ? coupon.code : '',discount_type:coupon ? coupon.discountType : 'percent',discount_value:coupon ? (coupon.discountType == 'percent' ? coupon.discountValue : (coupon.discountValue/100)|number_format(2,'.','')) : '',minimum:coupon ? (coupon.minimumCents/100)|number_format(2,'.','') : '0.00',maximum_uses:coupon ? coupon.maximumUses : '',valid_from:coupon and coupon.validFrom ? coupon.validFrom|date('Y-m-d') : '',valid_until:coupon and coupon.validUntil ? coupon.validUntil|date('Y-m-d') : ''} %}{% set form = input is not null ? defaults|merge(input) : defaults %}
<form method="post" class="ng-form shop-editor" data-coupon-editor><input type="hidden" name="_token" value="{{ csrf_token('shop-coupon-' ~ (coupon ? coupon.id : 0)) }}">
<fieldset class="shop-form-section"><legend>Rabattaktion</legend><div class="shop-fields"><label class="shop-field-wide">Gutscheincode<input class="form-input" name="code" maxlength="40" pattern="[A-Za-z0-9][A-Za-z0-9_-]{2,39}" value="{{ coupon ? coupon.code : form.code }}" required{% if coupon %} readonly{% endif %}></label><label>Rabattart<select class="form-input" name="discount_type"><option value="percent"{% if form.discount_type == 'percent' %} selected{% endif %}>Prozent</option><option value="fixed"{% if form.discount_type == 'fixed' %} selected{% endif %}>Fester Betrag ({{ currency }})</option></select></label><label>Rabattwert<input class="form-input" name="discount_value" inputmode="decimal" value="{{ form.discount_value }}" required><span class="shop-field-hint">Prozent: ganze Zahl von 1 bis 100. Fester Betrag: in {{ currency }}.</span></label><label>Mindestbetrag ({{ currency }})<input class="form-input" name="minimum" inputmode="decimal" value="{{ form.minimum }}" required></label><label>Maximale Verwendungen<input class="form-input" name="maximum_uses" type="number" min="1" max="2147483647" value="{{ form.maximum_uses }}"><span class="shop-field-hint">Leer = unbegrenzt{% if coupon %} · bereits reserviert/verwendet: {{ coupon.usedCount }}{% endif %}</span></label><label>Gültig ab<input class="form-input" type="date" name="valid_from" value="{{ form.valid_from }}"></label><label>Gültig bis einschließlich<input class="form-input" type="date" name="valid_until" value="{{ form.valid_until }}"></label></div><label class="shop-check"><input type="checkbox" name="active" value="1"{% if input is not null ? input.active|default('0') == '1' : (not coupon or coupon.active) %} checked{% endif %}> Für neue Bestellungen aktiv</label><p>Der Gutscheincode und die bisherige Nutzungszahl bleiben beim Bearbeiten erhalten. Deaktivieren sperrt neue Verwendungen, ohne bestehende Vertragstarife zu verändern.</p></fieldset>
<div class="shop-editor-actions"><a class="ui-button" href="{{ path('admin_shop_coupons') }}">Abbrechen</a><button class="ui-button ui-button--primary" type="submit">Gutschein speichern</button></div></form>
</div>{% endblock %}
