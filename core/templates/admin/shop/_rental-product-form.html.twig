{% set opts = product ? product.provisioningOptions : {} %}
{% set defaults = {name:product ? product.name : '',description:product ? product.description : '',image_url:product ? product.imageUrl : '',category_id:product ? product.category.id : '',price:product ? (product.priceMonthlyCents/100)|number_format(2,'.','') : '',node_id:product and product.provisioningNode ? product.provisioningNode.id : '',template_id:product and product.gameTemplate ? product.gameTemplate.id : '',cpu:product ? product.cpuLimit : 1,ram:product ? product.ramLimit : 1,disk:product ? product.diskLimit : 10,ts3_node_id:opts.voice_node_id|default(0),ts6_node_id:opts.voice_node_id|default(0),slots:opts.slots|default(32),kvm_template:opts.kvm_template|default(''),network:opts.network|default('default'),network_type:opts.network_type|default('network'),address_mode:opts.address_mode|default('dhcp'),proxmox_cluster_id:opts.proxmox_cluster_id|default(0),proxmox_node:opts.proxmox_node|default(''),proxmox_template_id:opts.proxmox_template_id|default(''),php_version:opts.php_version|default('8.4'),registrar:opts.registrar|default('manual'),tld:opts.tld|default(''),term_months:opts.term_months|default(12)} %}
{% set form = input is not null ? defaults|merge(input) : defaults %}
<form method="post" class="ng-form shop-editor" data-shop-editor="{{ selected.value }}">
<input type="hidden" name="_token" value="{{ csrf_token('rental-products') }}"><input type="hidden" name="product_id" value="{{ product ? product.id : 0 }}"><input type="hidden" name="kind" value="{{ selected.value }}">
<fieldset class="shop-form-section"><legend><span>01</span> Produkt & Tarif</legend><div class="shop-fields">
<label class="shop-field-wide">Produktname<input class="form-input" name="name" maxlength="160" value="{{ form.name }}" required></label>
<label class="shop-field-wide">Beschreibung<textarea class="form-input" name="description" rows="3" maxlength="10000">{{ form.description }}</textarea></label>
<label>Kategorie<select class="form-input" name="category_id" required><option value="">Kategorie auswählen</option>{% for category in categories %}<option value="{{ category.id }}"{% if form.category_id == category.id %} selected{% endif %}>{{ category.name }}{{ not category.active ? ' (deaktiviert)' : '' }}</option>{% endfor %}</select></label>
<label>{{ selected.value == 'domain' ? 'Monatlicher Anteil der festen Domainlaufzeit' : 'Preis je 30 Tage' }}<input class="form-input" name="price" inputmode="decimal" value="{{ form.price }}" placeholder="10,00" required></label>
<label class="shop-field-wide">Produktbild (HTTP-/HTTPS-Adresse, optional)<input class="form-input" type="url" name="image_url" maxlength="255" value="{{ form.image_url }}"></label>
</div></fieldset>
<fieldset class="shop-form-section"><legend><span>02</span> Bereitstellung · {{ selected.label }}</legend><div class="shop-fields">
{% if selected.value in ['gameserver','kvm','webspace'] %}<label class="shop-field-wide">Ziel-Agent<select class="form-input" name="node_id" required><option value="">Agent auswählen</option>{% for node in nodes %}<option value="{{ node.id }}"{% if form.node_id == node.id %} selected{% endif %}>{{ node.name|default(node.id) }}</option>{% endfor %}</select></label>{% if nodes is empty %}<p class="shop-field-wide">Zuerst einen <a href="{{ path('admin_nodes') }}">Agenten einrichten</a>.</p>{% endif %}{% endif %}
{% if selected.value == 'gameserver' %}<label class="shop-field-wide">Installations-Basisverzeichnis (optional)<input class="form-input" name="instance_base_dir" value="{{ input is not null ? input.instance_base_dir|default('') : opts.instance_base_dir|default('') }}" placeholder="Automatisch aus den Installationsverzeichnissen des Ziel-Nodes"></label><p class="shop-field-wide">Ohne eigene Auswahl wird das erste im Node hinterlegte Installationsverzeichnis verwendet. Der Server erhält dort einen eigenen Instanzordner. Bereits vorhandene Installationspfade bleiben erhalten.</p><label class="shop-field-wide">Spiel / Gameserver-Template<select class="form-input" name="template_id" required><option value="">Template auswählen</option>{% for template in templates %}<option value="{{ template.id }}"{% if form.template_id == template.id %} selected{% endif %}>{{ template.name }}</option>{% endfor %}</select></label><p class="shop-field-wide">Installation und Portbedarf stammen aus dem gewählten <a href="{{ path('admin_templates') }}">Gameserver-Template</a>.</p>
{% elseif selected.value in ['teamspeak3','teamspeak6'] %}{% set nodeField = selected.value == 'teamspeak3' ? 'ts3_node_id' : 'ts6_node_id' %}<label>Voice-Node<select class="form-input" name="{{ nodeField }}" required><option value="0">Node auswählen</option>{% for node in voice_nodes %}<option value="{{ node.id }}"{% if form[nodeField] == node.id %} selected{% endif %}>{{ node.name }}</option>{% endfor %}</select></label><label>Voice-Slots<input class="form-input" type="number" name="slots" min="1" max="1024" value="{{ form.slots }}" required></label><p class="shop-field-wide">Node, Lizenz und freie Slots müssen zur ausgewählten TeamSpeak-Version passen.</p>
{% elseif selected.value == 'kvm' %}<label class="shop-field-wide">KVM-Katalog-Template (ID--Version)<input class="form-input" name="kvm_template" value="{{ form.kvm_template }}" placeholder="ubuntu--26.04-v1" required></label><label>Netzwerkname<input class="form-input" name="network" value="{{ form.network }}" required></label><label>Netzwerktyp<select class="form-input" name="network_type"><option value="network">Libvirt-Netzwerk</option><option value="bridge"{% if form.network_type == 'bridge' %} selected{% endif %}>Bridge</option></select></label>
<label>Adressvergabe<select class="form-input" name="address_mode">
    <option value="dhcp">DHCP</option>
    <option value="pool"{% if form.address_mode == 'pool' %} selected{% endif %}>Feste Adressen aus dem IP-Pool</option>
</select></label>
<p class="shop-field-wide">Für feste Adressen muss im gewählten <a href="{{ path('admin_kvm') }}">KVM-Netz</a> ein IP-Pool eingerichtet sein.</p>
{% elseif selected.value == 'proxmox' %}
<label>Proxmox-Cluster<select class="form-input" name="proxmox_cluster_id" required>
    <option value="">Cluster auswählen</option>
    {% for cluster in proxmox_clusters %}<option value="{{ cluster.id }}" {{ form.proxmox_cluster_id == cluster.id ? 'selected' : '' }}>{{ cluster.name }}</option>{% endfor %}
</select></label>
<label>Ziel-Node<input class="form-input" name="proxmox_node" value="{{ form.proxmox_node }}" pattern="[A-Za-z0-9][A-Za-z0-9_.-]{0,62}" maxlength="63" required></label>
<label>VM-ID der Vorlage<input class="form-input" type="number" name="proxmox_template_id" value="{{ form.proxmox_template_id }}" min="100" max="999999999" required></label>
<label>Adressvergabe<select class="form-input" name="address_mode">
    <option value="dhcp">DHCP</option>
    <option value="pool" {{ form.address_mode == 'pool' ? 'selected' : '' }}>Feste Adressen aus dem IP-Pool</option>
</select></label>
<p class="shop-field-wide">Der Scheduler richtet CPU, RAM und Systemdisk nach dem Tarif ein. Der gebuchte Speicher muss mindestens so groß wie die Systemdisk der Vorlage sein. Konfiguriere Vorlagen und Adresspools in der <a href="{{ path('admin_proxmox') }}">Proxmox-Verwaltung</a>.</p>
{% elseif selected.value == 'webspace' %}<label>PHP-Version<input class="form-input" name="php_version" value="{{ form.php_version }}" pattern="8\.[0-9]" required></label><p class="shop-field-wide">Der Agent muss die gewählte PHP-FPM-Runtime und Nginx unterstützen. Der Kunde gibt seinen Domainnamen bei der Bestellung an.</p>
{% elseif selected.value == 'domain' %}<label>Registrar<select class="form-input" name="registrar"><option value="manual">Manuelle Registrierung</option><option value="autodns"{% if form.registrar == 'autodns' %} selected{% endif %}>AutoDNS / InterNetX</option></select></label><label>Domainendung<input class="form-input" name="tld" value="{{ form.tld }}" placeholder="de"></label><label>Feste Laufzeit<select class="form-input" name="term_months">{% for months in [12,24,36] %}<option value="{{ months }}"{% if form.term_months == months %} selected{% endif %}>{{ months }} Monate</option>{% endfor %}</select></label><p class="shop-field-wide">AutoDNS benötigt eine passende Endung und <a href="{{ path('admin_shop_registrar') }}">konfigurierte Registrar-Zugangsdaten</a>. Domains werden mit fester Laufzeit abgerechnet.</p>{% endif %}
{% if selected.value in ['gameserver','kvm','proxmox'] %}<label>CPU-Kerne<input class="form-input" type="number" name="cpu" min="1" max="{{ selected.virtualMachine ? 256 : 21474836 }}" value="{{ form.cpu }}" required></label><label>RAM (GiB)<input class="form-input" type="number" name="ram" min="1" max="{{ selected.virtualMachine ? 1024 : 2097151 }}" value="{{ form.ram }}" required></label>{% endif %}
{% if selected.value == 'gameserver' %}
    <label>Gebuchte Spielerslots<input class="form-input" type="number" name="slots" min="1" max="1024" value="{{ input.slots ?? (product ? product.gameserverSlots : constant('App\\Module\\Core\\Domain\\Entity\\Instance::DEFAULT_SLOTS')) }}" required></label>
{% endif %}
{% if selected.value in ['gameserver','kvm','proxmox','webspace'] %}<label>Speicher (GiB)<input class="form-input" type="number" name="disk" min="1" max="{{ selected.virtualMachine ? 2048 : 2097151 }}" value="{{ form.disk }}" required></label>{% endif %}
</div></fieldset>
<fieldset class="shop-form-section"><legend><span>03</span> Sichtbarkeit & Freigabe</legend><div class="shop-checks">
<label><input type="checkbox" name="active" value="1"{% if input is not null ? input.active|default('0') == '1' : (not product or product.active) %} checked{% endif %}> Produkt aktiv</label><label><input type="checkbox" name="public" value="1"{% if input is not null ? input.public|default('0') == '1' : (not product or product.publicActive) %} checked{% endif %}> Im CMS anbieten</label><label><input type="checkbox" name="customer" value="1"{% if input is not null ? input.customer|default('0') == '1' : (not product or product.customerActive) %} checked{% endif %}> Im Kundenbereich anbieten</label>
</div><p>Die Sichtbarkeit allein erlaubt noch keine Bestellung. {{ selected.value == 'domain' ? 'Registrar und Domainverfügbarkeit werden bei der Bestellung geprüft.' : 'Nach dem Speichern die tatsächlich verkaufbaren Ressourcen des Zielsystems freigeben. Bereits freigegebene Budgets bleiben erhalten.' }}</p></fieldset>
<div class="shop-editor-actions"><a class="ui-button" href="{{ path('admin_rental_product_kind',{kind:selected.value}) }}">Abbrechen</a><button class="ui-button ui-button--primary" type="submit"{% if categories is empty %} disabled{% endif %}>{{ product ? 'Änderungen speichern' : 'Produkt anlegen' }}</button></div>
</form>
