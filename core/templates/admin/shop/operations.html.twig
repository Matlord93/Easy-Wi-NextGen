{% extends 'admin/shop/base.html.twig' %}
{% block title %}Shop-Betrieb und Kapazitäten{% endblock %}
{% block content %}<div class="pm-workspace ng-form" data-panel-tabs="shop-operations"><header class="pm-page-head"><div><h1>Shop-Betrieb, Kapazitäten und Aufbewahrung</h1></div></header>{% include 'admin/shop/_navigation.html.twig' %}{% if error %}<p role="alert">{{ error }}</p>{% endif %}
{% include 'components/panel/_tabs.html.twig' with {panelKey:'shop-operations',panelTabs:{overview:'overview',capacity:'workspace_capacity',topups:'workspace_topups',retention:'workspace_retention',adjustments:'workspace_account_booking',attention:'workspace_attention'}} %}
<section data-panel-section="overview" class="ng-card p-5 space-y-3"><h2>Betriebsübersicht</h2><p>Letzter erfolgreicher Lauf: {{ heartbeat.at|default('noch kein Lauf bestätigt') }}</p>{% for status,count in health %}<p>{{ {pending:'Offene Bestellungen',provisioning:'Bereitstellungen',active:'Aktive Verträge',stopping:'Stoppbestätigung ausstehend',ended:'Beendete Verträge',mail_failed:'Nicht zugestellte E-Mails'}[status]|default(status) }}: {{ count }}</p>{% endfor %}</section>
<section data-panel-section="retention" class="ng-card p-5 space-y-3"><h2>Zeitlimits und Aufbewahrung</h2><form method="post" class="space-y-3"><input type="hidden" name="_token" value="{{ csrf_token('rental-operations') }}"><input type="hidden" name="action" value="settings">{% set labels={provisioning_minutes:'Bereitstellungszeitlimit (Minuten)',max_attempts:'Maximale Bereitstellungsversuche',retry_minutes:'Abstand zwischen Versuchen (Minuten)',stop_attempts:'Maximale Stoppwiederholungen',data_retention_days:'Dateien nach Vertragsende aufbewahren (Tage)',backup_retention_days:'Backups nach Vertragsende aufbewahren (Tage)',low_wallet_cents:'Guthabenwarnung unter diesem Betrag (Cent)'} %}{% for key,label in labels %}<label>{{ label }}<input class="form-input" type="number" min="1" name="{{ key }}" value="{{ settings[key] }}" required></label>{% endfor %}<label><input type="checkbox" name="cleanup_enabled" value="1"{% if settings.cleanup_enabled %} checked{% endif %}> Endgültige Löschung nach Vorankündigung aktivieren</label><p>Ein Aufbewahrungsschutz am Vertrag verhindert die Löschung. Rechnungen und Buchungen bleiben bestehen.</p><button class="ui-button">Speichern</button></form></section>
<section data-panel-section="capacity" class="ng-card p-5 space-y-3"><h2>Verkaufskapazitäten</h2><p>Nur für den Shop verfügbare Kapazitäten freigeben; außerhalb des Shops belegte Ressourcen und Betriebsreserven vorher abziehen. Verträge reservieren atomar. Aufbewahrte Ressourcen behalten ihre Reservierung bis zur bestätigten Bereinigung. IPv4 zählt KVM-Netzwerkplätze; das konfigurierte Netzwerk vergibt die Adresse. Gameserver verwenden die vorhandenen Portpools.</p>
{% for item in pools %}<details><summary>{{ item.pool.id }} · {{ item.pool.enabled ? 'freigegeben' : 'gesperrt' }}</summary><form method="post" class="space-y-2"><input type="hidden" name="_token" value="{{ csrf_token('rental-operations') }}"><input type="hidden" name="action" value="capacity"><input type="hidden" name="pool" value="{{ item.pool.id }}">{% for key,value in item.pool.limits %}<label>{{ key }} (verfügbar {{ item.available[key] }})<input class="form-input" type="number" min="0" name="{{ key }}" value="{{ value }}" required></label>{% endfor %}<label><input type="checkbox" name="enabled" value="1"{% if item.pool.enabled %} checked{% endif %}> Freigegeben</label><button class="ui-button">Speichern</button></form></details>{% endfor %}
<form method="post" class="space-y-3"><h3>Kapazitätsziel freigeben</h3><input type="hidden" name="_token" value="{{ csrf_token('rental-operations') }}"><input type="hidden" name="action" value="capacity"><select class="form-input" name="pool">{% for key,label in targets %}<option value="{{ key }}">{{ label }}</option>{% endfor %}</select>{% for key,label in {cpu:'CPU-Kerne',ram_mib:'RAM (MiB)',disk_mib:'Speicher (MiB)',ports:'Gameserver-Ports',ipv4:'KVM-Netzwerkplätze (IPv4)',slots:'Voice-Slots',systems:'Maximale Systeme'} %}<label>{{ label }}<input class="form-input" type="number" min="0" name="{{ key }}" value="0" required></label>{% endfor %}<label><input type="checkbox" name="enabled" value="1" checked> Freigegeben</label><button class="ui-button">Kapazitätsziel speichern</button></form></section>
<section data-panel-section="topups" class="ng-card p-5 space-y-3"><h2>Aufladungen / bestätigte Bankeingänge</h2><p>Nur tatsächliche Zahlungseingänge mit eindeutiger Bankreferenz bestätigen.</p>{% for topup in topups %}<details><summary>{{ topup.number }} · {{ topup.account.customer.email }} · {{ (topup.amountCents/100)|number_format(2,',','.') }} {{ topup.currency }} · {{ topup.paidAt ? 'bezahlt' : 'offen' }}</summary>{% if not topup.paidAt %}<form method="post"><input type="hidden" name="_token" value="{{ csrf_token('rental-operations') }}"><input type="hidden" name="action" value="bank-confirm"><input type="hidden" name="topup_id" value="{{ topup.id }}"><label>Eingegangener Betrag<input class="form-input" name="amount" required></label><label>Bankreferenz<input class="form-input" name="reference" maxlength="100" required></label><button class="ui-button">Bankeingang bestätigen</button></form>{% endif %}</details>{% endfor %}</section>
<section data-panel-section="adjustments" class="ng-card p-5 space-y-3"><h2>Korrektur / ausgezahlte Erstattung</h2><form method="post" class="space-y-3"><input type="hidden" name="_token" value="{{ csrf_token('rental-operations') }}"><input type="hidden" name="action" value="adjust"><label>Konto<select class="form-input" name="account_id">{% for account in accounts %}<option value="{{ account.id }}">{{ account.customer.email }} · {{ account.currency }}</option>{% endfor %}</select></label><label>Betrag<input class="form-input" name="amount" required></label><label><input type="checkbox" name="debit" value="1"> Guthaben abziehen</label><label><input type="checkbox" name="refund" value="1"> Bereits außerhalb des Panels ausgezahlte Erstattung</label><label>Referenz<input class="form-input" name="reference" minlength="8" maxlength="100" required></label><label>Begründung<input class="form-input" name="reason" maxlength="500" required></label><p>Diese Buchung löst keine externe Auszahlung aus. Reserviertes Guthaben bleibt geschützt.</p><button class="ui-button">Buchen</button></form></section>
<section data-panel-section="attention" class="ng-card p-5 space-y-3"><h2>Bearbeitungsbedarf / Aufbewahrungsschutz</h2><form method="post" class="space-y-3"><input type="hidden" name="_token" value="{{ csrf_token('rental-operations') }}"><label>Vertragsnummer<input class="form-input" type="number" min="1" name="contract_id" required></label><button class="ui-button" name="action" value="hold">Aufbewahrung schützen</button><button class="ui-button" name="action" value="unhold">Schutz aufheben</button><p>Schutz vor Beauftragung der Bereinigung setzen. Gilt auch für Verträge ohne Fehler; die Vertragsnummer steht in der Vertragsübersicht.</p></form>{% for contract in attention %}<article class="border p-4"><h3>Vertrag #{{ contract.id }} · {{ contract.configuration.name }} · {{ contract.customer.email }}</h3><p>{{ contract.status }} · {{ contract.error }} · Versuche {{ contract.provisionAttempts }} · Stoppwiederholungen {{ contract.stopAttempts }}</p><p>Löschung frühestens {{ contract.deleteAfterAt ? contract.deleteAfterAt|date('d.m.Y H:i') : 'noch nicht geplant' }} · {{ contract.retentionHold ? 'geschützt' : 'nicht geschützt' }}</p><form method="post"><input type="hidden" name="_token" value="{{ csrf_token('rental-operations') }}"><input type="hidden" name="contract_id" value="{{ contract.id }}"><button class="ui-button" name="action" value="retry">Stoppwiederholungen freigeben</button>{% set cleanup_started = contract.cleanupJobs is not empty or contract.backupCleanupJobs is not empty or contract.purgedAt or contract.backupsPurgedAt %}<button class="ui-button" name="action" value="{{ contract.retentionHold ? 'unhold' : 'hold' }}"{% if not contract.retentionHold and cleanup_started %} disabled title="Bereinigung bereits beauftragt; bitte Auftragsstatus prüfen."{% endif %}>{{ contract.retentionHold ? 'Aufbewahrungsschutz aufheben' : 'Aufbewahrung schützen' }}</button>{% if not contract.retentionHold and cleanup_started %}<p>Die Bereinigung wurde bereits beauftragt. Ein nachträglicher Aufbewahrungsschutz kann sie nicht zurückrufen.</p>{% endif %}</form></article>{% else %}<p>Kein Bearbeitungsbedarf.</p>{% endfor %}</section></div>{% endblock %}
