{% extends 'admin/shop/base.html.twig' %}
{% block title %}Shop · {{ selected.label }} {{ product ? 'bearbeiten' : 'anlegen' }}{% endblock %}
{% block content %}<div class="pm-workspace shop-workspace">
<header class="pm-page-head"><div><p class="shop-eyebrow">Shop / {{ selected.label }}</p><h1>{{ product ? product.name ~ ' bearbeiten' : selected.label ~ '-Produkt anlegen' }}</h1><p>Nur die zu dieser Produktart passenden Einstellungen. Bestehende Verträge behalten ihren bestätigten Tarif.</p></div><a class="ui-button" href="{{ path('admin_rental_product_kind',{kind:selected.value}) }}">Zur Produktliste</a></header>
{% include 'admin/shop/_navigation.html.twig' %}{% if product %}{% include 'admin/shop/_product_navigation.html.twig' with {section:'product'} %}{% endif %}
{% if error %}<div class="shop-alert" role="alert">{{ error }} Deine Eingaben bleiben erhalten.</div>{% elseif app.request.query.get('saved') %}<p class="shop-note" role="status">Produkt gespeichert.</p>{% endif %}
{% if app.request.query.get('delete') == 'blocked' %}<p class="shop-alert" role="alert">Dieses Produkt besitzt Bestellungen oder Mietsysteme. Zum Erhalt der Historie bitte deaktivieren.</p>{% endif %}
{% if product %}{% set availability = rental_readiness(product) %}<aside class="shop-note"><h2>{{ availability.label }}</h2><p>{{ availability.detail }}</p>{% if availability.target %}<a href="{{ path('admin_rental_product_capacity',{kind:product.kind.value,id:product.id}) }}">Verkaufskapazität für dieses Ziel prüfen und freigeben →</a>{% endif %}</aside>{% endif %}
{% if install_directory|default(null) %}<aside class="shop-note"><h2>Installationsziel</h2><p>Neue Instanzordner werden unter <code>{{ install_directory }}</code> auf dem gewählten Node angelegt. Vorhandene Serverpfade bleiben erhalten.</p></aside>{% elseif directory_error|default(null) %}<aside class="shop-alert" role="status">{{ directory_error }} <a href="{{ path('admin_nodes') }}">Node-Einstellungen öffnen</a></aside>{% endif %}
{% if categories is empty %}<div class="shop-alert" role="alert">Vor dem Speichern eine <a href="{{ path('admin_shop_categories') }}">Produktkategorie anlegen</a>.</div>{% endif %}
{% include 'admin/shop/_rental-product-form.html.twig' %}
{% if product %}<details class="shop-note"><summary>Produkt entfernen</summary><p>Produkte mit Bestellhistorie bleiben erhalten und können stattdessen deaktiviert werden. Zugeordnete Kapazitätspools werden nicht gelöscht.</p><form method="post" action="{{ path('admin_shop_products_delete',{id:product.id}) }}"><input type="hidden" name="_token" value="{{ csrf_token('admin-shop') }}"><label><input type="checkbox" required> Dieses unbenutzte Produkt endgültig entfernen</label> <button class="ui-button" type="submit">Produkt entfernen</button></form></details>{% endif %}
</div>{% endblock %}
