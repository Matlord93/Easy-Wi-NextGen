{% extends 'admin/base.html.twig' %}
{% set activeNav = 'audit-logs' %}
{% set locale = page_locale() %}
{% set auditQuery = {action:filters.action,actor:filters.actor,since:filters.since ? filters.since|date('c') : ''}|url_encode %}
{% block content %}
<div class="pm-workspace">
<header class="pm-page-head"><div><h1>{{ t('admin_audit_logs_heading',locale) }}</h1><p>{{ t('admin_audit_logs_intro',locale) }}</p></div><a class="ui-button ui-button--ghost" href="/admin/audit-logs/export.csv?{{ auditQuery }}">{{ t('export',locale) }} · CSV</a></header>
<div class="pm-stats">
{% include 'components/panel/_stat.html.twig' with {value:summary.total,label:t('admin_audit_logs_total_entries',locale)} only %}
{% include 'components/panel/_stat.html.twig' with {value:summary.showing,label:'workspace_audit_showing'|trans({},'panel_modules')} only %}
{% include 'components/panel/_stat.html.twig' with {value:summary.latest ? summary.latest|date('d.m.Y H:i') : '—',label:t('admin_audit_logs_latest_activity',locale)} only %}
</div>
<form method="get" action="/admin/audit-logs" class="ng-data-card pm-operations-filters">
<div class="form-field"><label class="form-label" for="audit-action">{{ t('admin_audit_logs_table_action',locale) }}</label><input id="audit-action" class="form-input" name="action" value="{{ filters.action }}" placeholder="instance.created"></div>
<div class="form-field"><label class="form-label" for="audit-actor">{{ t('admin_audit_logs_table_actor',locale) }}</label><input id="audit-actor" class="form-input" name="actor" value="{{ filters.actor }}"></div>
<div class="form-field"><label class="form-label" for="audit-since">{{ 'workspace_since'|trans({},'panel_modules') }}</label><input id="audit-since" class="form-input" type="datetime-local" step="1" name="since" value="{{ filters.since ? filters.since|date('Y-m-d\TH:i:s') : '' }}"></div>
<div class="pm-page-head__actions"><button class="ui-button ui-button--primary" type="submit">{{ 'workspace_filter'|trans({},'panel_modules') }}</button><a class="ui-button ui-button--ghost" href="/admin/audit-logs">{{ t('admin_users_filter_reset',locale) }}</a></div>
</form>
{% include 'admin/audit-logs/_table.html.twig' with {logs:logs,filters:filters} %}
</div>
{% endblock %}
