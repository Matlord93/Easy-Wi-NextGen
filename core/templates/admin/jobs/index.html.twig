{% extends 'admin/base.html.twig' %}
{% set activeNav = 'jobs' %}
{% set locale = page_locale() %}
{% block content %}
<div class="pm-workspace">
<header class="pm-page-head"><div><h1>{{ t('admin_jobs_title',locale) }}</h1><p>{{ t('admin_jobs_intro',locale) }}</p></div><a class="ui-button ui-button--primary" href="/admin/jobs/new">+ {{ t('admin_jobs_create',locale) }}</a></header>
<div class="pm-stats pm-stats--four">
{% include 'components/panel/_stat.html.twig' with {value:summary.total,label:t('admin_jobs_total',locale)} only %}
{% include 'components/panel/_stat.html.twig' with {value:summary.running,label:t('admin_jobs_running',locale)} only %}
{% include 'components/panel/_stat.html.twig' with {value:summary.queued,label:t('admin_jobs_queued',locale)} only %}
{% include 'components/panel/_stat.html.twig' with {value:summary.failed,label:t('admin_backups_status_failed',locale)} only %}
</div>
{% include 'admin/jobs/_table.html.twig' with {jobs:jobs,pagination:pagination} %}
</div>
{% endblock %}
