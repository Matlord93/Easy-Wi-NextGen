{% extends 'admin/base.html.twig' %}

{% set pageTitle = t('admin_dns_heading', page_locale()) %}
{% set pageSubtitle = t('admin_dns_intro', page_locale()) %}
{% set activeNav = 'dns-records' %}
{% set locale = page_locale() %}
{% block content %}
<div class="pm-workspace" data-panel-tabs="dns-records">
    <header class="pm-page-head"><div><h1>{{ pageTitle }}</h1><p>{{ t('admin_dns_form_intro',locale) }}</p></div>
        <a class="ui-button ui-button--primary" href="#pm-dns-records-create" hx-get="/admin/dns/records/form" hx-target="#dns-record-form" hx-swap="outerHTML" data-panel-reveal="create">+ {{ t('admin_dns_create_title',locale) }}</a>
    </header>
    {% include 'components/panel/_tabs.html.twig' with {panelKey:'dns-records',panelTabs:{overview:'workspace_inventory',create:'workspace_dns_editor'}} %}
    <div class="pm-stats pm-stats--four">
        {% include 'components/panel/_stat.html.twig' with {value:summary.total,label:t('admin_dns_total_records',locale)} only %}
        {% include 'components/panel/_stat.html.twig' with {value:summary.byType.A ?? 0,label:t('admin_dns_a_records',locale)} only %}
        {% include 'components/panel/_stat.html.twig' with {value:summary.byType.CNAME ?? 0,label:t('admin_dns_cname_records',locale)} only %}
        {% include 'components/panel/_stat.html.twig' with {value:summary.byType.MX ?? 0,label:t('admin_dns_mx_records',locale)} only %}
    </div>
    <section data-panel-section="overview">{% include 'admin/dns/records/_table.html.twig' with {records:records} %}</section>
    <section data-panel-section="create">{% include 'admin/dns/records/_form.html.twig' with {domains:domains,recordTypes:recordTypes,form:form} %}</section>
</div>
{% endblock %}
