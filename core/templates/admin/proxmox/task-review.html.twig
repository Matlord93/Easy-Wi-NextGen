{% extends 'admin/base.html.twig' %}
{% trans_default_domain 'proxmox' %}
{% block content %}
<section class="ng-data-card">
 <div class="ng-data-card__header"><h1>{{ 'pve.review.title'|trans }} #{{ task.id }}</h1></div>
 <div class="ng-data-card__body" style="display:grid;gap:16px;max-width:900px;overflow-wrap:anywhere;">
  {% if error %}<p class="ng-alert ng-alert--danger" role="alert">{{ error|trans }}</p>{% endif %}
  <p>{{ task.cluster.name }} · {{ task.node }} · {{ task.kind }} {{ task.vmId ?: '—' }}</p>
  <p {% if task.active and task.state != 'uncertain' %}data-pve-task-url="{{ path('admin_proxmox_task', {id: task.cluster.id, taskId: task.id}) }}"{% endif %}>
   {{ ('pve.action.' ~ task.action)|trans }} · <span data-pve-task-state>{{ ('pve.state.' ~ task.state)|trans }}{% if task.result and task.result != 'OK' %} · {{ ('pve.result.' ~ task.result)|trans }}{% endif %}</span>
  </p>
  {% if task.upid %}<p>UPID: <code>{{ task.upid }}</code></p>{% endif %}
  {% if task.state == 'uncertain' %}
   {% if rollbackAvailable %}
    <form method="post" class="infra-form" data-pve-mutation data-pve-restore-system-disk>
     <input type="hidden" name="_token" value="{{ csrf_token('proxmox-task-review-' ~ task.id) }}">
     <input type="hidden" name="outcome" value="rollback">
     <p>{{ 'pve.reinstall_rollback.hint'|trans }}</p>
     <label><input type="checkbox" name="confirm" value="1" required> {{ 'pve.reinstall_rollback.confirm'|trans }}</label>
     <button class="ui-button ui-button--primary" type="submit">{{ 'pve.reinstall_rollback.action'|trans }}</button>
    </form>
   {% endif %}
   <p class="ng-alert ng-alert--warning">{{ 'pve.review.hint'|trans }}</p>
   {% if task.installation.rental_id is defined %}<p>{{ 'pve.error.review_rental_installation'|trans }}</p>{% endif %}
   {% if task.action == 'reinstall' %}<p>{{ (removalConfirmationAvailable ? 'pve.reinstall_removal.hint' : 'pve.error.review_reinstallation')|trans }}</p>{% endif %}
   <form method="post" style="display:grid;gap:14px;" data-pve-mutation>
    <input type="hidden" name="_token" value="{{ csrf_token('proxmox-task-review-' ~ task.id) }}">
    <label class="form-label">{{ 'pve.review.outcome'|trans }}<select name="outcome" required class="form-input"><option value="">—</option>{% if removalConfirmationAvailable %}<option value="success">{{ 'pve.reinstall_removal.verify'|trans }}</option>{% elseif task.action != 'reinstall' and task.installation.rental_id is not defined and task.originTaskId is null %}<option value="success">{{ 'pve.review.success'|trans }}</option>{% endif %}<option value="failure">{{ 'pve.review.failure'|trans }}</option></select></label>
    <label class="form-label">{{ 'pve.review.note'|trans }}<textarea name="note" minlength="10" maxlength="1000" required rows="4" class="form-input"></textarea></label>
    <label><input type="checkbox" name="confirm" value="1" required> {{ 'pve.review.confirm'|trans }}</label>
    <button class="ui-button ui-button--primary" type="submit">{{ 'pve.review.submit'|trans }}</button>
   </form>
  {% endif %}
  <a class="ui-button ui-button--ghost" href="{{ path('admin_proxmox_cluster', {id:task.cluster.id}) }}">{{ 'pve.back'|trans }}</a>
 </div>
</section>
{% include 'proxmox/_script.html.twig' %}
{% endblock %}
