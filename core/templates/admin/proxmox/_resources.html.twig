{% trans_default_domain 'proxmox' %}
<div class="infra-page">
<div class="infra-grid">{% for node in overview.nodes %}<article class="infra-card" id="pve-node-{{ node.node }}"><div class="infra-card__head"><h2>{{ node.node }}</h2><span class="infra-tag {{ node.status|default('') == 'online' ? 'infra-tag--online' : '' }}">{{ node.status|default('unknown') }}</span></div>{% include 'infrastructure/_metrics.html.twig' with {usage: infra_pve_usage(node)} %}<a class="ui-button ui-button--ghost" href="{{ path('admin_infrastructure_history', {provider:'proxmox',connection:cluster.id,kind:'node',reference:node.node}) }}">{{ 'monitor.open_history'|trans({}, 'monitoring') }}</a>{% if node.status|default('') == 'online' %}<a class="ui-button ui-button--ghost" href="{{ path('admin_proxmox_new_vm', {id: cluster.id, node: node.node}) }}">{{ 'pve.create_vm'|trans }}</a>{% endif %}</article>{% else %}<p class="infra-empty">{{ 'pve.no_nodes'|trans }}</p>{% endfor %}</div>
<section class="infra-card" data-infra-list><div class="infra-card__head"><h2>{{ 'pve.guests'|trans }}</h2><span class="infra-tag">{{ overview.guests|length }}</span></div><div class="infra-search"><input class="form-input" type="search" data-infra-filter placeholder="{{ 'infra.search'|trans({}, 'infrastructure') }}" aria-label="{{ 'infra.search'|trans({}, 'infrastructure') }}"><select class="form-input" data-infra-state aria-label="{{ 'pve.state'|trans }}"><option value="">{{ 'infra.all_states'|trans({}, 'infrastructure') }}</option><option value="running">{{ 'infra.running'|trans({}, 'infrastructure') }}</option><option value="stopped">{{ 'infra.stopped'|trans({}, 'infrastructure') }}</option></select></div>
<div class="infra-table-wrap"><table class="infra-table"><thead><tr>{% for label in ['guest', 'node', 'state', 'cpu', 'memory', 'disk'] %}<th>{{ ('pve.' ~ label)|trans }}</th>{% endfor %}<th></th></tr></thead><tbody>
{% for guest in overview.guests %}{% set usage = infra_pve_usage(guest) %}<tr data-infra-item data-state="{{ guest.status|default('unknown') }}"><td><a href="{{ path('admin_proxmox_guest', {id: cluster.id, kind: guest.type, vmId: guest.vmid}) }}"><strong>{{ guest.vmid }} · {{ guest.name|default(guest.type) }}</strong></a><small>{{ guest.type|upper }}{% if guest.template|default(false) %} · {{ 'pve.template'|trans }}{% endif %}</small></td><td>{{ guest.node }}</td><td><span class="infra-tag {{ guest.status|default('') == 'running' ? 'infra-tag--online' : '' }}">{{ guest.status|default('unknown') }}</span></td><td>{{ usage.cpu_percent is not null ? usage.cpu_percent|number_format(1) ~ ' %' : '—' }}</td><td>{{ usage.memory_used_bytes is not null ? (usage.memory_used_bytes / 1073741824)|number_format(1) ~ ' GiB' : '—' }}<small>{{ usage.memory_total_bytes is not null ? (usage.memory_total_bytes / 1073741824)|number_format(1) ~ ' GiB' : '—' }}</small></td><td>{{ usage.disk_total_bytes is not null ? (usage.disk_total_bytes / 1073741824)|number_format(1) ~ ' GiB' : '—' }}</td><td><a class="ui-button ui-button--ghost" href="{{ path('admin_proxmox_guest', {id: cluster.id, kind: guest.type, vmId: guest.vmid}) }}">{{ 'infra.open'|trans({}, 'infrastructure') }}</a></td></tr>{% endfor %}
</tbody></table></div><p class="infra-empty" data-infra-no-results {% if overview.guests is not empty %}hidden{% endif %}>{{ 'infra.no_results'|trans({}, 'infrastructure') }}</p></section></div>
