{% trans_default_domain 'proxmox' %}
{% if detail and not detail.guest.template|default(false) %}<section class="ng-data-card" style="margin-top:20px;"><div class="ng-data-card__header"><h2>{{ 'pve.customer_assignment'|trans }}</h2></div><form method="post" action="{{ path('admin_proxmox_assign', {id: cluster.id, kind: kind, vmId: vmId}) }}" class="ng-data-card__body" style="display:grid;gap:12px;">
<input type="hidden" name="_token" value="{{ csrf_token('proxmox-assign-' ~ cluster.id ~ '-' ~ kind ~ '-' ~ vmId) }}">
<label>{{ 'pve.customer'|trans }}<select class="form-input" name="customer_id"><option value="0">{{ 'pve.unassigned'|trans }}</option>{% for customer in customers %}<option value="{{ customer.id }}" {{ assignment and assignment.customer.id == customer.id ? 'selected' : '' }}>{{ customer.email }}</option>{% endfor %}</select></label>
<label>{{ 'pve.customer_backup_storage'|trans }}<select name="backup_storage" class="form-input"><option value="">{{ 'pve.customer_backup_disabled'|trans }}</option>{% for storage in detail.storages|filter(s => s.active|default(false) and 'backup' in s.content|default('')|split(',')) %}<option value="{{ storage.storage }}" {{ assignment and assignment.backupStorage == storage.storage ? 'selected' : '' }}>{{ storage.storage }}</option>{% endfor %}</select></label><button class="ui-button ui-button--primary">{{ 'pve.save'|trans }}</button></form></section>{% endif %}
