{% extends 'admin/base.html.twig' %}
{% set activeNav = 'cms-pages' %}
{% set locale = page_locale() %}
{% block content %}
<div class="pm-workspace" data-panel-tabs="cms-pages">
    <header class="pm-page-head"><div><h1>{{ t('cms_pages_title',locale) }}</h1><p>{{ t('cms_pages_description',locale) }}</p></div><a class="ui-button ui-button--primary" href="#pm-cms-pages-create" hx-get="/admin/cms/pages/form" hx-target="#cms-page-form" hx-swap="outerHTML" data-panel-reveal="create">+ {{ 'create'|trans({},'panel_modules') }}</a></header>
    {% include 'components/panel/_tabs.html.twig' with {panelKey:'cms-pages',panelTabs:{overview:'workspace_inventory',create:'workspace_page_editor'}} %}
    <div class="pm-stats">{% for label,value in {total_pages:summary.total,published:summary.published,blocks:summary.blocks} %}{% include 'components/panel/_stat.html.twig' with {value:value,label:t(label,locale)} only %}{% endfor %}</div>
    <section class="cust-panel" data-panel-section="overview"><div class="cust-panel__head"><h2 class="cust-panel__title">{{ t('pages_overview',locale) }}</h2><button class="ui-button ui-button--ghost" hx-get="/admin/cms/pages/table" hx-target="#cms-pages-table" hx-swap="outerHTML">{{ t('refresh',locale) }}</button></div>{% include 'admin/cms/pages/_table.html.twig' with {pages:pages} %}</section>
    <section data-panel-section="create">{% include 'admin/cms/pages/_form.html.twig' with {form:form} %}</section>
</div>
{% endblock %}
