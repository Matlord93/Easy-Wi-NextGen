{% extends 'admin/base.html.twig' %}
{% set activeNav = 'cms-pages' %}
{% set locale = page_locale() %}
{% block head %}{{ parent() }}<link rel="stylesheet" href="{{ asset('cms-editor.css') }}"><script src="{{ asset('js/cms-media-picker.js') }}" defer></script>{% endblock %}
{% block content %}
<div class="pm-workspace" data-panel-tabs="cms-blocks">
    <header class="pm-page-head"><div><h1>{{ page.title }}</h1><p>{{ t('cms_page_manage_blocks_description',locale) }} /{{ page.slug }} <span class="ui-badge ui-badge--{{ page.is_published ? 'success' : 'neutral' }}">{{ t(page.is_published ? 'published' : 'draft',locale) }}</span></p></div><div class="pm-page-head__actions"><a class="ui-button ui-button--ghost" href="{{ path('admin_cms_page_preview', {id:page.id}) }}" target="_blank" rel="noopener">{{ 'workspace_cms_preview'|trans({},'panel_modules') }}</a><a class="ui-button ui-button--ghost" href="/admin/cms/pages">{{ 'back'|trans({},'panel_modules') }}</a><a class="ui-button ui-button--primary" href="#pm-cms-blocks-create" hx-get="/admin/cms/pages/{{ page.id }}/blocks/form" hx-target="#cms-block-form" hx-swap="outerHTML" data-panel-reveal="create">+ {{ 'workspace_add_block'|trans({},'panel_modules') }}</a></div></header>
    {% include 'components/panel/_tabs.html.twig' with {panelKey:'cms-blocks',panelTabs:{overview:'workspace_content_blocks',create:'workspace_block_editor'}} %}
    {% include 'admin/cms/pages/_checks.html.twig' with {editable:true} %}
    <section class="cust-panel" data-panel-section="overview"><div class="cust-panel__head"><h2 class="cust-panel__title">{{ t('content_blocks',locale) }} <span class="ui-badge ui-badge--neutral">{{ blocks|length }}</span></h2><button class="ui-button ui-button--ghost" hx-get="/admin/cms/pages/{{ page.id }}/blocks/table" hx-target="#cms-blocks-table" hx-swap="outerHTML">{{ t('refresh',locale) }}</button></div>{% include 'admin/cms/pages/_blocks_table.html.twig' with {blocks:blocks,page:page} %}</section>
    <section data-panel-section="create">{% include 'admin/cms/pages/_block_form.html.twig' with {blockForm:blockForm,page:page} %}</section>
</div>
{% endblock %}
