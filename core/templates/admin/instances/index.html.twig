{% extends 'admin/base.html.twig' %}
{% set pageTitle = t('admin_instances_title', page_locale()) %}
{% set activeNav = 'game-instances' %}
{% block content %}
<div class="pm-workspace">
    {% if createNotice %}<div class="ng-alert ng-alert--{{ createNotice.type == 'success' ? 'success' : 'warning' }}">{{ createNotice.message }}</div>{% endif %}
    <header class="pm-page-head"><div><h1>{{ 'gameservers'|trans({},'panel_modules') }}</h1><p>{{ 'workspace_game_intro'|trans({},'panel_modules') }}</p></div><a class="ui-button ui-button--primary" href="{{ path('admin_instances_provision') }}">+ {{ t('admin_instances_new',page_locale()) }}</a></header>
    <div class="pm-stats">
        {% include 'components/panel/_stat.html.twig' with {value:summary.total,label:t('admin_instances_total',page_locale())} only %}
        {% include 'components/panel/_stat.html.twig' with {value:summary.running,label:t('admin_instances_running',page_locale())} only %}
        {% include 'components/panel/_stat.html.twig' with {value:summary.pending_setup + summary.provisioning,label:'workspace_pending'|trans({},'panel_modules')} only %}
    </div>
    <section class="ng-data-card"><div class="ng-data-card__header"><h2 class="ng-data-card__title">{{ 'servers'|trans({},'panel_modules') }}</h2><button class="ui-button ui-button--ghost ui-button--sm" hx-get="{{ path('admin_instances_table') }}" hx-target="#instances-table" hx-swap="outerHTML">{{ t('admin_instances_refresh',page_locale()) }}</button></div><div class="ng-data-card__body--flush">{% include 'admin/instances/_table.html.twig' with {instances:instances} %}</div></section>
    <details class="cust-panel"><summary class="cust-panel__head">{{ 'workspace_operations'|trans({},'panel_modules') }}</summary><div class="cust-panel__body"><div class="ng-ops-grid">
        {% for label,value in {admin_instances_ops_offline_agents:ops.offline_agents,admin_instances_ops_disk_warnings:ops.disk_problem_instances,admin_instances_ops_runtime_unknown:ops.runtime_unknown_instances,admin_instances_ops_blocked_schedules:ops.blocked_schedules,admin_instances_suspended:summary.suspended,admin_instances_needs_attention:summary.error} %}<div class="ng-ops-box"><div class="ng-ops-box__label">{{ t(label,page_locale()) }}</div><div class="ng-ops-box__value">{{ value }}</div></div>{% endfor %}
    </div></div></details>
</div>
{% endblock %}
