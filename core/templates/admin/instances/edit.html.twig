{% extends 'admin/base.html.twig' %}
{% block content %}
<div class="pm-edit-header"><div><h1>{{ instance.serverName ?? instance.template.name }} · #{{ instance.id }}</h1><p>{{ instance.template.displayName }} · {{ instance.node.name }}</p></div><a class="ui-button ui-button--ghost" href="{{ path('admin_instances') }}">{{ 'back'|trans({},'panel_modules') }}</a></div>
{% for error in errors %}<div class="ui-alert ui-alert--danger" role="alert">{{ error }}</div>{% endfor %}{% if saved %}<div class="ui-alert ui-alert--success" role="status">{{ 'saved'|trans({},'panel_modules') }}</div>{% endif %}
{% include 'components/panel/_instance_nav.html.twig' %}
<div class="pm-editor-grid"><section class="cust-panel"><div class="cust-panel__head"><h2 class="cust-panel__title">{{ 'resources'|trans({},'panel_modules') }}</h2></div><div class="cust-panel__body"><form class="pm-form" method="post" action="{{ path('admin_instances_edit_save',{id:instance.id}) }}"><input type="hidden" name="_token" value="{{ csrf_token('admin_instance_edit_' ~ instance.id) }}">{% for key,label in {cpu_limit:'CPU (%)',ram_limit:'RAM (MiB)',disk_limit:'Disk (MiB)'} %}{% set value = key == 'cpu_limit' ? instance.cpuLimit : (key == 'ram_limit' ? instance.ramLimit : instance.diskLimit) %}<label>{{ label }}<input class="form-input" type="number" name="{{ key }}" min="{{ value }}" step="1" value="{{ value }}" required></label>{% endfor %}<p>{{ 'resource_hint'|trans({},'panel_modules') }}</p><button class="ui-button ui-button--primary" type="submit">{{ 'save'|trans({},'panel_modules') }}</button></form></div></section><aside class="cust-panel"><div class="cust-panel__head"><h2 class="cust-panel__title">{{ 'overview'|trans({},'panel_modules') }}</h2></div><div class="cust-panel__body"><dl class="pm-keyvalues"><div><dt>{{ 'customer'|trans({},'panel_modules') }}</dt><dd>{{ instance.customer.email }}</dd></div><div><dt>Status</dt><dd>{{ instance.status.value }}</dd></div><div><dt>Node</dt><dd>{{ instance.node.name }}</dd></div><div><dt>Port</dt><dd>{{ instance.assignedPort ?? '—' }}</dd></div><div><dt>Slots</dt><dd>{{ instance.currentSlots }} / {{ instance.maxSlots }}</dd></div></dl></div></aside></div>
{% endblock %}
