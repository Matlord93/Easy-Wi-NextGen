{% extends 'admin/base.html.twig' %}
{% set pageTitle = 'mc.catalog_title'|trans({}, 'minecraft') %}
{% block content %}
<section class="ng-data-card">
  <div class="ng-data-card__header"><div><h1>{{ 'mc.catalog_title'|trans({}, 'minecraft') }}</h1><p>{{ 'mc.automatic_hint'|trans({}, 'minecraft') }}</p></div><a href="{{ path('admin_minecraft') }}">{{ 'mc.choose_version'|trans({}, 'minecraft') }}</a></div>
  <div class="ng-data-card__body">
    <p role="status" data-minecraft-sync-status>{{ (syncStatus.updating ? 'mc.updating' : 'mc.automatic')|trans({}, 'minecraft') }}</p>
    <form method="get" style="display:flex;flex-wrap:wrap;gap:12px;">
      <label>{{ 'mc.channel'|trans({}, 'minecraft') }} <select name="channel" class="form-input"><option value="">{{ 'mc.all'|trans({}, 'minecraft') }}</option>{% for channel in channels %}<option value="{{ channel }}" {{ filters.channel == channel ? 'selected' : '' }}>{{ ('mc.channel.' ~ channel)|trans({}, 'minecraft') }}</option>{% endfor %}</select></label>
      <label>{{ 'mc.search'|trans({}, 'minecraft') }} <input name="q" value="{{ filters.q }}" class="form-input"></label>
      <button class="ui-button ui-button--ghost">{{ 'mc.filter'|trans({}, 'minecraft') }}</button>
    </form>
  </div>
  <div class="ng-data-card__body--flush"><table class="ui-table">
    <thead><tr>{% for label in ['channel', 'version', 'build', 'java', 'release_type'] %}<th>{{ ('mc.' ~ label)|trans({}, 'minecraft') }}</th>{% endfor %}</tr></thead>
    <tbody>{% for version in versions %}<tr><td>{{ ('mc.channel.' ~ version.channel)|trans({}, 'minecraft') }}</td><td>{{ version.mcVersion }}</td><td>{{ version.build ?: '—' }}</td><td>{{ version.javaVersion ?: '—' }}</td><td>{{ (version.metadata.release_type|default('release') == 'release' ? 'mc.release' : 'mc.preview')|trans({}, 'minecraft') }}</td></tr>{% else %}<tr><td colspan="5">{{ 'mc.loading'|trans({}, 'minecraft') }}</td></tr>{% endfor %}</tbody>
  </table></div>
  <nav class="ng-data-card__body" aria-label="{{ 'mc.pages'|trans({}, 'minecraft') }}">
    {% if page > 1 %}<a href="{{ path('admin_minecraft_versions', filters|merge({page: page - 1})) }}">{{ 'mc.previous'|trans({}, 'minecraft') }}</a>{% endif %}
    <span>{{ page }} / {{ pages }} · {{ count }}</span>
    {% if page < pages %}<a href="{{ path('admin_minecraft_versions', filters|merge({page: page + 1})) }}">{{ 'mc.next'|trans({}, 'minecraft') }}</a>{% endif %}
  </nav>
</section>
{% include 'admin/minecraft/_catalog_script.html.twig' %}
{% endblock %}
