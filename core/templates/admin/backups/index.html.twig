{% extends 'admin/base.html.twig' %}

{% set pageTitle = t('admin_backups_title', page_locale()) %}
{% set activeNav = 'backup-system' %}
{% set locale = page_locale() %}

{% block content %}

{% set totalBackups = backups|length %}
{% set successCount = 0 %}
{% set failedCount = 0 %}
{% set pendingCount = 0 %}
{% for backup in backups %}
    {% if backup.status in ['success', 'succeeded'] %}
        {% set successCount = successCount + 1 %}
    {% elseif backup.status == 'failed' %}
        {% set failedCount = failedCount + 1 %}
    {% else %}
        {% set pendingCount = pendingCount + 1 %}
    {% endif %}
{% endfor %}

<div class="pm-workspace" data-panel-list>

    <header class="pm-page-head"><div><h1>{{ t('admin_backups_title',locale) }}</h1><p>{{ 'workspace_backup_scope'|trans({},'panel_modules') }}</p></div><a href="{{ path('admin_settings_backups') }}" class="ui-button ui-button--primary">{{ t('admin_backups_nav_settings',locale) }}</a></header>
    {% include 'admin/backups/_nav.html.twig' with {backupNav:'overview'} %}
    <div class="pm-stats pm-stats--four">
{% include 'components/panel/_stat.html.twig' with {value:totalBackups,label:'workspace_listed_entries'|trans({},'panel_modules')} only %}
{% include 'components/panel/_stat.html.twig' with {value:pendingCount,label:t('admin_backups_status_running',locale)} only %}
{% include 'components/panel/_stat.html.twig' with {value:successCount,label:t('admin_backups_status_success',locale)} only %}
{% include 'components/panel/_stat.html.twig' with {value:failedCount,label:t('admin_backups_status_failed',locale)} only %}
    </div>

    {# ── Backup list ── #}
    <div class="ng-data-card">
        <div class="ng-data-card__header">
            <div>
                <h2 class="ng-data-card__title">{{ t('admin_backups_title', locale) }}</h2>
            </div>
        </div>
        <div class="pm-filters"><input class="form-input" data-panel-filter aria-label="{{ 'workspace_backup_search'|trans({},'panel_modules') }}" placeholder="{{ 'workspace_backup_search'|trans({},'panel_modules') }}"></div>
        <div class="ng-data-card__body--flush">
            <div class="cust-ws-table-wrap">
                <table class="cust-table">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>{{ t('admin_backups_col_instance', locale) }}</th>
                            <th>{{ t('admin_backups_col_customer', locale) }}</th>
                            <th>{{ t('admin_backups_col_target', locale) }}</th>
                            <th>{{ t('status', locale) }}</th>
                            <th>{{ t('size', locale) }}</th>
                            <th>{{ t('created', locale) }}</th>
                            <th>{{ t('error', locale) }}</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for backup in backups %}
                            <tr data-panel-row>
                                <td>{{ backup.id }}</td>
                                <td>{{ backup.instance_id }}</td>
                                <td>{{ backup.customer_id }}</td>
                                <td class="pm-backup-meta">{{ backup.target ?: 'default' }}<br><small>{{ backup.target_type|default('local') }} · {{ backup.target_path ?: backup.archive_path ?: '—' }}</small></td>
                                <td>
                                    {% if backup.status in ['success', 'succeeded'] %}
                                        <span class="ui-badge ui-badge--success">{{ t('admin_backups_status_success', locale) }}</span>
                                    {% elseif backup.status == 'failed' %}
                                        <span class="ui-badge ui-badge--danger">{{ t('admin_backups_status_failed', locale) }}</span>
                                    {% else %}
                                        <span class="ui-badge ui-badge--warning">{{ t('admin_backups_status_running', locale) }}</span>
                                    {% endif %}
                                </td>
                                <td><span title="{{ backup.size_bytes is not null ? backup.size_bytes ~ ' B' : '' }}">{% include 'components/panel/_bytes.html.twig' with {bytes:backup.size_bytes} only %}</span>{% if backup.checksum %}<details class="pm-backup-meta"><summary class="pm-disclosure-title">{{ 'workspace_checksum'|trans({},'panel_modules') }}</summary><code>{{ backup.checksum }}</code></details>{% endif %}</td>
                                <td>{{ backup.created_at|date('Y-m-d H:i') }}</td>
                                <td class="pm-backup-meta">{{ backup.error ?: '—' }}</td>
                            </tr>
                        {% else %}
                            <tr><td colspan="8" class="cust-table__empty">{{ t('admin_backups_list_empty', locale) }}</td></tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>

</div>
{% endblock %}
