{% extends 'admin/base.html.twig' %}
{% set pageTitle = 'mc.title'|trans({}, 'minecraft') %}
{% set pageSubtitle = 'mc.automatic_hint'|trans({}, 'minecraft') %}
{% block content %}
<section class="ng-data-card" data-minecraft-catalog-page>
  <div class="ng-data-card__header"><div><h1>{{ 'mc.title'|trans({}, 'minecraft') }}</h1><p>{{ 'mc.automatic_hint'|trans({}, 'minecraft') }}</p></div></div>
  <div class="ng-data-card__body">
    <p role="status" data-minecraft-sync-status>{{ (syncStatus.updating ? 'mc.updating' : 'mc.automatic')|trans({}, 'minecraft') }}</p>
    <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(250px,1fr));gap:16px;">
    {% for channel in channels %}
      {% set available = catalog[channel] %}
      {% set stable = available.versions|filter(version => available.release_types[version]|default('release') == 'release') %}
      <article class="ng-data-card" style="padding:18px;" data-minecraft-channel="{{ channel }}">
        <h2>{{ ('mc.channel.' ~ channel)|trans({}, 'minecraft') }}</h2>
        <p data-minecraft-version-count>{{ 'mc.available'|trans({'%count%': available.versions|length}, 'minecraft') }}</p>
        <form method="get" action="{{ path('admin_instances_provision') }}" data-minecraft-version-form style="display:grid;gap:12px;">
          <input type="hidden" name="template_id" value="{{ templateIds[channel]|default('') }}">
          <label>{{ 'mc.version'|trans({}, 'minecraft') }}
            <select name="minecraft_version" class="form-input" data-minecraft-version-select required {{ stable is empty ? 'disabled' : '' }}>
              {% for version in stable %}<option value="{{ version }}">{{ version }}</option>{% else %}<option value="">{{ 'mc.loading'|trans({}, 'minecraft') }}</option>{% endfor %}
            </select>
          </label>
          <label><input type="checkbox" data-minecraft-previews> {{ 'mc.show_previews'|trans({}, 'minecraft') }}</label>
          <button class="ui-button ui-button--primary" {{ stable is empty or not templateIds[channel]|default(false) ? 'disabled' : '' }}>{{ 'mc.create_server'|trans({}, 'minecraft') }}</button>
        </form>
        <a href="{{ path('admin_minecraft_versions', {channel: channel}) }}" style="display:inline-block;margin-top:12px;">{{ 'mc.view_versions'|trans({}, 'minecraft') }}</a>
      </article>
    {% endfor %}
    </div>
    <p>{{ 'mc.cached_hint'|trans({}, 'minecraft') }}</p>
  </div>
</section>
{% include 'admin/minecraft/_catalog_script.html.twig' %}
{% endblock %}
