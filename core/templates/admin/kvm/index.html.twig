{% extends 'admin/base.html.twig' %}
{% trans_default_domain 'infrastructure' %}
{% set pageTitle = 'kvm.title'|trans({}, 'kvm') %}
{% block content %}
<div class="infra-page pm-workspace">
    <header class="pm-page-head"><div><h1>{{ pageTitle }}</h1><p>{{ 'infra.kvm_hint'|trans }}</p></div><a class="ui-button ui-button--primary" href="{{ path('admin_vm_console') }}">{{ 'setup.title'|trans({},'vm_console') }}</a></header>
    <div class="pm-stats">
        {% include 'components/panel/_stat.html.twig' with {value:nodes|length,label:'nodes'|trans({},'panel_modules')} only %}
        {% include 'components/panel/_stat.html.twig' with {value:nodes|filter(node => node.status == 'active')|length,label:'workspace_active_nodes'|trans({},'panel_modules')} only %}
        {% include 'components/panel/_stat.html.twig' with {value:nodes|filter(node => node.metadata.kvm_managed.supported|default(false))|length,label:'kvm.agent_supported'|trans({},'kvm')} only %}
    </div>
    <section class="cust-panel" data-panel-list>
        <div class="pm-filters"><label class="sr-only" for="kvm-node-search">{{ 'infra.search'|trans }}</label><input class="form-input" id="kvm-node-search" type="search" data-panel-filter placeholder="{{ 'infra.search'|trans }}"></div>
        <div class="infra-table-wrap"><table class="cust-table">
            <thead><tr><th>{{ 'nodes'|trans({},'panel_modules') }}</th><th>Status</th><th>{{ 'resources'|trans({},'panel_modules') }}</th><th>{{ 'actions'|trans({},'panel_modules') }}</th></tr></thead>
            <tbody>{% for node in nodes %}<tr data-panel-row>
                <td><a class="pm-server-name" href="{{ path('admin_kvm_node',{id:node.id}) }}">{{ node.name ?: node.id }}</a><small class="pm-cell-sub">{{ node.id }}</small></td>
                <td><span class="ui-badge ui-badge--{{ node.status == 'active' ? 'success' : 'neutral' }}">{{ node.status }}</span><small class="pm-cell-sub">{{ node.metadata.kvm_managed.supported|default(false) ? 'kvm.agent_supported'|trans({},'kvm') : 'kvm.update_agent'|trans({},'kvm') }}</small></td>
                <td><details class="pm-row-details"><summary>{{ 'workspace_usage'|trans({},'panel_modules') }}</summary>{% include 'infrastructure/_metrics.html.twig' with {usage:infra_node_usage(node)} %}</details></td>
                <td><a class="ui-button ui-button--ghost" href="{{ path('admin_kvm_node',{id:node.id}) }}">{{ 'edit'|trans({},'panel_modules') }}</a></td>
            </tr>{% else %}<tr><td colspan="4" class="cust-table__empty">{{ 'kvm.no_nodes'|trans({},'kvm') }}</td></tr>{% endfor %}</tbody>
        </table></div>
    </section>
</div>
{% endblock %}
