{% trans_default_domain 'infrastructure' %}
<section class="infra-card" data-infra-list>
 <div class="infra-card__head"><h2>{{ 'infra.servers'|trans }} <span class="infra-tag">{{ inventory.guests|length }}</span></h2><a class="ui-button ui-button--primary" href="#kvm-create" data-infra-shortcut>{{ 'infra.create'|trans }}</a></div>
 <div class="infra-search"><input class="form-input" type="search" placeholder="{{ 'infra.search'|trans }}" aria-label="{{ 'infra.search'|trans }}" data-infra-filter><select class="form-input" aria-label="{{ 'kvm.status'|trans({}, 'kvm') }}" data-infra-state><option value="">{{ 'infra.all_states'|trans }}</option><option value="running">{{ 'infra.running'|trans }}</option><option value="shut off">{{ 'infra.stopped'|trans }}</option></select></div>
 <div class="infra-table-wrap"><table class="infra-table"><thead><tr><th>{{ 'infra.server'|trans }}</th><th>{{ 'kvm.status'|trans({}, 'kvm') }}</th><th>{{ 'infra.cpu'|trans }}</th><th>{{ 'infra.memory'|trans }}</th><th>{{ 'infra.capacity'|trans }}</th><th></th></tr></thead><tbody>
 {% for vm in inventory.guests %}{% set usage = infra_kvm_usage(node, vm.id) %}<tr data-infra-item data-state="{{ vm.state }}"><td><a href="{{ path('admin_kvm_guest', {id: node.id, uuid: vm.id}) }}"><strong>{{ vm.label|default(vm.id) }}</strong></a><small>{{ vm.id }}</small></td><td><span class="infra-tag {{ vm.state == 'running' ? 'infra-tag--online' : '' }}">{{ vm.state }}</span><small>{{ (vm.managed ? 'kvm.managed' : 'kvm.external')|trans({}, 'kvm') }}</small></td><td>{{ usage.cpu_percent is not null ? usage.cpu_percent|number_format(1) ~ ' %' : '—' }}</td><td>{{ usage.memory_used_bytes is not null ? (usage.memory_used_bytes / 1073741824)|number_format(2) ~ ' GiB' : '—' }}</td><td>{{ vm.vcpus|default('—') }} vCPU · {{ vm.memory_mib|default('—') }} MiB<small>{{ vm.disk_gib|default('—') }} GiB</small></td><td><a class="ui-button ui-button--ghost" href="{{ path('admin_kvm_guest', {id: node.id, uuid: vm.id}) }}">{{ 'infra.open'|trans }}</a></td></tr>{% endfor %}
 </tbody></table></div><p class="infra-empty" data-infra-no-results {% if inventory.guests is not empty %}hidden{% endif %}>{{ 'infra.no_results'|trans }}</p>
</section>
