{% extends 'admin/base.html.twig' %}
{% set pageTitle = t('admin_mailboxes_title', page_locale()) %}
{% set activeNav = 'mailboxes' %}
{% set locale = page_locale() %}
{% block content %}
<div class="pm-workspace" data-panel-tabs="admin-mailboxes">
    <header class="pm-page-head">
        <div><h1>{{ pageTitle }}</h1><p>{{ t('admin_mailboxes_hero_intro',locale) }}</p></div>
        <a class="ui-button ui-button--primary" href="#pm-admin-mailboxes-create" hx-get="/admin/mailboxes/form" hx-target="#mailbox-form" hx-swap="outerHTML" data-panel-reveal="create">+ {{ t('admin_mailboxes_new',locale) }}</a>
    </header>
    {% include 'components/panel/_tabs.html.twig' with {panelKey:'admin-mailboxes',panelTabs:{overview:'workspace_inventory',create:'workspace_mailbox_editor'}} %}
    <div class="pm-stats pm-stats--four">
        {% for label,value in {admin_mailboxes_total:summary.total,admin_status_enabled:summary.enabled,admin_status_disabled:summary.disabled,admin_mailboxes_quota_total:summary.quotaTotal} %}
            {% include 'components/panel/_stat.html.twig' with {value:value,label:t(label,locale)} only %}
        {% endfor %}
    </div>
    <section data-panel-section="overview">{% include 'admin/mailboxes/_table.html.twig' with {mailboxes:mailboxes} %}</section>
    <section data-panel-section="create">{% include 'admin/mailboxes/_form.html.twig' with {domains:domains,form:form} %}</section>
</div>
{% endblock %}
