{% extends 'admin/base.html.twig' %}
{% block content %}
<div class="pm-edit-header"><div><h1>{{ node.name }}</h1><p>{{ 'db_node_editor'|trans({},'panel_modules') }} · #{{ node.id }}</p></div><a class="ui-button ui-button--ghost" href="{{ path('admin_databases') }}#pm-admin-databases-nodes">{{ 'back'|trans({},'panel_modules') }}</a></div>
{% for error in errors %}<p class="cust-alert cust-alert--error" role="alert">{{ error }}</p>{% endfor %}
{% if saved %}<p class="cust-alert cust-alert--success" role="status">{{ 'saved'|trans({},'panel_modules') }}</p>{% endif %}
<div class="pm-editor-grid"><section class="cust-panel"><div class="cust-panel__head"><h2 class="cust-panel__title">{{ 'configuration'|trans({},'panel_modules') }}</h2></div><div class="cust-panel__body"><form method="post" class="pm-form" autocomplete="off">
<input type="hidden" name="_token" value="{{ csrf_token('admin_database_node_edit_' ~ node.id) }}">
<label>{{ 'panel_name'|trans({},'panel_modules') }}<input class="form-input" name="name" value="{{ form.name }}" maxlength="120" required></label>
<div class="infra-grid"><label>{{ 'db_node_engine'|trans({},'panel_modules') }}<select name="engine" class="form-input" required{% if boundCount > 0 %} disabled{% endif %}>{% for engine in engines %}<option value="{{ engine }}"{% if engine == form.engine %} selected{% endif %}>{{ engine|upper }}</option>{% endfor %}</select>{% if boundCount > 0 %}<input type="hidden" name="engine" value="{{ form.engine }}">{% endif %}</label>
<label>{{ 'provisioning_agent'|trans({},'panel_modules') }}<select name="agent_id" class="form-input" required{% if boundCount > 0 %} disabled{% endif %}>{% for agent in agents %}<option value="{{ agent.id }}"{% if agent.id == form.agent_id %} selected{% endif %}>{{ agent.name ?: agent.id }}</option>{% endfor %}</select>{% if boundCount > 0 %}<input type="hidden" name="agent_id" value="{{ form.agent_id }}">{% endif %}</label>
<label>Host<input class="form-input" name="host" value="{{ form.host }}" maxlength="255" required{% if boundCount > 0 %} readonly{% endif %}></label><label>Port<input class="form-input" name="port" type="number" min="1" max="65535" value="{{ form.port }}" required{% if boundCount > 0 %} readonly{% endif %}></label></div>
{% if boundCount > 0 %}<p>{{ 'db_node_target_bound'|trans({},'panel_modules') }}</p>{% endif %}
<label>{{ 'db_node_admin_user'|trans({},'panel_modules') }}<input class="form-input" name="admin_user" value="{{ form.admin_user }}" maxlength="190" autocomplete="off"></label>
<label>{{ 'db_node_admin_secret'|trans({},'panel_modules') }}<input class="form-input" name="admin_secret" type="password" autocomplete="new-password" aria-describedby="db-secret-hint"></label><p id="db-secret-hint">{{ 'db_node_secret_hint'|trans({},'panel_modules') }}</p>
<div class="infra-grid"><label>TLS<select class="form-input" name="tls_mode">{% for mode in ['off','required','verify_ca','verify_full'] %}<option value="{{ mode }}"{% if mode == form.tls_mode %} selected{% endif %}>{{ ('db_node_tls_' ~ mode)|trans({},'panel_modules') }}</option>{% endfor %}</select></label><label>Tags<input class="form-input" name="tags" value="{{ form.tags }}" maxlength="2048"></label></div>
<label>{{ 'db_node_ca_cert'|trans({},'panel_modules') }}<textarea class="form-input" name="ca_cert" rows="5" maxlength="65535" spellcheck="false">{{ form.ca_cert }}</textarea></label>
<button class="ui-button ui-button--primary" type="submit">{{ 'save'|trans({},'panel_modules') }}</button>
</form></div></section>
<aside class="cust-panel"><div class="cust-panel__head"><h2 class="cust-panel__title">{{ 'overview'|trans({},'panel_modules') }}</h2></div><div class="cust-panel__body"><dl class="pm-keyvalues"><div><dt>{{ 'databases'|trans({},'panel_modules') }}</dt><dd>{{ boundCount }}</dd></div><div><dt>Status</dt><dd>{{ node.isActive ? 'db_node_active'|trans({},'panel_modules') : 'db_node_inactive'|trans({},'panel_modules') }}</dd></div><div><dt>{{ 'db_node_health'|trans({},'panel_modules') }}</dt><dd>{{ ('db_node_health_' ~ node.healthStatus)|trans({},'panel_modules') }}</dd></div><div><dt>{{ 'db_node_checked'|trans({},'panel_modules') }}</dt><dd>{{ node.lastCheckedAt ? node.lastCheckedAt|date('d.m.Y H:i') : '—' }}</dd></div></dl><p>{{ 'db_node_config_hint'|trans({},'panel_modules') }}</p></div></aside></div>
{% endblock %}
