{% extends 'admin/base.html.twig' %}
{% block content %}
<div class="cust-page" data-panel-tabs="mail-servers">
<header class="pm-edit-header"><div><h1>{{ 'mail_servers'|trans({},'panel_modules') }}</h1><p>{{ 'mail_servers_hint'|trans({},'panel_modules') }}</p></div><span class="ui-badge">{{ servers|length }}</span></header>
{% if error %}<p class="cust-alert cust-alert--error" role="alert">{{ error }}</p>{% endif %}{% if saved %}<p class="cust-alert cust-alert--success" role="status">{{ 'saved'|trans({},'panel_modules') }}</p>{% endif %}
{% include 'components/panel/_tabs.html.twig' with {panelKey:'mail-servers',panelTabs:{overview:'overview',create:'create',assignments:'assignments'}} %}
<div data-panel-section="overview">{% for server in servers %}<section class="cust-panel"><div class="cust-panel__head"><h2 class="cust-panel__title">{{ server.name }}</h2><span>{{ server.agent ? (server.agent.name ?: server.agent.id) : '—' }}</span></div><div class="cust-panel__body"><p>IMAP: {{ server.imapHost }}:{{ server.imapPort }} · SMTP: {{ server.smtpHost }}:{{ server.smtpPort }}</p><details id="mail-server-{{ server.id }}"><summary>{{ 'edit'|trans({},'panel_modules') }}</summary><form method="post" class="pm-form"><input type="hidden" name="_token" value="{{ csrf_token('admin_mail_servers') }}"><input type="hidden" name="action" value="edit"><input type="hidden" name="node_id" value="{{ server.id }}">{% include 'admin/mail-system/_server_fields.html.twig' %}<button class="ui-button ui-button--primary">{{ 'save'|trans({},'panel_modules') }}</button></form></details></div></section>{% else %}<div class="cust-panel cust-panel__body">{{ 'empty'|trans({},'panel_modules') }}</div>{% endfor %}</div>
<section class="cust-panel" data-panel-section="create"><div class="cust-panel__body"><form method="post" class="pm-form"><input type="hidden" name="_token" value="{{ csrf_token('admin_mail_servers') }}"><input type="hidden" name="action" value="create">{% include 'admin/mail-system/_server_fields.html.twig' with {server:null} %}<button class="ui-button ui-button--primary">{{ 'create'|trans({},'panel_modules') }}</button></form></div></section>
<section class="cust-panel" data-panel-section="assignments"><div class="cust-panel__body"><form method="post" class="pm-form"><input type="hidden" name="_token" value="{{ csrf_token('admin_mail_servers') }}"><input type="hidden" name="action" value="assign"><label>Domain<select name="domain_id" class="form-input" required><option value="">{{ 'select'|trans({},'panel_modules') }}</option>{% for domain in domains %}<option value="{{ domain.id }}">{{ domain.name }} · {{ domain.customer.email }}</option>{% endfor %}</select></label><label>{{ 'mail_servers'|trans({},'panel_modules') }}<select name="node_id" class="form-input" required><option value="">{{ 'select'|trans({},'panel_modules') }}</option>{% for server in servers %}<option value="{{ server.id }}">{{ server.name }}</option>{% endfor %}</select></label><button class="ui-button ui-button--primary">{{ 'save'|trans({},'panel_modules') }}</button></form></div></section>
</div>
{% endblock %}
