<label>{{ 'panel_name'|trans({},'panel_modules') }}<input class="form-input" name="name" value="{{ server ? server.name : '' }}" maxlength="120" required></label>
<div class="infra-grid"><label>IMAP Host<input class="form-input" name="imap_host" value="{{ server ? server.imapHost : '' }}" maxlength="255" required></label><label>IMAP Port<input class="form-input" name="imap_port" type="number" min="1" max="65535" value="{{ server ? server.imapPort : 993 }}" required></label><label>SMTP Host<input class="form-input" name="smtp_host" value="{{ server ? server.smtpHost : '' }}" maxlength="255" required></label><label>SMTP Port<input class="form-input" name="smtp_port" type="number" min="1" max="65535" value="{{ server ? server.smtpPort : 587 }}" required></label></div>
<label>Webmail URL<input class="form-input" name="roundcube_url" type="url" value="{{ server ? server.roundcubeUrl : '' }}" maxlength="255" placeholder="https://webmail.example.org"></label>
<label>{{ 'provisioning_agent'|trans({},'panel_modules') }}<select class="form-input" name="agent_id" required><option value="">{{ 'select'|trans({},'panel_modules') }}</option>{% for agent in agents %}<option value="{{ agent.id }}"{% if server and server.agent and server.agent.id == agent.id %} selected{% endif %}>{{ agent.name ?: agent.id }}</option>{% endfor %}</select></label>
