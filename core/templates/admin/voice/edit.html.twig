{% extends 'admin/base.html.twig' %}
{% block content %}
<div class="pm-edit-header"><div><h1>{{ server.name }}</h1><p>{{ provider == 'ts3' ? 'TeamSpeak 3' : 'TeamSpeak 6' }} · #{{ server.id }} · SID {{ server.sid }}</p></div><a class="ui-button ui-button--ghost" href="{{ path('admin_voice_workspace') }}">{{ 'back'|trans({},'panel_modules') }}</a></div>
{% if error %}<div class="ui-alert ui-alert--danger" role="alert">{{ error }}</div>{% endif %}
{% if queued %}<div class="ui-alert" role="status">{{ 'action_queued'|trans({},'panel_modules') }}</div>{% endif %}
{% if saved %}<div class="ui-alert ui-alert--success" role="status">{{ 'saved'|trans({},'panel_modules') }}</div>{% endif %}
<div class="pm-editor-grid"><section class="cust-panel"><div class="cust-panel__head"><h2 class="cust-panel__title">{{ 'configuration'|trans({},'panel_modules') }}</h2></div><div class="cust-panel__body"><form method="post" class="pm-form"><input type="hidden" name="_token" value="{{ csrf_token('admin_voice_edit_' ~ provider ~ '_' ~ server.id) }}"><input type="hidden" name="action" value="save"><label>{{ 'customer'|trans({},'panel_modules') }}<select class="form-input" name="customer_id" required>{% for customer in customers %}<option value="{{ customer.id }}"{% if customer.id == server.customerId %} selected{% endif %}>{{ customer.email }} · #{{ customer.id }}</option>{% endfor %}</select></label><label>{{ 'public_host'|trans({},'panel_modules') }}<input class="form-input" name="public_host" value="{{ server.publicHost }}" maxlength="253" autocomplete="off"></label><p>{{ 'voice_host_hint'|trans({},'panel_modules') }}</p><button class="ui-button ui-button--primary" type="submit">{{ 'save'|trans({},'panel_modules') }}</button></form></div></section><aside class="cust-panel"><div class="cust-panel__head"><h2 class="cust-panel__title">{{ 'overview'|trans({},'panel_modules') }}</h2></div><div class="cust-panel__body"><dl class="pm-keyvalues"><div><dt>Status</dt><dd>{{ server.status }}</dd></div><div><dt>Node</dt><dd>{{ server.node.name }}</dd></div><div><dt>Voice-Port</dt><dd>{{ server.voicePort ?? '—' }}</dd></div><div><dt>Filetransfer-Port</dt><dd>{{ server.filetransferPort ?? '—' }}</dd></div></dl><form method="post" class="pm-form pm-danger"><input type="hidden" name="_token" value="{{ csrf_token('admin_voice_edit_' ~ provider ~ '_' ~ server.id) }}"><label><span><input type="checkbox" name="confirm_action" value="1" required> {{ 'confirm_action'|trans({},'panel_modules') }}</span></label><div class="pm-subtabs">{% for action in ['start','stop','restart'] %}<button name="action" value="{{ action }}" type="submit"{% if server.sid <= 0 %} disabled{% endif %}>{{ action|trans({},'panel_modules') }}</button>{% endfor %}</div></form></div></aside></div>
{% endblock %}
