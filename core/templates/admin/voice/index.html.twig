{% extends 'admin/base.html.twig' %}
{% block content %}
<div class="pm-workspace">
<header class="pm-page-head"><div><h1>{{ 'voice'|trans({},'panel_modules') }}</h1><p>{{ 'workspace_voice_intro'|trans({},'panel_modules') }}</p></div><div class="pm-page-head__actions">{% if module_enabled('ts') %}<a class="ui-button ui-button--primary" href="{{ path('admin_ts3_servers_create') }}">+ TeamSpeak 3</a>{% endif %}{% if module_enabled('ts6') %}<a class="ui-button ui-button--primary" href="{{ path('admin_ts6_servers_create') }}">+ TeamSpeak 6</a>{% endif %}</div></header>
<div class="pm-stats">{% include 'components/panel/_stat.html.twig' with {value:servers|length,label:'workspace_voice_servers'|trans({},'panel_modules')} only %}{% include 'components/panel/_stat.html.twig' with {value:online,label:'workspace_online'|trans({},'panel_modules')} only %}{% include 'components/panel/_stat.html.twig' with {value:nodeRows|length,label:'nodes'|trans({},'panel_modules')} only %}</div>
<section class="cust-panel" data-panel-list><div class="pm-filters"><label class="sr-only" for="voice-filter">{{ 'search'|trans({},'panel_modules') }}</label><input id="voice-filter" class="form-input" type="search" data-panel-filter placeholder="{{ 'workspace_server_search'|trans({},'panel_modules') }}"><label class="sr-only" for="voice-version">Version</label><select id="voice-version" class="form-input" data-panel-facet="provider"><option value="">{{ 'workspace_all_versions'|trans({},'panel_modules') }}</option>{% if module_enabled('ts') %}<option value="ts3">TeamSpeak 3</option>{% endif %}{% if module_enabled('ts6') %}<option value="ts6">TeamSpeak 6</option>{% endif %}</select></div><div class="infra-table-wrap"><table class="cust-table"><thead><tr><th>{{ 'servers'|trans({},'panel_modules') }}</th><th>Version</th><th>{{ 'customer'|trans({},'panel_modules') }}</th><th>Node</th><th>Status</th><th>{{ 'actions'|trans({},'panel_modules') }}</th></tr></thead><tbody>{% for row in servers %}{% set server = row.server %}<tr data-panel-row data-provider="{{ row.provider }}"><td><a class="pm-server-name" href="{{ path('admin_voice_edit',{provider:row.provider,id:server.id}) }}">{{ server.name }}</a><small class="pm-cell-sub">SID {{ server.sid }}</small></td><td><span class="ui-badge ui-badge--neutral">{{ row.provider|upper }}</span></td><td>{{ customerNames[server.customerId]|default('#' ~ server.customerId) }}</td><td>{{ server.node.name }}</td><td><span class="ui-badge ui-badge--{{ server.status in ['online','running'] ? 'success' : 'neutral' }}">{{ server.status }}</span></td><td><a class="ui-button ui-button--ghost" href="{{ path('admin_voice_edit',{provider:row.provider,id:server.id}) }}">{{ 'edit'|trans({},'panel_modules') }}</a></td></tr>{% else %}<tr><td colspan="6">{{ 'empty'|trans({},'panel_modules') }}</td></tr>{% endfor %}</tbody></table></div></section>
<section class="cust-panel"><div class="cust-panel__head"><h2 class="cust-panel__title">{{ 'nodes'|trans({},'panel_modules') }}</h2><a class="ui-button ui-button--ghost" href="{{ path('admin_ts_nodes_index') }}">{{ 'administration'|trans({},'panel_modules') }}</a></div><div class="infra-table-wrap"><table class="cust-table"><thead><tr><th>Node</th><th>Version</th><th>{{ 'workspace_voice_servers'|trans({},'panel_modules') }}</th></tr></thead><tbody>{% for node in nodeRows %}<tr><td>{{ node.name }}</td><td>{{ node.provider|upper }}</td><td>{{ node.count }}</td></tr>{% else %}<tr><td colspan="3">{{ 'empty'|trans({},'panel_modules') }}</td></tr>{% endfor %}</tbody></table></div></section>
</div>
{% endblock %}
