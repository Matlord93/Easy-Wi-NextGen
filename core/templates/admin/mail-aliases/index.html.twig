{% extends 'admin/base.html.twig' %}
{% set pageTitle = t('admin_mail_aliases_title', page_locale()) %}
{% set activeNav = 'mail-aliases' %}
{% set locale = page_locale() %}
{% block content %}
<div class="pm-workspace" data-panel-tabs="admin-mail-aliases">
    <header class="pm-page-head">
        <div><h1>{{ pageTitle }}</h1><p>{{ t('admin_mail_aliases_hero_intro',locale) }}</p></div>
        <a class="ui-button ui-button--primary" href="#pm-admin-mail-aliases-create" hx-get="/admin/mail-aliases/form" hx-target="#mail-alias-form" hx-swap="outerHTML" data-panel-reveal="create">+ {{ t('admin_mail_aliases_new',locale) }}</a>
    </header>
    {% include 'components/panel/_tabs.html.twig' with {panelKey:'admin-mail-aliases',panelTabs:{overview:'workspace_inventory',create:'workspace_alias_editor'}} %}
    <div class="pm-stats pm-stats--four">
        {% for label,value in {admin_mail_aliases_total:summary.total,admin_status_enabled:summary.enabled,admin_status_disabled:summary.disabled,admin_mail_aliases_destinations:summary.destinations} %}
            {% include 'components/panel/_stat.html.twig' with {value:value,label:t(label,locale)} only %}
        {% endfor %}
    </div>
    <section data-panel-section="overview">{% include 'admin/mail-aliases/_table.html.twig' with {aliases:aliases} %}</section>
    <section data-panel-section="create">{% include 'admin/mail-aliases/_form.html.twig' with {domains:domains,form:form} %}</section>
</div>
{% endblock %}
