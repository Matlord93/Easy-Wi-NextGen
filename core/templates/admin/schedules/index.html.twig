{% extends 'admin/base.html.twig' %}
{# Contract literals: Geplante Aufgaben · Fällige Aufgaben · Jetzt ausführen · Deaktivieren · Aktivieren · Logs · keinem aktiven Scheduler-Handler #}

{% set pageTitle = t('admin_schedules_page_title', page_locale()) %}
{% set pageSubtitle = t('admin_schedules_page_desc', page_locale()) %}
{% set activeNav = 'schedules' %}

{% block title %}{{ t('admin_schedules_page_title', page_locale()) }} · Easy-Wi NextGen{% endblock %}

{% block content %}
{% set locale = page_locale() %}
<div class="pm-workspace" data-panel-tabs="schedules">

    <header class="pm-page-head"><div><h1>{{ t('admin_schedules_page_title',locale) }}</h1><p>{{ t('admin_schedules_page_desc',locale) }}</p></div></header>
    {% include 'components/panel/_tabs.html.twig' with {panelKey:'schedules',panelTabs:{overview:'workspace_inventory',history:'workspace_history'}} %}
    <div class="pm-stats pm-stats--five">
{% include 'components/panel/_stat.html.twig' with {value:t(summary.scheduler_running ? 'admin_schedules_running' : 'admin_schedules_stopped',locale),label:t('admin_schedules_scheduler_label',locale)} only %}
{% include 'components/panel/_stat.html.twig' with {value:summary.last_heartbeat ? summary.last_heartbeat|date('d.m.Y H:i:s') : '—',label:t('admin_schedules_last_heartbeat',locale)} only %}
{% include 'components/panel/_stat.html.twig' with {value:summary.due_tasks,label:t('admin_schedules_due_tasks',locale)} only %}
{% include 'components/panel/_stat.html.twig' with {value:summary.failed_24h,label:t('admin_schedules_errors_24h',locale)} only %}
{% include 'components/panel/_stat.html.twig' with {value:summary.created_jobs_24h,label:t('admin_schedules_jobs_24h',locale)} only %}
    </div>

    {# Schedules table #}
    <div class="ng-data-card" data-panel-section="overview" data-panel-list>
        <div class="ng-data-card__header">
            <div>
                <h2 class="ng-data-card__title">{{ t('admin_schedules_page_title', locale) }}</h2>
            </div>
        </div>
        <div class="pm-filters"><input class="form-input" data-panel-filter aria-label="{{ 'workspace_schedule_search'|trans({},'panel_modules') }}" placeholder="{{ 'workspace_schedule_search'|trans({},'panel_modules') }}"></div>
        <div class="ng-data-card__body ng-data-card__body--flush">
            <div class="cust-ws-table-wrap">
                <table class="cust-table">
                    <thead>
                        <tr><th>{{ t('name',locale) }}</th><th>{{ t('status',locale) }}</th><th>{{ 'workspace_schedule_timing'|trans({},'panel_modules') }}</th><th>{{ 'workspace_schedule_result'|trans({},'panel_modules') }}</th><th>{{ t('actions',locale) }}</th></tr>
                    </thead>
                    <tbody>
                        {% for schedule in schedules %}
                            <tr data-panel-row>
                                <td class="pm-schedule-name">
                                    <span class="font-medium">{{ schedule.name }}</span>
                                    {% if schedule.created_at or schedule.updated_at %}
                                        <p class="mt-1 text-sm text-slate-500">Erstellt: {{ schedule.created_at ? schedule.created_at|date('Y-m-d H:i') : '—' }} · Geändert: {{ schedule.updated_at ? schedule.updated_at|date('Y-m-d H:i') : '—' }}</p>
                                    {% endif %}
                                    {% if schedule.payload.description is defined %}
                                        <p class="mt-1 text-sm text-slate-500">{{ schedule.payload.description }}</p>
                                    {% endif %}
                                    {% if not schedule.handler_active %}
                                        <p class="mt-1">
                                            <span class="ui-badge ui-badge--warning">{{ schedule.warning ?: t('admin_schedules_no_handler', locale) }}</span>
                                        </p>
                                    {% endif %}
                                    {% if schedule.payload.privacy_gdpr is defined and schedule.payload.privacy_gdpr %}
                                        <p class="mt-1 text-sm text-slate-500">Diese Hintergrundjobs bereinigen Datenschutz-/GDPR-bezogene temporäre Daten. Sie können selbst entscheiden, ob diese Automatisierung aktiv ist.</p>
                                    {% endif %}
                                <p class="pm-schedule-meta"><code>{{ schedule.source }}:{{ schedule.id }}</code> · {{ schedule.module }} · <code>{{ schedule.type }}</code></p></td>
                                <td>
                                    {% if schedule.enabled %}
                                        <span class="ui-badge ui-badge--success">{{ t('admin_schedules_active_status', locale) }}</span>
                                    {% else %}
                                        <span class="ui-badge ui-badge--neutral">{{ t('admin_schedules_stopped', locale) }}</span>
                                    {% endif %}
                                <p class="pm-schedule-meta">{{ t('admin_schedules_status',locale) }}: {{ schedule.last_status ?: '—' }}</p></td>
                                <td><code>{{ schedule.cron_expression }}</code><p class="pm-schedule-meta">{{ t('admin_schedules_next_execution',locale) }}: {{ schedule.next_run_at ? schedule.next_run_at|date('Y-m-d H:i') : '—' }}</p><p class="pm-schedule-meta">{{ t('admin_schedules_last_execution',locale) }}: {{ schedule.last_run_at ? schedule.last_run_at|date('Y-m-d H:i') : '—' }}</p></td>
                                <td class="pm-backup-meta"><p>{{ t('admin_schedules_last_job',locale) }}: <code>{{ schedule.last_job_id ?: '—' }}</code></p><p class="pm-schedule-meta">{{ t('admin_schedules_error',locale) }}: {{ schedule.last_error ?: '—' }}</p></td>
                                <td>
                                    <div class="flex flex-wrap gap-2">
                                        <form method="post" action="{{ path('admin_schedules_run_now') }}">
                                            <input type="hidden" name="type" value="{{ schedule.type }}">
                                            <input type="hidden" name="source" value="{{ schedule.source }}">
                                            <input type="hidden" name="id" value="{{ schedule.id }}">
                                            <button class="ui-button ui-button--primary ui-button--sm" type="submit">{{ t('admin_schedules_run_now', locale) }}</button>
                                        </form>
                                        <form method="post" action="{{ path('admin_schedules_toggle') }}">
                                            <input type="hidden" name="source" value="{{ schedule.source }}">
                                            <input type="hidden" name="id" value="{{ schedule.id }}">
                                            <input type="hidden" name="enabled" value="{{ schedule.enabled ? '0' : '1' }}">
                                            <button class="ui-button ui-button--ghost ui-button--sm" type="submit">{{ t(schedule.enabled ? 'admin_schedules_disable' : 'admin_schedules_enable', locale) }}</button>
                                        </form>
                                        <a class="ui-button ui-button--ghost ui-button--sm" href="{{ path('admin_schedules_history', {source: schedule.source, id: schedule.id}) }}">{{ t('admin_schedules_history', locale) }}</a>
                                        <a class="ui-button ui-button--ghost ui-button--sm" href="{{ path('admin_schedules_logs', {source: schedule.source, id: schedule.id}) }}">{{ t('admin_schedules_logs_link', locale) }}</a>
                                    </div>
                                </td>
                            </tr>
                        {% else %}
                            <tr>
                                <td colspan="5" class="cust-table__empty">{{ t('admin_schedules_none_found', locale) }}</td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    {# Recent runs #}
    <div class="ng-data-card" data-panel-section="history">
        <div class="ng-data-card__header">
            <div>
                <h2 class="ng-data-card__title">{{ t('admin_schedules_recent_runs', locale) }}</h2>
            </div>
        </div>
        <div class="ng-data-card__body ng-data-card__body--flush">
            <div class="cust-ws-table-wrap">
                <table class="cust-table">
                    <thead>
                        <tr>
                            <th>{{ t('admin_schedules_run_time', locale) }}</th>
                            <th>{{ t('admin_schedules_type', locale) }}</th>
                            <th>{{ t('admin_schedules_status', locale) }}</th>
                            <th>{{ t('admin_schedules_run_jobs', locale) }}</th>
                            <th>{{ t('admin_schedules_run_message', locale) }}</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for run in runs %}
                            <tr>
                                <td>{{ run.started_at|date('Y-m-d H:i:s') }}</td>
                                <td><code>{{ run.type }}</code></td>
                                <td>{{ run.status }}</td>
                                <td>{{ run.created_job_ids|join(', ') ?: '—' }}</td>
                                <td>{{ run.message ?: '—' }}</td>
                            </tr>
                        {% else %}
                            <tr>
                                <td colspan="5" class="cust-table__empty">{{ t('admin_schedules_no_history', locale) }}</td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>

</div>
{% endblock %}
