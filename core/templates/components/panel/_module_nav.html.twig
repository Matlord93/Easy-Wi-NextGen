{% set moduleLinks = [] %}
{% set modulePath = app.request ? app.request.pathInfo : '' %}
{% if activeNav in ['game-instances','templates','minecraft','plugins'] %}
    {% set moduleLinks = [
        {href:path('admin_instances'),label:'gameservers',active:activeNav == 'game-instances'},
        {href:path('admin_templates'),label:'templates',active:activeNav == 'templates'},
        {href:path('admin_minecraft'),label:'Minecraft',literal:true,active:activeNav == 'minecraft'},
        {href:path('admin_plugins'),label:'Add-ons',literal:true,active:activeNav == 'plugins'},
        {href:path('admin_nodes'),label:'nodes'}, {href:path('admin_schedules'),label:'tasks'}
    ] %}
{% elseif modulePath starts with '/admin/voice' or modulePath starts with '/admin/ts3' or modulePath starts with '/admin/ts6' or modulePath starts with '/admin/teamspeak' %}
    {% set moduleLinks = [{href:path('admin_voice_workspace'),label:'voice',active:activeNav == 'voice-workspace'}] %}
    {% if moduleTs %}{% set moduleLinks = moduleLinks|merge([{href:path('admin_ts3_servers_index'),label:'TeamSpeak 3',literal:true,active:activeNav == 'ts3-servers'}]) %}{% endif %}
    {% if moduleTs6 %}{% set moduleLinks = moduleLinks|merge([{href:path('admin_ts6_servers_index'),label:'TeamSpeak 6',literal:true,active:activeNav == 'ts6-servers'}]) %}{% endif %}
    {% set moduleLinks = moduleLinks|merge([{href:path('admin_ts_nodes_index'),label:'nodes',active:activeNav == 'ts-nodes'},{href:path('admin_schedules'),label:'tasks'}]) %}
{% elseif activeNav == 'musicbots' %}
    {% set moduleLinks = [{href:path('admin_musicbot_index'),label:'workspace_inventory',active:modulePath not in ['/admin/musicbots/limits','/admin/musicbots/plugins','/admin/musicbots/teamspeak-backend']},{href:path('admin_musicbot_limits'),label:'workspace_music_limits',active:modulePath == '/admin/musicbots/limits'},{href:path('admin_musicbot_plugins'),label:'workspace_music_plugins',active:modulePath == '/admin/musicbots/plugins'},{href:path('admin_musicbot_teamspeak_backend'),label:'TeamSpeak Backend',literal:true,active:modulePath == '/admin/musicbots/teamspeak-backend'}] %}
{% elseif activeNav == 'sinusbot' %}
    {% set moduleLinks = [{href:path('admin_sinusbot_nodes_index'),label:'nodes',active:modulePath != '/admin/sinusbot/nodes/new'},{href:'/admin/sinusbot/nodes/new',label:'create',active:modulePath == '/admin/sinusbot/nodes/new'}] %}
{% elseif activeNav in ['schedules','jobs'] %}
    {% set moduleLinks = [{href:path('admin_schedules'),label:'workspace_scheduled_tasks',active:activeNav == 'schedules'},{href:path('admin_jobs'),label:'workspace_job_queue',active:activeNav == 'jobs'}] %}
{% elseif activeNav in ['proxmox','kvm'] %}
    {% set moduleLinks = [{href:path('admin_proxmox'),label:'Proxmox',literal:true,active:activeNav == 'proxmox'},{href:path('admin_kvm'),label:'KVM',literal:true,active:activeNav == 'kvm'}] %}
{% elseif activeNav in ['mail-system','mailboxes','mail-aliases','mail-health','mail-matrix','mail-servers'] %}
    {% set moduleLinks = [{href:path('admin_mailboxes'),label:'Postfächer',literal:true,active:activeNav == 'mailboxes'},{href:path('admin_mail_aliases'),label:'Aliase',literal:true,active:activeNav == 'mail-aliases'},{href:path('admin_mail_servers'),label:'mail_servers',active:activeNav == 'mail-servers'},{href:path('admin_mail_system'),label:'configuration',active:activeNav == 'mail-system'},{href:path('admin_mail_health'),label:'Status',literal:true,active:activeNav == 'mail-health'},{href:path('admin_mail_matrix'),label:'Mail-Matrix',literal:true,active:activeNav == 'mail-matrix'}] %}
{% endif %}
{% if moduleLinks is not empty %}<nav class="pm-module-nav" aria-label="{{ 'navigation'|trans({}, 'panel_modules') }}">{% for item in moduleLinks %}<a href="{{ item.href }}"{% if item.active|default(false) %} aria-current="page"{% endif %}>{{ item.literal|default(false) ? item.label : item.label|trans({}, 'panel_modules') }}</a>{% endfor %}</nav>{% endif %}
