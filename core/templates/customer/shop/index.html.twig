{% extends 'customer/base.html.twig' %}
{% block title %}Shop · Easy-Wi{% endblock %}
{% block content %}
<div class="pm-workspace" data-panel-tabs="customer-shop">
    <header class="pm-page-head"><div><h1>{{ 'workspace_shop_title'|trans({},'panel_modules') }}</h1><p>{{ 'workspace_shop_intro'|trans({},'panel_modules') }}</p></div><div class="pm-page-head__actions"><a class="ui-button ui-button--primary" href="{{ path('customer_contracts') }}">{{ 'workspace_my_contracts'|trans({},'panel_modules') }}</a><a class="ui-button ui-button--ghost" href="{{ path('customer_wallet') }}">{{ 'workspace_wallet'|trans({},'panel_modules') }}</a></div></header>
    {% include 'components/panel/_tabs.html.twig' with {panelKey:'customer-shop',panelTabs:{catalog:'workspace_catalog',orders:'workspace_orders',rentals:'workspace_prepaid_services'}} %}
    <div class="pm-stats">
        {% include 'components/panel/_stat.html.twig' with {value:products|length,label:'workspace_products_on_page'|trans({},'panel_modules')} only %}
        {% include 'components/panel/_stat.html.twig' with {value:orders|length,label:'workspace_orders_on_page'|trans({},'panel_modules')} only %}
        {% include 'components/panel/_stat.html.twig' with {value:rentals|length,label:'workspace_prepaid_services'|trans({},'panel_modules')} only %}
    </div>
    <section class="cust-panel" data-panel-section="catalog"><div class="cust-panel__body">
        <form method="get" class="ng-form pm-catalog-filters"><input class="form-input" name="q" placeholder="Produkte suchen" value="{{ app.request.query.get('q') }}"><select class="form-input" name="category"><option value="">Alle Kategorien</option>{% for category in categories %}<option value="{{ category.id }}"{% if app.request.query.get('category') == category.id %} selected{% endif %}>{{ category.name }}</option>{% endfor %}</select><button class="ui-button" type="submit">Suchen</button></form>
        {% for category in categories %}{% if category.description %}<p><strong>{{ category.name }}</strong> · {{ category.description }}</p>{% endif %}{% endfor %}
        <div class="cust-server-grid mt-4">{% for product in products %}<article class="cust-panel p-4 space-y-3">{% if product.imageUrl %}<img src="{{ product.imageUrl }}" alt="{{ product.name }}" loading="lazy" class="w-full rounded-lg object-cover" style="height:160px;">{% endif %}<h2>{{ product.name }}</h2><p>{{ product.description }}</p><p>{{ rental_availability(product) }}</p>{% if product.kind.value in ['gameserver','kvm'] %}<p>{{ product.cpuLimit }} CPU · {{ product.ramLimit }} GB RAM · {{ product.diskLimit }} GB SSD</p>{% elseif product.kind.value == 'webspace' %}<p>{{ product.diskLimit }} GiB Webspace · PHP {{ product.provisioningOptions.php_version|default('8.4') }}</p>{% elseif product.kind.value in ['teamspeak3','teamspeak6'] %}<p>{{ product.provisioningOptions.slots|default(32) }} Voice-Slots</p>{% endif %}<p>{{ ((product.priceMonthlyCents * (product.kind.value == 'domain' ? product.provisioningOptions.term_months|default(12) : 1)) / 100)|number_format(2, ',', '.') }} {{ currency }} / {{ product.kind.value == 'domain' ? product.provisioningOptions.term_months|default(12) ~ ' Monate feste Laufzeit' : '30 Tage, minutengenau kündbar' }}</p><a class="ui-button ui-button--primary" href="{{ path('customer_contract_new', {id: product.id}) }}">Konfigurieren</a></article>{% else %}<p>Keine passenden Produkte.</p>{% endfor %}</div>
        <nav class="flex gap-4">{% if product_page > 1 %}<a href="{{ path('customer_shop',{product_page:product_page - 1,q:app.request.query.get('q'),category:app.request.query.get('category')}) }}">Vorherige Produkte</a>{% endif %}{% if more_products %}<a href="{{ path('customer_shop',{product_page:product_page + 1,q:app.request.query.get('q'),category:app.request.query.get('category')}) }}">Weitere Produkte</a>{% endif %}</nav>
    </div></section>
    <section class="cust-panel" data-panel-section="rentals"><div class="cust-panel__body space-y-3"><h2>Bestehende vorausbezahlte Systeme</h2>
        {% for rental in rentals %}<article class="border rounded p-4 space-y-2"><h3>{{ rental.product.name }} · Instanz #{{ rental.instance.id }}</h3><p>Bezahlt bis {{ rental.expiresAt|date('d.m.Y H:i') }} · {{ rental.autoRenew ? 'Automatische Verlängerungsrechnung aktiv' : 'Keine automatische Verlängerung' }}</p><p>Monatspreis: {{ ((rental.renewalConfiguration.monthly_cents is defined ? rental.renewalConfiguration.monthly_cents : rental.product.priceMonthlyCents) / 100)|number_format(2, ',', '.') }} {{ rental.renewalConfiguration.currency|default(currency) }} inkl. anfallender Steuern.</p>
            <form method="post" action="{{ path('customer_shop_extend', {id:rental.id}) }}" class="ng-form flex gap-2"><input type="hidden" name="_token" value="{{ csrf_token('shop') }}"><input type="hidden" name="nonce" value="{{ nonce }}"><label>Monate <input class="form-input" type="number" name="months" min="1" max="36" value="1" required></label><button class="ui-button" type="submit">Verlängerung bestellen</button></form>
            {% if rental.autoRenew %}<form method="post" action="{{ path('customer_shop_subscription_cancel', {id:rental.id}) }}"><input type="hidden" name="_token" value="{{ csrf_token('shop') }}"><button class="ui-button" type="submit">Automatische Verlängerungsrechnungen beenden</button></form>{% endif %}
        </article>{% else %}<p>Noch keine Systeme bestellt.</p>{% endfor %}
    </div></section>
    <section class="cust-panel" data-panel-section="orders"><div class="cust-panel__body space-y-3"><h2>Meine Bestellungen</h2>{% for order in orders %}<p><a href="{{ path('customer_shop_order_detail', {id:order.id}) }}">#{{ order.id }} · {{ order.configuration.name|default(order.product.name) }} · {{ order.status.value }} · {{ (order.totalPriceCents / 100)|number_format(2, ',', '.') }} {{ order.configuration.currency|default(currency) }}</a></p>{% else %}<p>Noch keine Bestellungen.</p>{% endfor %}<div class="flex gap-4">{% if page > 1 %}<a href="{{ path('customer_shop', {page:page-1}) }}">Zurück</a>{% endif %}{% if orders|length == 25 %}<a href="{{ path('customer_shop', {page:page+1}) }}">Weitere Bestellungen</a>{% endif %}</div></div></section>
</div>
{% endblock %}
