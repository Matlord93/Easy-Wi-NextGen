{% extends 'customer/base.html.twig' %}
{% block title %}{{ product.name }} · Bestellung{% endblock %}
{% block content %}
<div class="cust-page"><section class="cust-panel"><div class="cust-panel__body ng-form space-y-5">
<h1>{{ product.name }}</h1><p>{{ product.description }}</p>
<form method="get" class="space-y-3"><input type="hidden" name="product_id" value="{{ product.id }}">
<label>Variante<select class="form-input" name="variant_id"><option value="0">Standard · {{ (product.priceMonthlyCents / 100)|number_format(2, ',', '.') }} {{ quote.currency }}/Monat</option>{% for variant in variants %}<option value="{{ variant.id }}"{% if quote.variant_id == variant.id %} selected{% endif %}>{{ variant.name }} · {{ variant.cpuLimit }} CPU / {{ variant.ramLimit }} GB RAM / {{ variant.diskLimit }} GB SSD · {{ (variant.priceMonthlyCents / 100)|number_format(2, ',', '.') }} {{ quote.currency }}/Monat</option>{% endfor %}</select></label>
<label>Monate pro Abrechnungszeitraum<input class="form-input" type="number" name="months" value="{{ quote.months }}" min="1" max="36" required></label>
<label>Gutscheincode<input class="form-input" name="coupon" value="{{ quote.coupon }}" maxlength="40"></label>
{% if product.subscriptionEnabled %}<label><input type="checkbox" name="subscription" value="1"{% if quote.subscription %} checked{% endif %}> Als Abo bestellen</label>{% endif %}
<button type="submit" class="ui-button">Preis aktualisieren</button></form>
<div class="border rounded p-4"><h2>Bestellübersicht</h2><p>{{ quote.name }} {{ quote.variant }} · {{ quote.months }} Monate · {{ quote.cpu }} CPU / {{ quote.ram }} GB RAM / {{ quote.disk }} GB SSD</p><p>Zwischensumme: {{ (quote.subtotal_cents / 100)|number_format(2, ',', '.') }} {{ quote.currency }}</p><p>Rabatt: {{ (quote.discount_cents / 100)|number_format(2, ',', '.') }} {{ quote.currency }}</p><p><strong>Gesamtpreis: {{ (quote.total_cents / 100)|number_format(2, ',', '.') }} {{ quote.currency }} inkl. anfallender Steuern</strong></p>
{% if quote.subscription %}<p>Danach alle {{ quote.months }} Monate {{ (quote.subtotal_cents / 100)|number_format(2, ',', '.') }} {{ quote.currency }}. Gutscheine gelten für die erste Rechnung. Eine Folgerechnung entsteht sieben Tage vor Ablauf. Ohne bestätigte Zahlung wird der Dienst nach Ablauf gesperrt. Keine automatische Abbuchung ohne gesondertes Zahlungsmandat. Kündigung im Kundenbereich zum Ende des bezahlten Zeitraums.</p>{% else %}<p>Keine automatische Verlängerung. Der Dienst endet nach dem bezahlten Zeitraum.</p>{% endif %}
<p>Die Bereitstellung beginnt nach bestätigter Zahlung. Bei fehlenden Installationsangaben wird der Bearbeitungsbedarf in der Bestellung angezeigt.</p></div>
<form method="post" action="{{ path('customer_shop_order') }}" class="space-y-3"><input type="hidden" name="_token" value="{{ csrf_token('shop') }}"><input type="hidden" name="product_id" value="{{ product.id }}"><input type="hidden" name="nonce" value="{{ nonce }}"><input type="hidden" name="digest" value="{{ digest }}">{% for key in ['months','variant_id','coupon','subscription'] %}<input type="hidden" name="{{ key }}" value="{{ quote[key] is same as(true) ? '1' : (quote[key] is same as(false) ? '0' : quote[key]) }}">{% endfor %}<label><input type="checkbox" name="terms" value="1" required> Ich bestätige diese Bestellung und die oben genannten Laufzeit- und Zahlungsbedingungen.</label><button type="submit" class="ui-button ui-button--primary">{{ quote.total_cents > 0 ? 'Zahlungspflichtig bestellen' : 'Kostenfrei bestellen' }}</button></form>
</div></section></div>
{% endblock %}
