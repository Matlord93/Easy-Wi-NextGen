{% extends 'customer/base.html.twig' %}
{% set activeNav = 'billing' %}
{% block content %}
<div class="pm-workspace">
    <header class="pm-page-head"><div><h1>{{ 'billing.invoice'|trans({},'billing') }} {{ invoice.number ?: '#' ~ invoice.id }}</h1><p>{{ 'billing.due_date'|trans({},'billing') }}: {{ invoice.due_date|date('Y-m-d') }}</p></div><div class="pm-page-head__actions">
        <a class="ui-button ui-button--primary" href="{{ path('customer_billing_invoice_pdf',{id:invoice.id}) }}">{{ 'billing.download_pdf'|trans({},'billing') }}</a>
        <a class="ui-button ui-button--ghost" href="{{ path('customer_billing_electronic',{id:invoice.id}) }}">{{ 'billing.einvoice'|trans({},'billing') }}</a>
        <a class="ui-button ui-button--ghost" href="{{ path('customer_billing') }}">{{ 'billing.back'|trans({},'billing') }}</a>
    </div></header>
    {% if manual_payment %}
      <div class="ng-alert">
        <p>{{ 'billing.manual_payment_hint'|trans({}, 'billing') }}</p>
        <p>{{ invoice.details.company.footer|default('')|nl2br }}</p>
        <p>IBAN: {{ invoice.details.company.iban|default('') }} · BIC: {{ invoice.details.company.bic|default('') }}</p>
        <p>{{ 'billing.reference'|trans({}, 'billing') }}: {{ invoice.number }}</p>
      </div>
    {% endif %}
    <div class="pm-stats">
        {% include 'components/panel/_stat.html.twig' with {value:(invoice.amount_total / 100)|number_format(2,'.',',') ~ ' ' ~ invoice.currency,label:'billing.total'|trans({},'billing')} only %}
        {% include 'components/panel/_stat.html.twig' with {value:(invoice.amount_due / 100)|number_format(2,'.',',') ~ ' ' ~ invoice.currency,label:'billing.outstanding'|trans({},'billing')} only %}
        {% include 'components/panel/_stat.html.twig' with {value:('billing.state.' ~ invoice.status)|trans({},'billing'),label:'billing.status'|trans({},'billing')} only %}
    </div>
    <section class="cust-panel"><div class="cust-panel__head"><h2 class="cust-panel__title">{{ 'workspace_invoice_items'|trans({},'panel_modules') }}</h2></div><div class="cust-panel__body">
        {% include 'billing/_items.html.twig' %}
    {% for group in invoice.details.tax_breakdown|default([{tax_rate_bps:invoice.details.tax_rate_bps|default(0), tax_cents:invoice.details.tax_cents|default(0)}]) %}<p>{{ 'billing.tax'|trans({}, 'billing') }} ({{ (group.tax_rate_bps / 100)|number_format(2) }}%): {{ (group.tax_cents / 100)|number_format(2) }} {{ invoice.currency }}</p>{% endfor %}
    <p>{{ 'billing.due_date'|trans({}, 'billing') }}: {{ invoice.due_date|date('Y-m-d') }} · {{ ('billing.state.' ~ invoice.status)|trans({}, 'billing') }}</p>
    {% if invoice.cancellation_reason %}<p>{{ 'billing.cancelled'|trans({}, 'billing') }}: {{ invoice.cancellation_reason }}</p>{% endif %}
    </div></section>
    <section class="pm-invoice-payment">
    {% if invoice.status in ['open', 'past_due'] and invoice.amount_due > 0 %}
    <form method="post" action="{{ path('customer_invoice_pay', {id: invoice.id}) }}" style="margin-top:15px;">
      <input type="hidden" name="_token" value="{{ csrf_token('billing') }}">
      {% if payment_methods is defined %}<label>{{ 'workspace_payment_method'|trans({},'panel_modules') }} <select class="form-input" name="provider">{% for method in payment_methods %}<option value="{{ method }}">{{ {card:'Karte (Stripe)',klarna:'Klarna (Stripe)',sepa_debit:'SEPA-Lastschrift (Stripe)',paypal:'PayPal',bank_transfer:'Überweisung'}[method] }}</option>{% endfor %}</select></label>{% endif %}
      <button class="ui-button ui-button--primary">{{ 'billing.pay'|trans({}, 'billing') }}</button>
    </form>
    {% endif %}    </section>
    {% include 'billing/_history.html.twig' %}
</div>
{% endblock %}
