{% extends 'customer/base.html.twig' %}
{% trans_default_domain 'vm_config' %}
{% block content %}
<section class="infra-card">
    <div class="infra-card__head"><h1>{{ 'vm_config.root_password'|trans }}</h1></div>
    <p>{{ 'vm_config.root_password_ready'|trans }}</p>
    <label>{{ 'vm_config.root_password_copy'|trans }}
        <input class="form-input" type="text" value="{{ password }}" readonly autocomplete="off" spellcheck="false">
    </label>
    <a class="ui-button ui-button--ghost" href="{{ back }}">{{ 'vm_config.root_password_back'|trans }}</a>
</section>
{% endblock %}
