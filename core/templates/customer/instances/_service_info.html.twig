{% set labels = {online:t('customer_instance_query_status_online',page_locale()),offline:t('customer_instance_query_status_offline',page_locale()),unknown:t('customer_instance_query_status_unknown',page_locale())} %}
<section class="cust-panel" data-instance-query="{{ instance.id }}" data-query-status-labels="{{ labels|json_encode|e('html_attr') }}"><div class="cust-panel__head"><h2 class="cust-panel__title">{{ 'workspace_service_info'|trans({},'panel_modules') }}</h2></div><div class="cust-panel__body"><dl class="pm-keyvalues">
<div><dt>IP-Adresse / Host</dt><dd>{{ instance.connection.host|default(instance.hostname|default('—')) }}</dd></div><div><dt>Verbindung</dt><dd>{{ instance.game_address|default(instance.connection.address|default('—')) }}</dd></div>{% if instance.connection.ipv6_address|default(null) %}<div><dt>IPv6</dt><dd>{{ instance.connection.ipv6_address }}</dd></div>{% endif %}
<div><dt>Live-Status</dt><dd data-query-status>{{ instance.query.status|default('unknown') == 'online' ? labels.online : (instance.query.status|default('unknown') == 'offline' ? labels.offline : labels.unknown) }}</dd></div>
<div><dt>Prozessstatus</dt><dd>{{ t('customer_instance_status_' ~ instance.display_status|default(instance.status),page_locale()) }}</dd></div>
<div><dt>Version</dt><dd data-query-version>{{ instance.current_version ?? instance.installed_version ?? '—' }}</dd></div><div><dt>Spieler</dt><dd data-query-players>{{ instance.query_players_online ?? '—' }} / {{ instance.query_players_max ?? '—' }}</dd></div><div><dt>Gebuchte Slots</dt><dd>{{ instance.max_slots }}</dd></div><div><dt>Spielerlimit</dt><dd>{{ instance.current_slots }}</dd></div><div><dt>RAM-Tarif</dt><dd>{{ instance.booked_ram_mb }} MiB</dd></div><div><dt>Node</dt><dd>{{ instance.node.name }}</dd></div><div><dt>Karte / Welt</dt><dd data-query-map>{{ instance.query.map|default('—') }}</dd></div><div><dt>Latenz</dt><dd data-query-latency>—</dd></div></dl><p class="pm-cell-sub" data-query-checked data-query-checked-label="Zuletzt geprüft">Zuletzt geprüft: {{ instance.query_checked_at ? instance.query_checked_at|date('d.m.Y H:i:s') : 'noch kein Messwert' }}</p><p class="pm-cell-sub">Live-Status und Ressourcen sind Messwerte. Fehlende Werte werden nicht als „Online“ dargestellt.</p>{% if instance.connection.quick_connect|default(null) %}<a class="ui-button" href="{{ instance.connection.quick_connect }}">Verbinden</a>{% endif %}</div></section>
