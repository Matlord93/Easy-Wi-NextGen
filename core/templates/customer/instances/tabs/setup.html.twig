{% set locale = page_locale() %}
{% if setupSourceVars|default([]) is not empty %}{% include 'customer/instances/_source_startup.html.twig' %}{% endif %}
{% if setupValheimVars|default([]) is not empty %}{% include 'customer/instances/_valheim_startup.html.twig' %}{% endif %}
<section class="gs-config" id="gameserver-configuration" data-native-startup="{{ setupValheimVars|default([]) is not empty ? 'true' : 'false' }}" data-url="{{ path('customer_game_configuration', {id: instance.id}) }}" data-csrf="{{ csrf_token('game-config-' ~ instance.id) }}">
    <header class="gs-config__head"><div><h2 data-config-title>Konfiguration</h2><p data-config-summary>Die vorhandenen Einstellungen werden direkt vom Gameserver gelesen.</p></div><button class="ui-button ui-button--primary" type="button" data-config-initialize hidden>Standardkonfiguration anlegen</button><button class="ui-button ui-button--ghost" type="button" data-config-reload>Neu analysieren</button></header>
    <div class="ng-alert ng-alert--info">Gespeicherte Änderungen werden beim nächsten Serverneustart wirksam. IP-Adresse, Ports und gebuchte {{ instance.max_slots }} Slots verwaltet das Panel. Das Spielerlimit darfst du innerhalb der gebuchten Slots ändern.</div>
    <p data-config-profile class="gs-config__description"></p>
    <p data-config-message role="status" aria-live="polite"></p>
    <div class="gs-config__layout">
        <aside class="gs-config__sidebar"><label class="form-label" for="game-config-search">Einstellungen suchen</label><input class="form-input" id="game-config-search" type="search" placeholder="Suchen …" data-config-search><h3>Kategorien</h3><nav data-config-categories aria-label="Konfigurationskategorien"></nav><h3>Dateien</h3><div data-config-files></div><a class="gs-config__file-link" href="{{ path('customer_instance_files', {id: instance.id}) }}">Weitere Dateien im Dateimanager</a></aside>
        <form class="gs-config__form" data-config-form>
            <div class="gs-config__toolbar"><h3 data-config-heading>Einstellungen</h3><span data-config-count></span></div>
            <section data-config-tags hidden></section>
            <section data-config-bans hidden></section>
            <div class="gs-config__fields" data-config-fields></div>
            <section class="gs-config__collections" data-config-lists hidden></section>
            <section class="gs-config__collections" data-config-roles hidden></section>
            <div class="gs-config__footer"><span data-config-dirty>Keine ungespeicherten Änderungen</span><button class="ui-button ui-button--primary" type="submit" data-config-save disabled>Änderungen speichern</button></div>
            <section class="gs-config__additions" data-config-available hidden aria-labelledby="game-config-available-heading">
                <h4 id="game-config-available-heading">Noch nicht in der Datei</h4>
                <p class="gs-config__description">Dokumentierte Einstellungen, die du bei Bedarf ergänzen kannst. Beim Speichern wird der gewählte Wert in die Datei geschrieben.</p>
                <div class="gs-config__fields" data-config-available-grid></div>
            </section>
        </form>
    </div>
    <noscript><div class="ng-alert ng-alert--warning">Für den einfachen Konfigurationseditor ist JavaScript erforderlich. Die Dateien bleiben über SFTP erreichbar.</div></noscript>
</section>
<details id="gameserver-startup-settings" class="cust-panel gs-config__advanced"{% if not setupStatus.is_ready or setupMessages.secrets or setupAdvancedVarsError|default(false) or (setupMessages.vars and setupValheimVars|default([]) is empty) %} open{% endif %}><summary>Spieleinstellungen und Startparameter</summary><div class="cust-panel__body">{% include 'customer/instances/_setup_credentials.html.twig' %}</div></details>
<script src="{{ asset('js/gameserver/configuration-collections.js') }}" defer></script>
<script src="{{ asset('js/gameserver/configuration-roles.js') }}" defer></script>
<script src="{{ asset('js/gameserver/configuration-app.js') }}" defer></script>
