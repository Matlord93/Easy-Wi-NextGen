{% extends 'customer/base.html.twig' %}

{% block head %}{{ parent() }}<link rel="stylesheet" href="{{ asset('gameserver-workspace.css') }}">{% endblock %}
{% block content %}
<div class="cust-page gs-workspace" data-gameserver-workspace>

    <header class="pm-page-head"><div><h1>{{ instance.server_name ?: instance.template.display_name ?: instance.template.name }}</h1><p>{{ instance.template.display_name ?? instance.template.name }} · {{ instance.node.name }} · #{{ instance.id }} {% if activeTab != 'overview' %}<span class="ui-badge ui-badge--{{ instance.status == 'running' ? 'success' : 'neutral' }}">{{ t('customer_instance_status_' ~ instance.status,page_locale()) }}</span>{% endif %}</p></div></header>
    <div class="cust-panel pm-instance-workspace">
        {% set groups = {overview:['overview'],console:['console'],files:['files'],configuration:['setup','settings','configs','addons'],backups:['backups'],administration:['tasks','restart_planner','reinstall']} %}
        {% set activeGroup = activeTab %}
        {% for group,keys in groups %}{% if activeTab in keys %}{% set activeGroup = group %}{% endif %}{% endfor %}
        <nav class="cust-tabs" aria-label="{{ 'navigation'|trans({},'panel_modules') }}">
        {% for group,keys in groups %}
            {% set members = tabs|filter(tab => tab.key in keys) %}
            {% if members is not empty %}{% set first = members|first %}<a href="{{ first.href }}" class="cust-tabs__item{% if activeGroup == group %} cust-tabs__item--active{% endif %}"{% if activeGroup == group %} aria-current="page"{% endif %}>{% if group == 'console' %}{{ first.label_is_key is defined and not first.label_is_key ? first.label : t(first.label,page_locale()) }}{% else %}{{ group|trans({},'panel_modules') }}{% endif %}</a>{% endif %}
        {% endfor %}
        {% for tab in tabs|filter(tab => tab.key not in ['overview','console','files','setup','settings','configs','addons','backups','tasks','restart_planner','reinstall']) %}<a class="cust-tabs__item{% if tab.key == activeTab %} cust-tabs__item--active{% endif %}" href="{{ tab.href }}">{{ tab.label_is_key is defined and not tab.label_is_key ? tab.label : t(tab.label,page_locale()) }}</a>{% endfor %}
        </nav>
        {% if activeGroup in ['configuration','administration'] %}<nav class="pm-subtabs" aria-label="{{ activeGroup|trans({},'panel_modules') }}" style="padding:16px 20px 0;">{% for tab in tabs|filter(tab => tab.key in groups[activeGroup]) %}<a href="{{ tab.href }}"{% if tab.key == activeTab %} aria-current="page"{% endif %}>{{ tab.label_is_key is defined and not tab.label_is_key ? tab.label : t(tab.label,page_locale()) }}</a>{% endfor %}</nav>{% endif %}

        <div class="cust-panel__body">
            {% for type, messages in app.flashes(['success', 'error']) %}
                {% for message in messages %}<div class="ng-alert ng-alert--{{ type == 'error' ? 'danger' : 'success' }}" role="{{ type == 'error' ? 'alert' : 'status' }}">{{ message }}</div>{% endfor %}
            {% endfor %}
            {% if tabNotice %}<div class="ng-alert ng-alert--success" role="status">{{ tabNotice }}</div>{% endif %}
            {% if tabError %}<div class="ng-alert ng-alert--danger" role="alert">{{ tabError }}</div>{% endif %}
            {% include tabTemplate %}
        </div>
    </div>

</div>
{% endblock %}
