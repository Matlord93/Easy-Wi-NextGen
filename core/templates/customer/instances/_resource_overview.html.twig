<div class="pm-stats pm-resource-stats">
    <div class="pm-stat"><div><span>CPU</span><strong>{{ instance.instance_cpu_percent is not null ? instance.instance_cpu_percent|number_format(1,',','.') ~ ' %' : '—' }}</strong><small class="pm-cell-sub">{{ instance.booked_cpu_cores }} {{ 'workspace_cpu_cores'|trans({},'panel_modules') }}</small></div></div>
    <div class="pm-stat"><div><span>RAM</span><strong>{{ instance.instance_mem_used_bytes is not null ? (instance.instance_mem_used_bytes / 1048576)|number_format(0,',','.') ~ ' MiB' : '—' }} <small>/ {{ instance.booked_ram_mb }} MiB</small></strong><meter class="pm-meter" min="0" max="100" value="{{ instance.instance_mem_percent ?? 0 }}" aria-label="RAM"></meter></div></div>
    <div class="pm-stat"><div><span>{{ 'workspace_storage'|trans({},'panel_modules') }}</span><strong>{{ instance.disk_used_human }} <small>/ {{ instance.disk_limit_human }}</small></strong><meter class="pm-meter" min="0" max="100" value="{{ min(100,max(0,instance.disk_percent)) }}" aria-label="Disk"></meter></div></div>
</div>
{% set history = usageHistory|default([])|filter(point => point.cpuPercent is not null or point.memUsedBytes is not null) %}
<section class="cust-panel"><div class="cust-panel__head"><h2 class="cust-panel__title">{{ 'workspace_usage'|trans({},'panel_modules') }}</h2><div class="pm-chart-legend"><span class="pm-legend-cpu">CPU</span><span class="pm-legend-ram">RAM</span></div></div><div class="cust-panel__body">
{% if history|length > 1 %}
    {% set scale = 100 %}{% for point in history %}{% set scale = max(scale,point.cpuPercent ?? 0,instance.booked_ram_mb > 0 and point.memUsedBytes is not null ? point.memUsedBytes / (instance.booked_ram_mb * 1048576) * 100 : 0) %}{% endfor %}{% set scale = (scale / 100)|round(0,'ceil') * 100 %}
    {% set first = history|first %}{% set last = history|last %}{% set duration = max(1,last.collectedAt.timestamp - first.collectedAt.timestamp) %}
    {% set cpu = [] %}{% set ram = [] %}
    {% for point in history %}{% set x = 36 + (point.collectedAt.timestamp - first.collectedAt.timestamp) / duration * 620 %}{% if point.cpuPercent is not null %}{% set cpu = cpu|merge([x ~ ',' ~ (152 - max(0,point.cpuPercent) / scale * 130)]) %}{% endif %}{% if point.memUsedBytes is not null and instance.booked_ram_mb > 0 %}{% set ram = ram|merge([x ~ ',' ~ (152 - min(scale,point.memUsedBytes / (instance.booked_ram_mb * 1048576) * 100) / scale * 130)]) %}{% endif %}{% endfor %}
    <svg class="pm-usage-chart" viewBox="0 0 680 182" role="img" aria-label="{{ 'workspace_usage'|trans({},'panel_modules') }}"><title>{{ 'workspace_usage'|trans({},'panel_modules') }}</title>{% for step in [0,1,2,3,4] %}<line x1="36" x2="656" y1="{{ 22 + step * 32.5 }}" y2="{{ 22 + step * 32.5 }}" class="pm-chart-grid"/><text x="0" y="{{ 26 + step * 32.5 }}">{{ scale - step * scale / 4 }}%</text>{% endfor %}{% if cpu is not empty %}<polyline points="{{ cpu|join(' ') }}" class="pm-chart-cpu"/>{% endif %}{% if ram is not empty %}<polyline points="{{ ram|join(' ') }}" class="pm-chart-ram"/>{% endif %}<text x="36" y="177">{{ first.collectedAt|date('H:i') }}</text><text x="620" y="177">{{ last.collectedAt|date('H:i') }}</text></svg>
{% else %}<div class="pm-chart-empty">{{ 'workspace_metrics_empty'|trans({},'panel_modules') }}</div>{% endif %}
<p class="pm-cell-sub">{{ 'workspace_metrics_window'|trans({},'panel_modules') }}{% if instance.instance_metrics_checked_at %} · {{ instance.instance_metrics_checked_at|date('H:i:s') }}{% endif %}</p>
</div></section>
