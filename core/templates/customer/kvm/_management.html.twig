{% trans_default_domain 'kvm' %}
{% import 'kvm/_customer_form.html.twig' as form %}
{% set stopped = guest and guest.state == 'shut off' %}
<section class="infra-pane infra-card" id="kvm-snapshots" data-infra-pane>
 <div class="infra-card__head"><h2>{{ 'kvm.snapshots'|trans }}</h2></div><p>{{ 'kvm.customer_stopped'|trans }}</p>
 {% if guest %}<div class="infra-operation-grid"><div>{{ form.start(assignment, operationId, 'snapshot.create') }}<label class="infra-span">{{ 'kvm.snapshot_name'|trans }}<input class="form-input" name="snapshot" pattern="[a-z][a-z0-9-]{0,47}" maxlength="48" required></label><button class="ui-button ui-button--primary" {% if not stopped or busy %}disabled{% endif %}>{{ 'kvm.action.snapshot.create'|trans }}</button></form></div>
 <div class="infra-table-wrap"><table class="infra-table"><tbody>{% for snapshot in guest.snapshots %}<tr><td><strong>{{ snapshot }}</strong></td><td>{% for action in ['snapshot.revert', 'snapshot.delete'] %}{{ form.start(assignment, operationId, action) }}<input type="hidden" name="snapshot" value="{{ snapshot }}"><label class="infra-span"><span><input type="checkbox" name="confirm" value="1" required> {{ (action == 'snapshot.revert' ? 'kvm.confirm_revert' : 'kvm.confirm_delete')|trans }}</span></label><button class="ui-button ui-button--ghost" {% if not stopped or busy %}disabled{% endif %}>{{ ('kvm.action.' ~ action)|trans }}</button></form>{% endfor %}</td></tr>{% else %}<tr><td>{{ 'kvm.customer_no_snapshots'|trans }}</td></tr>{% endfor %}</tbody></table></div></div>{% else %}<p>{{ 'kvm.customer_unavailable'|trans }}</p>{% endif %}
</section>
<section class="infra-pane infra-card" id="kvm-backups" data-infra-pane>
 <div class="infra-card__head"><h2>{{ 'kvm.backups'|trans }}</h2></div><p>{{ 'kvm.restore_hint'|trans }}</p><p>{{ 'kvm.customer_stopped'|trans }}</p>
 {% if guest %}<div class="infra-operation-grid"><div>{{ form.start(assignment, operationId, 'backup.create') }}<button class="ui-button ui-button--primary" {% if not stopped or busy %}disabled{% endif %}>{{ 'kvm.action.backup.create'|trans }}</button></form></div>
 <div class="infra-table-wrap"><table class="infra-table"><tbody>{% for backup in guest.backups %}<tr><td>{{ backup.created_at ? backup.created_at|date('d.m.Y H:i', 'Europe/Berlin') : '—' }}<small>{{ backup.size is not null ? (backup.size / 1048576)|number_format(1) ~ ' MiB' : '—' }}</small></td><td>{% for action in ['backup.restore', 'backup.delete'] %}{{ form.start(assignment, operationId, action) }}<input type="hidden" name="backup_id" value="{{ backup.id }}"><label class="infra-span"><span><input type="checkbox" name="confirm" value="1" required> {{ (action == 'backup.restore' ? 'kvm.confirm_restore' : 'kvm.confirm_delete')|trans }}</span></label><button class="ui-button ui-button--ghost" {% if not stopped or busy or (action == 'backup.restore' and guest.snapshots is not empty) %}disabled{% endif %}>{{ ('kvm.action.' ~ action)|trans }}</button></form>{% endfor %}</td></tr>{% else %}<tr><td>{{ 'kvm.customer_no_backups'|trans }}</td></tr>{% endfor %}</tbody></table></div></div>{% else %}<p>{{ 'kvm.customer_unavailable'|trans }}</p>{% endif %}
</section>
<section class="infra-pane infra-card" id="kvm-activity" data-infra-pane>
 <div class="infra-card__head"><h2>{{ 'kvm.jobs'|trans }}</h2><button type="button" class="ui-button ui-button--primary" data-kvm-refresh-ready hidden>{{ 'kvm.refresh'|trans }}</button></div>
 <div class="infra-table-wrap"><table class="infra-table"><thead><tr><th>{{ 'kvm.time'|trans }}</th><th>{{ 'kvm.action'|trans }}</th><th>{{ 'kvm.status'|trans }}</th></tr></thead><tbody>{% for job in jobs %}<tr {% if job.status in ['queued', 'running'] %}data-kvm-job="{{ path('customer_kvm_job', {id: assignment.id, jobId: job.id}) }}"{% endif %}><td>{{ job.created_at|date('d.m.Y H:i', 'Europe/Berlin') }}</td><td>{{ ('kvm.action.' ~ job.action)|trans }}</td><td>{{ ('kvm.status.' ~ job.status)|trans }}</td></tr>{% else %}<tr><td colspan="3">{{ 'kvm.no_jobs'|trans }}</td></tr>{% endfor %}</tbody></table></div><p data-kvm-poll-error hidden>{{ 'kvm.poll_error'|trans }}</p>
</section>
