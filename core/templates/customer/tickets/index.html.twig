{% extends 'customer/base.html.twig' %}
{% set activeNav = 'tickets' %}
{% set locale = page_locale() %}
{% block title %}{{ t('customer_tickets_title', locale) }}{% endblock %}

{% set statusLabels = {
    'open':     t('customer_tickets_status_open', locale),
    'pending':  t('customer_tickets_status_pending', locale),
    'resolved': t('customer_tickets_status_resolved', locale),
    'closed':   t('customer_tickets_status_closed', locale),
} %}
{% set priorityLabels = {
    'low':    t('customer_tickets_priority_low', locale),
    'normal': t('customer_tickets_priority_normal', locale),
    'high':   t('customer_tickets_priority_high', locale),
    'urgent': t('customer_tickets_priority_urgent', locale),
} %}

{% block content %}
<div class="pm-workspace" data-panel-tabs="customer-tickets">
    <header class="pm-page-head"><div><h1>{{ t('customer_tickets_title',locale) }}</h1><p>{{ t('customer_tickets_modern_intro',locale) }}</p></div><div class="pm-page-head__actions"><button class="ui-button ui-button--ghost" type="button" hx-get="/tickets/table" hx-include="#customer-ticket-filters" hx-target="#tickets-table" hx-swap="outerHTML">{{ t('refresh',locale) }}</button><a class="ui-button ui-button--primary" href="#pm-customer-tickets-create">+ {{ t('customer_ticket_new_title',locale) }}</a></div></header>
    {% include 'components/panel/_tabs.html.twig' with {panelKey:'customer-tickets',panelTabs:{overview:'workspace_inventory',create:'create'}} %}
    <div class="pm-stats pm-stats--four">{% for label,value in {customer_tickets_total:summary.total,customer_tickets_open:summary.open,customer_tickets_pending:summary.pending,customer_tickets_resolved:summary.resolved} %}{% include 'components/panel/_stat.html.twig' with {value:value,label:t(label,locale)} only %}{% endfor %}</div>
        {# ── Ticket list ── #}
        <div class="ng-card" style="overflow:hidden;" data-panel-section="overview">
            <div class="tkt-filter-bar">
                <div class="tkt-filter-bar__top">
                    <div>
                        <h2 class="tkt-filter-bar__title">{{ t('customer_tickets_list_title', locale) }}</h2>
                        <p class="tkt-filter-bar__sub">{{ t('customer_tickets_list_modern_intro', locale) }}</p>
                    </div>
                    <a href="#pm-customer-tickets-create" class="ui-button ui-button--primary ui-button--sm">
                        + {{ t('ticket_ui_create_new_ticket', locale) }}
                    </a>
                </div>
                <form id="customer-ticket-filters" method="get" action="/tickets"
                    style="display:grid;grid-template-columns:minmax(0,1fr) 160px auto;gap:8px;">
                    <input name="q" value="{{ filters.q|default('') }}"
                        placeholder="{{ t('ticket_ui_customer_search_placeholder', locale) }}">
                    <select name="status">
                        <option value="">{{ t('ticket_ui_all_statuses', locale) }}</option>
                        {% for value, label in statusLabels %}
                        <option value="{{ value }}" {{ filters.status|default('') == value ? 'selected' : '' }}>{{ label }}</option>
                        {% endfor %}
                    </select>
                    <button type="submit" class="ui-button ui-button--ghost ui-button--sm">{{ t('ticket_ui_filter', locale) }}</button>
                </form>
            </div>
            {% include 'customer/tickets/_table.html.twig' with {
                tickets: tickets,
                statusStyles: statusStyles,
                priorityStyles: priorityStyles,
                statusLabels: statusLabels,
                priorityLabels: priorityLabels,
            } %}
        </div>

    <section data-panel-section="create">{% include 'customer/tickets/_form.html.twig' with {form:form,locale:locale} %}</section>
</div>
{% endblock %}
