{% extends 'customer/base.html.twig' %}
{% set activeNav = 'notifications' %}
{% set locale = page_locale() %}
{% set unreadCount = notifications|filter(n => not n.read_at)|length %}
{% block content %}
<div class="pm-workspace" data-notifications>
<header class="pm-page-head"><div><h1>{{ t('notifications',locale) }}</h1><p>{{ t('customer_notifications_intro',locale) }}</p></div><form method="post" action="{{ path('customer_notifications_read_all') }}"><button type="submit" class="ui-button ui-button--ghost">{{ t('admin_notifications_mark_all_read',locale) }}</button></form></header>
<div class="pm-stats">
<div data-notification-count="total">{% include 'components/panel/_stat.html.twig' with {value:notifications|length,label:'workspace_loaded_entries'|trans({},'panel_modules')} only %}</div>
<div data-notification-count="unread">{% include 'components/panel/_stat.html.twig' with {value:unreadCount,label:t('unread',locale)} only %}</div>
<div data-notification-count="read">{% include 'components/panel/_stat.html.twig' with {value:notifications|length - unreadCount,label:t('read',locale)} only %}</div>
</div>
<div class="ng-data-card">
<div class="pm-filters"><input class="form-input" type="search" data-notification-search aria-label="{{ 'workspace_notification_search'|trans({},'panel_modules') }}" placeholder="{{ 'workspace_notification_search'|trans({},'panel_modules') }}"><select class="form-input" data-notification-filter aria-label="{{ t('status',locale) }}"><option value="">{{ 'workspace_all_messages'|trans({},'panel_modules') }}</option><option value="unread">{{ t('unread',locale) }}</option><option value="read">{{ t('read',locale) }}</option></select></div>
<p class="pm-list-scope">{{ 'workspace_notification_scope'|trans({},'panel_modules') }}</p>
{% for notification in notifications %}{% include 'customer/notifications/_item.html.twig' with {notification:notification} %}{% endfor %}
<p class="pm-empty" data-notification-empty{% if notifications is not empty %} hidden{% endif %}>{{ t('no_results',locale) }}</p>
</div>
</div>
<script src="{{ asset('js/panel-notifications.js') }}" defer></script>
{% endblock %}
