{% extends 'customer/base.html.twig' %}
{% set activeNav = 'domains' %}
{% set locale = page_locale() %}
{% block title %}{{ t('customer_domains_title',locale) }}{% endblock %}
{% block content %}
{% set submittedCreate = app.request and app.request.isMethod('POST') %}
<div class="pm-workspace" data-panel-tabs="domains"{% if submittedCreate and errors is not empty %} data-panel-active="create"{% endif %}>
    <header class="pm-page-head"><div><h1>{{ t('customer_domains_title',locale) }}</h1><p>{{ t('customer_domains_description',locale) }}</p></div><a class="ui-button ui-button--primary" href="#pm-domains-create">+ {{ t('customer_domains_create_action',locale) }}</a></header>
    {% include 'components/panel/_tabs.html.twig' with {panelKey:'domains',panelTabs:{overview:'workspace_inventory',create:'create'}} %}
    <div class="pm-stats">
        {% include 'components/panel/_stat.html.twig' with {value:domains|length,label:t('customer_domains_overview',locale)} only %}
        {% include 'components/panel/_stat.html.twig' with {value:domains|filter(domain => domain.status == 'active')|length,label:'workspace_active'|trans({},'panel_modules')} only %}
        {% include 'components/panel/_stat.html.twig' with {value:domains|filter(domain => domain.status == 'pending')|length,label:'workspace_pending'|trans({},'panel_modules')} only %}
    </div>
    {% if errors is not empty %}<div class="ng-alert ng-alert--danger"><ul>{% for error in errors %}<li>{{ error }}</li>{% endfor %}</ul></div>{% endif %}
    <section class="cust-panel" data-panel-section="overview" data-panel-list>
        <div class="pm-filters"><label class="sr-only" for="domain-search">{{ 'search'|trans({},'panel_modules') }}</label><input class="form-input" id="domain-search" type="search" data-panel-filter placeholder="{{ 'workspace_domain_search'|trans({},'panel_modules') }}"></div>
        <div class="infra-table-wrap"><table class="cust-table">
            <thead><tr><th>{{ t('customer_domains_table_domain',locale) }}</th><th>{{ t('customer_domains_table_webspace',locale) }}</th><th>{{ t('customer_domains_table_status',locale) }}</th><th>{{ t('customer_domains_table_ssl',locale) }}</th><th>{{ t('customer_domains_table_updated',locale) }}</th></tr></thead>
            <tbody>{% for domain in domains %}<tr data-panel-row>
                <td><strong>{{ domain.name }}</strong><small class="pm-cell-sub">#{{ domain.id }}</small></td>
                <td>{% if domain.webspace %}<a href="{{ path('customer_webspace_manage',{domain_id:domain.id}) }}">{{ domain.webspace }}</a>{% else %}—{% endif %}</td>
                <td><span class="ui-badge ui-badge--{{ domain.status == 'active' ? 'success' : (domain.status == 'pending' ? 'warning' : 'neutral') }}">{{ domain.status|replace({'_':' '})|title }}</span></td>
                <td>{{ domain.ssl_expires_at ? domain.ssl_expires_at|date('Y-m-d') : '—' }}</td><td>{{ domain.updated_at|date('Y-m-d H:i') }}</td>
            </tr>{% else %}<tr><td colspan="5" class="cust-table__empty">{{ t('customer_domains_empty',locale) }}</td></tr>{% endfor %}</tbody>
        </table></div>
    </section>
        <section id="domain-form" data-panel-section="create">
            <div class="ng-card">
                <div style="padding:14px 16px;border-bottom:1px solid var(--ng-border);">
                    <div style="font-size:0.9375rem;font-weight:700;color:var(--ng-text);">{{ t('customer_domains_create_title', locale) }}</div>
                    <div style="font-size:0.8125rem;color:var(--ng-text-muted);margin-top:2px;">{{ t('customer_domains_create_description', locale) }}</div>
                </div>
                <div style="padding:16px;">
                    <form method="post" action="/domains" style="display:flex;flex-direction:column;gap:14px;">
                        <div class="form-field">
                            <label class="form-label">{{ t('customer_domains_webspace_label', locale) }}</label>
                            <select name="webspace_id" class="form-input" required>
                                <option value="">{{ t('customer_domains_webspace_placeholder', locale) }}</option>
                                {% for webspace in webspaces %}
                                    <option value="{{ webspace.id }}"{% if submittedCreate and app.request.request.get('webspace_id') == webspace.id %} selected{% endif %}>{{ webspace.domain }}</option>
                                {% endfor %}
                            </select>
                        </div>
                        <div class="form-field">
                            <label class="form-label">{{ t('customer_domains_domain_label', locale) }}</label>
                            <input type="text" name="domain" value="{{ submittedCreate ? app.request.request.get('domain','') : '' }}" class="form-input" placeholder="{{ t('customer_domains_domain_placeholder', locale) }}" required>
                            <p style="margin:4px 0 0;font-size:0.75rem;color:var(--ng-text-muted);">{{ t('customer_domains_domain_hint', locale) }}</p>
                        </div>
                        <button type="submit" class="ui-button ui-button--primary" style="width:100%;">
                            {{ t('customer_domains_create_action', locale) }}
                        </button>
                    </form>
                </div>
            </div>
        </section>
</div>
{% endblock %}
