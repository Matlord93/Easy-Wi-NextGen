{% set locale = page_locale() %}
{% set login_url = path('public_login', checkout_target ? {target: checkout_target} : {}) %}
{% if registered %}
    <p class="ng-alert ng-alert--success" role="status">{{ t('registration_success', locale) }}</p>
    <a href="{{ login_url }}">{{ t('log_in', locale) }}</a>
{% elseif not registrationAllowed %}
    <p class="ng-alert" role="status">{{ t(registration_disabled_reason, locale) }}</p>
    <a href="{{ login_url }}">{{ t('log_in', locale) }}</a>
{% else %}
    {% if checkout_target %}<p>{{ t('registration_checkout_intro', locale) }}</p>
    {% elseif customer_registration %}
        <nav class="portal-registration-options" aria-label="{{ t('create_account', locale) }}">
            <a href="{{ path('public_register', {account: 'customer'}) }}"{% if customer_account %} aria-current="page"{% endif %}>{{ t('registration_customer_account', locale) }}</a>
            <a href="{{ path('public_register', {account: 'member'}) }}"{% if not customer_account %} aria-current="page"{% endif %}>{{ t('registration_member_account', locale) }}</a>
        </nav>
    {% endif %}
    {% if errors %}
        <ul class="ng-alert ng-alert--danger" role="alert">
            {% for error in errors %}<li>{{ t(error, locale) }}</li>{% endfor %}
        </ul>
    {% endif %}
    <form method="post" action="{{ path('public_register') }}" class="portal-registration-form ng-auth-form"
          {% if pow_difficulty > 0 %}data-registration-pow="{{ pow_difficulty }}" data-registration-nonce="{{ anti_abuse_nonce }}"{% endif %}>
        <input type="hidden" name="_token" value="{{ csrf_token('public_register') }}">
        <input type="hidden" name="account" value="{{ customer_account ? 'customer' : 'member' }}">
        {% if checkout_target %}<input type="hidden" name="target" value="{{ checkout_target }}">{% endif %}
        <div hidden aria-hidden="true"><input type="text" name="website" tabindex="-1" autocomplete="off"></div>
        <input type="hidden" name="pow_solution" value="">
        <label>{{ t('email_address', locale) }}
            <input class="form-input ng-input" name="email" type="email" value="{{ form.email }}" maxlength="180" autocomplete="email" required>
        </label>
        <label>{{ t('password', locale) }}
            <input class="form-input ng-input" name="password" type="password" minlength="8" maxlength="72" autocomplete="new-password" required>
        </label>
        <label>{{ t('confirm_password', locale) }}
            <input class="form-input ng-input" name="password_confirm" type="password" minlength="8" maxlength="72" autocomplete="new-password" required>
        </label>
        {% if customer_account %}{% include 'public/auth/_billing_fields.html.twig' %}{% endif %}
        {% if captcha_question %}
            <label>{{ captcha_question }}
                <input class="form-input ng-input" name="captcha_answer" inputmode="numeric" autocomplete="off" required>
            </label>
        {% endif %}
        <label class="portal-consent"><input name="consents" type="checkbox" value="1" required{% if form.consents %} checked{% endif %}> {{ t('registration_consents', locale) }}</label>
        {% if pow_difficulty > 0 %}
            <p role="status" data-registration-status data-failure="{{ t('registration_security_check', locale) }}" data-unavailable="{{ t('registration_security_browser', locale) }}">{{ t('registration_security_working', locale) }}</p>
            <noscript><p>{{ t('registration_security_javascript', locale) }}</p></noscript>
        {% endif %}
        <button class="ui-button ui-button--primary ng-btn ng-btn--primary" type="submit">{{ t('create_account', locale) }}</button>
    </form>
    {% if pow_difficulty > 0 %}<script src="{{ asset('js/registration-challenge.js') }}" defer></script>{% endif %}
    <p><a href="{{ login_url }}">{{ t('log_in', locale) }}</a></p>
{% endif %}
