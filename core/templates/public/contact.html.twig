{% extends 'themes/' ~ (active_theme|default(active_theme())) ~ '/base.html.twig' %}
{% set locale = page_locale() %}

{% block title %}{{ t('contact_title', page_locale()) }} · {{ app_setting('site_title', 'Easy-Wi NextGen') }}{% endblock %}

{% block content %}
<div class="ng-page-hero">
    <div class="ng-container">
        <nav class="ng-breadcrumb">
            <a href="/">{{ t('common_home', page_locale()) }}</a>
            <span>{{ t('contact_title', page_locale()) }}</span>
        </nav>
        <h1 class="text-3xl font-bold ng-gradient-text">{{ t('contact_title', page_locale()) }}</h1>
        <p class="mt-2 text-sm text-slate-400">{{ t('contact_subtitle', page_locale()) }}</p>
    </div>
</div>

<div class="ng-container ng-section">
    <div class="mx-auto max-w-xl">
        {% if success %}
            <div class="mb-6 rounded-lg border border-green-500/30 bg-green-500/10 px-4 py-3 text-sm text-green-400" role="status">
                {{ t('contact_success', page_locale()) }}
            </div>
        {% endif %}
        {% if errors is not empty %}
            <div class="mb-6 rounded-lg border border-rose-500/30 bg-rose-500/10 px-4 py-3 text-sm text-rose-400" role="alert">
                {% for error in errors %}<p>{{ t(error, page_locale()) }}</p>{% endfor %}
            </div>
        {% endif %}

        <div class="rounded-xl border border-slate-800 bg-slate-900/60 p-6">
            <form method="post" action="{{ path('public_contact') }}" class="space-y-4"
                  {% if protection.pow_difficulty > 0 %}data-form-pow="{{ protection.pow_difficulty }}" data-form-nonce="{{ protection.nonce }}"{% endif %}>
                <div>
                    <label class="mb-1 block text-sm font-medium text-slate-400">{{ t('common_name', page_locale()) }}</label>
                    <input name="name" placeholder="{{ t('contact_name_placeholder', page_locale()) }}" class="ng-input w-full" value="{{ form.name|default('') }}" maxlength="140" required>
                </div>
                <div>
                    <label class="mb-1 block text-sm font-medium text-slate-400">{{ t('contact_email_label', page_locale()) }}</label>
                    <input name="email" type="email" placeholder="{{ t('contact_email_placeholder', page_locale()) }}" class="ng-input w-full" value="{{ form.email|default('') }}" maxlength="180" required>
                </div>
                <div>
                    <label class="mb-1 block text-sm font-medium text-slate-400">{{ t('contact_subject_label', page_locale()) }}</label>
                    <input name="subject" placeholder="{{ t('contact_subject_label', page_locale()) }}" class="ng-input w-full" value="{{ form.subject|default('') }}" maxlength="140" required>
                </div>
                <div>
                    <label class="mb-1 block text-sm font-medium text-slate-400">{{ t('contact_message_label', page_locale()) }}</label>
                    <textarea name="message" rows="6" class="ng-input w-full" maxlength="5000" required>{{ form.message|default('') }}</textarea>
                </div>
                {% include 'public/_contact_challenge.html.twig' with {
                    form_key: 'public_contact', label_class: 'mb-1 block text-sm font-medium text-slate-400', input_class: 'ng-input w-full'
                } %}
                <button type="submit" class="ng-btn" {{ protection.pow_difficulty > 0 ? 'disabled' : '' }}>{{ t('contact_submit', page_locale()) }}</button>
            </form>
        </div>
    </div>
</div>
{% endblock %}
