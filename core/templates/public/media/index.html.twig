{% extends 'themes/' ~ (active_theme|default('minimal')) ~ '/base.html.twig' %}

{% block title %}{{ 'nav_media'|cms_trans({}) }} · {{ app_setting('site_title', 'Easy-Wi NextGen') }}{% endblock %}

{% block head %}{{ parent() }}<link rel="stylesheet" href="{{ asset('cms-media-gallery.css') }}">{% endblock %}

{% block content %}
{% include 'themes/site/_page_heading.html.twig' with {heading:'nav_media'|cms_trans, intro:'media_intro'|cms_trans} %}

<div class="ng-container ng-section cms-media-gallery">
    <form action="{{ path('public_cms_media_index') }}" method="get" class="cms-media-search" role="search">
        <input type="hidden" name="lang" value="{{ app.request.locale }}">
        <div>
            <label for="cms-media-search">{{ 'media_search'|cms_trans({}) }}</label>
            <input type="search" id="cms-media-search" name="q" value="{{ search }}" maxlength="100" placeholder="{{ 'media_search_placeholder'|cms_trans({}) }}">
        </div>
        <button type="submit">{{ 'media_search_action'|cms_trans({}) }}</button>
        {% if search != '' %}<a href="{{ path('public_cms_media_index', {lang: app.request.locale}) }}">{{ 'media_reset'|cms_trans({}) }}</a>{% endif %}
    </form>
    <div class="cms-media-grid">
        {% for asset in assets %}
            <figure class="cms-media-card" data-media-id="{{ asset.id }}">
                <div class="cms-media-picture">
                    {% if asset.original %}<a href="{{ asset.original }}" target="_blank" rel="noopener noreferrer" aria-label="{{ 'media_open_original'|cms_trans({}) }}: {{ asset.title ?? asset.alt }}">{% endif %}
                    {% if asset.preview %}
                        <img src="{{ asset.raster ? path('public_cms_media_thumbnail', {id: asset.id}) : asset.preview }}" alt="{{ asset.alt }}" loading="lazy" decoding="async" width="400" height="240">
                    {% else %}
                        <span class="cms-media-placeholder"><svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>{{ 'media_unavailable'|cms_trans({}) }}</span>
                    {% endif %}
                    {% if asset.original %}</a>{% endif %}
                </div>
                {% if asset.title is not null and asset.title is not same as('') %}<figcaption>{{ asset.title }}</figcaption>{% endif %}
            </figure>
        {% else %}
            <div class="ng-empty-state cms-media-empty" role="status">
                <p>{{ (search != '' ? 'media_no_results' : 'media_empty')|cms_trans({}) }}</p>
            </div>
        {% endfor %}
    </div>
    {% if current_page > 1 or has_next %}
        <nav class="cms-media-pagination" aria-label="{{ 'media_pagination'|cms_trans({}) }}">
            {% if current_page > 1 %}<a rel="prev" href="{{ path('public_cms_media_index', {page: current_page - 1, q: search, lang: app.request.locale}) }}">{{ 'media_previous'|cms_trans({}) }}</a>{% endif %}
            <span aria-current="page">{{ 'media_page'|cms_trans({'%page%': current_page}) }}</span>
            {% if has_next and current_page < page_limit %}<a rel="next" href="{{ path('public_cms_media_index', {page: current_page + 1, q: search, lang: app.request.locale}) }}">{{ 'media_next'|cms_trans({}) }}</a>{% endif %}
        </nav>
    {% endif %}
</div>
{% endblock %}
