{% trans_default_domain 'infrastructure' %}
<details class="infra-history"><summary>{{ 'infra.history_title'|trans }}</summary><p class="infra-observed">{{ 'infra.history_hint'|trans }}</p><p class="infra-observed" data-history-status></p>
<div class="infra-export-controls"><label>{{ 'infra.export_range'|trans }}<select class="form-input" data-history-export-range><option value="current">{{ 'infra.export_current'|trans }}</option><option value="5">{{ 'infra.export_5'|trans }}</option><option value="20" selected>{{ 'infra.export_20'|trans }}</option></select></label><button type="button" class="ui-button ui-button--ghost" data-history-export disabled>{{ 'infra.export_csv'|trans }}</button></div><p class="infra-observed">{{ 'infra.export_hint'|trans }}</p><p class="infra-observed" data-history-export-status role="status" aria-live="polite" hidden></p>
{% for kind, title in (withIo|default(false) ? {load:'infra.history_load',network:'infra.history_network',disk:'infra.history_disk'} : {load:'infra.history_load'}) %}
<figure data-history-chart="{{ kind }}"><figcaption>{{ title|trans }}</figcaption><div class="infra-history-plot"></div><small data-history-scale></small><div class="infra-history-legend">{% for label in (kind == 'load' ? ['infra.cpu','infra.ram'] : (kind == 'network' ? ['infra.net_rx','infra.net_tx'] : ['infra.disk_read','infra.disk_write'])) %}<span class="infra-history-color-{{ loop.index }}">{{ label|trans }}</span>{% endfor %}</div></figure>
{% endfor %}</details>
<script type="application/json" data-history-labels>{{ {waiting:'infra.history_waiting'|trans,interrupted:'infra.history_interrupted'|trans,points:'infra.history_points'|trans,export_success:'infra.export_success'|trans,export_empty:'infra.export_empty'|trans,export_failed:'infra.export_failed'|trans}|json_encode(constant('JSON_HEX_TAG') b-or constant('JSON_HEX_AMP') b-or constant('JSON_HEX_APOS') b-or constant('JSON_HEX_QUOT'))|raw }}</script>
