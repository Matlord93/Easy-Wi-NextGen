{% extends 'layouts/base.html.twig' %}
{% block theme_bootstrap %}<script src="{{ asset('js/panel-theme.js') }}"></script>{% endblock %}
{% block head %}
<link rel="stylesheet" href="{{ asset('panel-modules.css') }}">
<script src="{{ asset('js/panel-modules.js') }}" defer></script>
{% endblock %}
{% block body_class %}reseller-interface ng-shell panel-modules{% endblock %}
{% block body %}
{% set activeNav = activeNav|default('customers') %}
{% set actor = current_user() %}
{% set profile = actor ? {name:actor.name ?: actor.email,email:actor.email,initial:(actor.name ?: actor.email)|slice(0,1)|upper} : null %}
<div class="ng-layout">
    {% include 'components/_sidebar.html.twig' with {title:brandingName,logoUrl:brandingLogo ?: null,activeNav:activeNav,groups:[{label:t('reseller_nav_group_management',page_locale()),open:true,items:[{key:'customers',label:t('reseller_nav_customers',page_locale()),href:path('reseller_customers'),iconSvg:'<svg viewBox="0 0 16 16" fill="currentColor"><path d="M8 8a3 3 0 1 0 0-6 3 3 0 0 0 0 6zm-6 6a6 6 0 0 1 12 0H2z"/></svg>'}]}],footer:''} %}
    <div class="ng-sidebar-backdrop" data-sidebar-backdrop></div>
    <main class="ng-main" id="main-content">
        {% include 'components/_topbar.html.twig' with {title:pageTitle|default(t('reseller_nav_customers',page_locale())),subtitle:pageSubtitle|default(''),profile:profile,actions:[{label:t('customer_portal',page_locale()),href:path('customer_dashboard'),variant:'secondary'}]} %}
        <div class="ng-content">{% block content %}{% endblock %}</div>
    </main>
</div>
{% endblock %}
