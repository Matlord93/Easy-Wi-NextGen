{% extends 'reseller/base.html.twig' %}
{% block content %}
<div class="cust-page" data-panel-tabs="reseller-customers">
    <header class="pm-edit-header"><div><h1>{{ 'reseller_customers'|trans({},'panel_modules') }}</h1><p>{{ 'reseller_scope'|trans({},'panel_modules') }}</p></div><span class="ui-badge">{{ customers|length }}</span></header>
    {% if errors is defined and errors is not empty %}<div class="cust-alert cust-alert--error" role="alert"><ul>{% for error in errors %}<li>{{ t(error,page_locale()) }}</li>{% endfor %}</ul></div>{% endif %}
    {% include 'components/panel/_tabs.html.twig' with {panelKey:'reseller-customers',panelTabs:{overview:'overview',create:'create'}} %}
    <section class="cust-panel" data-panel-section="overview" data-panel-list><div class="cust-panel__body"><div class="pm-toolbar"><label for="reseller-filter">{{ 'search'|trans({},'panel_modules') }}</label><input id="reseller-filter" class="form-input" type="search" data-panel-filter></div><div class="infra-table-wrap"><table class="cust-table"><thead><tr><th>{{ 'customer'|trans({},'panel_modules') }}</th><th>{{ t('reseller_customers_created_col',page_locale()) }}</th></tr></thead><tbody>{% for customer in customers %}<tr data-panel-row><td><strong>{{ customer.email }}</strong><br><small>#{{ customer.id }}</small></td><td>{{ customer.createdAt|date('d.m.Y H:i') }}</td></tr>{% else %}<tr><td colspan="2">{{ 'empty'|trans({},'panel_modules') }}</td></tr>{% endfor %}</tbody></table></div></div></section>
    <section class="cust-panel" data-panel-section="create"><div class="cust-panel__head"><h2 class="cust-panel__title">{{ 'reseller_create'|trans({},'panel_modules') }}</h2></div><div class="cust-panel__body"><form method="post" action="{{ path('reseller_customers') }}" class="pm-form"><label>{{ 'email'|trans({},'panel_modules') }}<input class="form-input" type="email" name="email" value="{{ form.email }}" required autocomplete="off"></label><label>{{ 'temporary_password'|trans({},'panel_modules') }}<input class="form-input" type="password" name="password" required autocomplete="new-password"></label><button class="ui-button ui-button--primary" type="submit">{{ t('reseller_create_customer_btn',page_locale()) }}</button></form></div></section>
</div>
{% endblock %}
