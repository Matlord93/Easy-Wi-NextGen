<div class="cust-ws-table-wrap" data-invoice-items><table class="cust-table"><thead><tr><th>{{ 'billing.description'|trans({}, 'billing') }}</th><th>{{ 'billing.quantity'|trans({}, 'billing') }}</th><th>{{ 'billing.unit_price'|trans({}, 'billing') }}</th><th>{{ 'billing.tax_rate'|trans({}, 'billing') }}</th><th>{{ 'billing.line_total'|trans({}, 'billing') }}</th></tr></thead><tbody>
{% for row in invoice.items %}<tr><td style="white-space:pre-wrap;overflow-wrap:anywhere;">{{ row.description }}</td><td>{{ (row.quantity_milli / 1000)|number_format(3, page_locale() == 'de' ? ',' : '.', '') }}</td><td>{{ (row.unit_price_cents / 100)|number_format(2, page_locale() == 'de' ? ',' : '.', '') }} {{ invoice.currency }}</td><td>{{ (row.tax_rate_bps / 100)|number_format(2, page_locale() == 'de' ? ',' : '.', '') }} %</td><td>{{ (row.gross_cents / 100)|number_format(2, page_locale() == 'de' ? ',' : '.', '') }} {{ invoice.currency }}</td></tr>{% endfor %}
</tbody></table></div>
