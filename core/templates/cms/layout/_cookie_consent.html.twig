<link rel="stylesheet" href="{{ asset('cookie-consent.css') }}">
<section id="cookie-banner" class="ew-cookie ew-cookie-banner" aria-labelledby="cookie-banner-title" data-cookie-name="{{ cookie_consent_cookie_name() }}" data-cookie-version="{{ cookie_consent_version() }}" hidden>
    <h2 id="cookie-banner-title">{{ t('cookie_banner_title', page_locale()) }}</h2>
    <p>{{ t('cookie_banner_description', page_locale()) }} <button type="button" class="ew-cookie-link" data-cookie-policy>{{ t('cookie_policy', page_locale()) }}</button></p>
    <div class="ew-cookie-actions">
        <button type="button" data-cookie-reject>{{ t('cookie_reject_optional', page_locale()) }}</button>
        <button type="button" data-cookie-settings>{{ t('cookie_settings', page_locale()) }}</button>
        <button type="button" class="ew-cookie-primary" data-cookie-accept>{{ t('cookie_accept_all', page_locale()) }}</button>
    </div>
</section>
<dialog id="cookie-settings-modal" class="ew-cookie ew-cookie-dialog" aria-labelledby="cookie-dialog-title">
    <header class="ew-cookie-header"><div><h2 id="cookie-dialog-title">{{ t('cookie_settings_title', page_locale()) }}</h2><p>{{ t('cookie_settings_description', page_locale()) }}</p></div><button type="button" data-cookie-close aria-label="{{ t('cookie_settings_close', page_locale()) }}">×</button></header>
    <nav class="ew-cookie-tabs" role="tablist" aria-label="{{ t('cookie_settings_title', page_locale()) }}">
        <button type="button" id="cookie-settings-tab" role="tab" data-cookie-tab="settings" aria-controls="cookie-settings-content" aria-selected="true">{{ t('cookie_settings', page_locale()) }}</button>
        <button type="button" id="cookie-policy-tab" role="tab" data-cookie-tab="policy" aria-controls="cookie-policy-content" aria-selected="false" tabindex="-1">{{ t('cookie_policy', page_locale()) }}</button>
    </nav>
    <div class="ew-cookie-content">
        <section id="cookie-settings-content" role="tabpanel" aria-labelledby="cookie-settings-tab" data-cookie-pane="settings">
            <div class="ew-cookie-category"><div><h3>{{ t('cookie_category_necessary_title', page_locale()) }}</h3><p>{{ t('cookie_category_necessary_description', page_locale()) }}</p></div><input type="checkbox" checked disabled aria-label="{{ t('cookie_category_necessary_title', page_locale()) }}"></div>
            <label class="ew-cookie-category"><span><strong>{{ t('common_statistics', page_locale()) }}</strong><span>{{ 'cookie_statistics_description'|cms_trans({}) }}</span></span><input type="checkbox" data-cookie-toggle="statistics"></label>
            <label class="ew-cookie-category"><span><strong>{{ t('common_marketing', page_locale()) }}</strong><span>{{ 'cookie_marketing_description'|cms_trans({}) }}</span></span><input type="checkbox" data-cookie-toggle="marketing"></label>
        </section>
        <section id="cookie-policy-content" role="tabpanel" aria-labelledby="cookie-policy-tab" data-cookie-pane="policy" hidden>
            <h3>{{ t('cookie_policy', page_locale()) }}</h3><p>{{ 'cookie_policy_description'|cms_trans({}) }}</p>
            <div class="ew-cookie-table"><table><thead><tr><th>{{ t('common_name',page_locale()) }}</th><th>{{ t('common_purpose',page_locale()) }}</th><th>{{ t('common_category',page_locale()) }}</th><th>{{ t('common_duration',page_locale()) }}</th><th>{{ t('common_provider',page_locale()) }}</th></tr></thead><tbody>{% for cookie in cookie_catalog() %}<tr><td><code>{{ cookie.name }}</code></td><td>{{ t(cookie.purpose,page_locale()) }}</td><td>{{ t(cookie.category,page_locale()) }}</td><td>{{ t(cookie.duration,page_locale()) }}</td><td>{{ cookie.provider }}</td></tr>{% endfor %}</tbody></table></div>
            <p>{{ 'cookie_optional_description'|cms_trans({}) }}</p>
        </section>
    </div>
    <footer class="ew-cookie-actions"><button type="button" data-cookie-reject>{{ t('cookie_reject_optional',page_locale()) }}</button><button type="button" data-cookie-close>{{ t('cookie_settings_close',page_locale()) }}</button><button type="button" class="ew-cookie-primary" data-cookie-save>{{ t('cookie_settings_save',page_locale()) }}</button></footer>
</dialog>
{% if cookie_has_consent('statistics') %}<script data-optional-consent="statistics-enabled">window.__easywiConsentStatistics = true;</script>{% endif %}
{% if cookie_has_consent('marketing') %}<script data-optional-consent="marketing-enabled">window.__easywiConsentMarketing = true;</script>{% endif %}
<script src="{{ asset('js/cookie-consent.js') }}" defer></script>
