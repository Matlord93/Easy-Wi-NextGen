{% macro link(item, active = false) %}
    {% set localPath = item.url|split('?')[0]|split('#')[0]|trim('/') %}
    {% if not item.external and localPath in ['cookies','cookie-richtlinie','cookie-preferences','cookie-preferenzen','cookie-einstellungen'] %}
        <button type="button" class="cms-text-button cms-nav-action" {{ localPath in ['cookies','cookie-richtlinie'] ? 'data-cookie-policy' : 'data-cookie-open' }}>{{ item.label }}</button>
    {% else %}
        <a href="{{ item.url }}"{% if active %} aria-current="page"{% endif %}{% if item.external %} target="_blank" rel="noopener noreferrer"{% endif %}>{{ item.label }}</a>
    {% endif %}
{% endmacro %}
