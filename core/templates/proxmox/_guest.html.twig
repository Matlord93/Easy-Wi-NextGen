{% trans_default_domain 'proxmox' %}
{% if detail %}
<div class="infra-page" data-infra-tabs>
<header class="infra-hero"><div><span class="infra-eyebrow">Proxmox · {{ kind|upper }}</span><h1>{{ vmId }} · {{ detail.guest.name|default(kind) }}</h1><p>{{ detail.status.status|default(detail.guest.status|default('unknown')) }}{% if admin %} · {{ detail.guest.node }}{% endif %}</p></div><div class="infra-actions">{% if not detail.guest.template|default(false) %}{% for action in ['start', 'shutdown'] %}<form action="{{ actionUrl }}" method="post" data-pve-mutation>{% include 'proxmox/_action_fields.html.twig' %}<button class="ui-button {{ action == 'start' ? 'ui-button--primary' : 'ui-button--ghost' }}">{{ ('pve.action.' ~ action)|trans }}</button></form>{% endfor %}{% endif %}</div></header>
<p><a class="ui-button ui-button--ghost" href="{{ admin ? path('admin_infrastructure_history', {provider:'proxmox',connection:cluster.id,kind:kind,reference:vmId}) : path('customer_infrastructure_history', {provider:'proxmox',id:assignment.id}) }}">{{ 'monitor.open_history'|trans({}, 'monitoring') }}</a></p>
<div><div data-infra-usage-url="{{ admin ? path('admin_proxmox_usage', {id: cluster.id, kind: kind, vmId: vmId}) : path('customer_proxmox_usage', {id: assignment.id}) }}">{% include 'infrastructure/_usage_pair.html.twig' with {serverUsage: infra_pve_usage(detail.guest|merge(detail.status)), nodeUsage: infra_pve_usage(detail.nodeUsage|default({}))} %}</div><p data-usage-error hidden>{{ 'infra.refresh_failed'|trans({}, 'infrastructure') }}</p></div>
<nav class="infra-tabs" data-infra-tablist aria-label="{{ vmId }}">{% set panes = ['overview', 'snapshots', 'backups', 'activity'] %}{% if admin %}{% set panes = panes|merge(['settings']) %}{% else %}{% set panes = panes|merge(kind == 'qemu' ? ['settings', 'console'] : ['console']) %}{% endif %}{% for id in panes %}<a href="#pve-{{ id }}" data-infra-tab>{{ ('infra.' ~ id)|trans({}, 'infrastructure') }}</a>{% endfor %}</nav>
<section class="infra-pane infra-card" id="pve-overview" data-infra-pane><div class="infra-card__head"><h2>{{ 'infra.overview'|trans({}, 'infrastructure') }}</h2><span class="infra-tag">{{ kind|upper }}</span></div>
{% if detail.guest.template|default(false) and admin %}<h3>{{ 'pve.clone_template'|trans }}</h3><form method="post" action="{{ actionUrl }}" class="infra-form" data-pve-mutation>{% include 'proxmox/_action_fields.html.twig' with {action: 'clone'} %}<label>{{ 'pve.name'|trans }}<input name="name" class="form-input" pattern="[A-Za-z0-9][A-Za-z0-9.-]{0,62}" maxlength="63" required></label><p>{{ 'pve.clone_hint'|trans }}</p><button class="ui-button ui-button--primary">{{ 'pve.clone_template'|trans }}</button></form>
{% else %}<div class="infra-grid"><div class="infra-stat"><span>vCPU</span><strong>{{ detail.status.cpus|default(detail.guest.maxcpu|default('—')) }}</strong></div><div class="infra-stat"><span>{{ 'pve.memory'|trans }}</span><strong>{{ detail.status.maxmem is defined ? (detail.status.maxmem / 1073741824)|number_format(1) ~ ' GiB' : '—' }}</strong></div><div class="infra-stat"><span>{{ 'pve.disk'|trans }}</span><strong>{{ detail.status.maxdisk is defined ? (detail.status.maxdisk / 1073741824)|number_format(1) ~ ' GiB' : '—' }}</strong></div></div><div class="infra-actions">{% for action in ['stop', 'reboot'] %}<form action="{{ actionUrl }}" method="post" data-pve-mutation>{% include 'proxmox/_action_fields.html.twig' %}<label><input type="checkbox" name="confirm" value="1" required> {{ 'pve.confirm_power'|trans }}</label><button class="ui-button ui-button--ghost">{{ ('pve.action.' ~ action)|trans }}</button></form>{% endfor %}</div>{% endif %}{% include 'proxmox/_disk_inventory.html.twig' %}</section>
<section class="infra-pane" id="pve-snapshots" data-infra-pane>{% if not detail.guest.template|default(false) %}{% include 'proxmox/_pane_snapshots.html.twig' %}{% endif %}</section>
<section class="infra-pane" id="pve-backups" data-infra-pane>{% if not detail.guest.template|default(false) %}{% include 'proxmox/_pane_backups.html.twig' %}{% endif %}</section>
<section class="infra-pane" id="pve-activity" data-infra-pane>{% include 'proxmox/_tasks.html.twig' %}</section>
{% if admin %}<section class="infra-pane infra-grid infra-grid--two" id="pve-settings" data-infra-pane>{% if kind == 'qemu' and not detail.guest.template|default(false) %}{% include 'infrastructure/_guest_agent.html.twig' with {checkUrl:admin ? path('admin_proxmox_guest_agent', {id:cluster.id, kind:kind, vmId:vmId}) : path('customer_proxmox_guest_agent', {id:assignment.id}), checkToken:csrf_token(csrfId)} %}{% endif %}{% if not detail.guest.template|default(false) %}{% include 'proxmox/_pane_resources.html.twig' %}{% include 'proxmox/_pane_disks.html.twig' %}{% include 'proxmox/_pane_extra_disk.html.twig' %}{% include 'proxmox/_pane_provisioning.html.twig' %}{% include 'proxmox/_pane_boot.html.twig' %}{% endif %}{% include 'proxmox/_pane_iso.html.twig' %}{% include 'admin/proxmox/_assignment.html.twig' %}</section>{% else %}{% if kind == 'qemu' %}<section class="infra-pane" id="pve-settings" data-infra-pane>{% if kind == 'qemu' and not detail.guest.template|default(false) %}{% include 'infrastructure/_guest_agent.html.twig' with {checkUrl:admin ? path('admin_proxmox_guest_agent', {id:cluster.id, kind:kind, vmId:vmId}) : path('customer_proxmox_guest_agent', {id:assignment.id}), checkToken:csrf_token(csrfId)} %}{% endif %}{% include 'proxmox/_pane_provisioning.html.twig' %}</section>{% endif %}<section class="infra-pane" id="pve-console" data-infra-pane>{% include 'vm_console/_console.html.twig' with {provider: 'proxmox'} %}</section>{% endif %}
</div>
{% endif %}
