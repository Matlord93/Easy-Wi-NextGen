{% trans_default_domain 'proxmox' %}
<section class="ng-data-card">
 <div class="ng-data-card__header"><h2>{{ 'pve.backups'|trans }}</h2></div>
 <div class="ng-data-card__body infra-operation-grid">
 {% set backupStorages = detail.storages|filter(s => s.active|default(false) and 'backup' in s.content|default('')|split(',')) %}
 {% if backupStorages is empty %}<p>{{ 'pve.backup_unavailable'|trans }}</p>{% endif %}
 <form method="post" action="{{ actionUrl }}" data-pve-mutation style="display:grid;gap:12px;max-width:700px;">{% include 'proxmox/_action_fields.html.twig' with {action: 'backup'} %}<label>{{ 'pve.storage'|trans }}<select name="storage" class="form-input" required>{% for storage in detail.storages|filter(s => s.active|default(false) and 'backup' in s.content|default('')|split(',')) %}<option value="{{ storage.storage }}">{{ storage.storage }}</option>{% endfor %}</select></label><label>{{ 'pve.backup_mode'|trans }}<select name="mode" class="form-input">{% for mode in ['snapshot', 'suspend', 'stop'] %}<option value="{{ mode }}">{{ mode }}</option>{% endfor %}</select></label><p>{{ 'pve.backup_hint'|trans }}</p><button class="ui-button ui-button--primary" {{ backupStorages is empty ? 'disabled' : '' }}>{{ 'pve.action.backup'|trans }}</button></form>
 <div class="infra-table-wrap"><table class="infra-table"><tbody>{% for backup in detail.backups %}<tr><td style="word-break:break-all;">{{ backup.volid }}</td><td><div style="display:flex;flex-wrap:wrap;gap:12px;">{% for action in (admin ? ['backup-restore', 'backup-delete'] : []) %}<form method="post" action="{{ actionUrl }}" data-pve-mutation>{% include 'proxmox/_action_fields.html.twig' %}<input type="hidden" name="volume" value="{{ backup.volid }}"><input type="hidden" name="storage" value="{{ backup.storage }}">{% if action == 'backup-restore' %}<label>{{ 'pve.restore_storage'|trans }}<select name="target_storage" class="form-input" required>{% for storage in detail.storages|filter(s => s.active|default(false) and (kind == 'qemu' ? 'images' : 'rootdir') in s.content|default('')|split(',')) %}<option value="{{ storage.storage }}">{{ storage.storage }}</option>{% endfor %}</select></label>{% endif %}<label style="display:block;"><input type="checkbox" name="confirm" value="1" required> {{ (action == 'backup-restore' ? 'pve.confirm_restore' : 'pve.confirm_delete_backup')|trans }}</label><button class="ui-button ui-button--ghost">{{ ('pve.action.' ~ action)|trans }}</button></form>{% endfor %}</div></td></tr>{% else %}<tr><td>{{ 'pve.no_backups'|trans }}</td></tr>{% endfor %}</tbody></table></div>
 </div>
</section>
