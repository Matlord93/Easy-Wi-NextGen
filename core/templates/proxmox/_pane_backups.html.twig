{% trans_default_domain 'proxmox' %}
{% set backupStorages = detail.storages|filter(storage => storage.active|default(false) and 'backup' in storage.content|default('')|split(',')) %}
{% set restoreStorages = admin ? detail.storages|filter(storage => storage.active|default(false) and (kind == 'qemu' ? 'images' : 'rootdir') in storage.content|default('')|split(',')) : [] %}
{% set stopped = detail.status.status|default('') == 'stopped' %}
{% set activeTask = tasks|filter(task => task.active) is not empty %}
{% set hasSnapshots = detail.snapshots|filter(snapshot => snapshot.name|default('') != 'current') is not empty %}
<section class="ng-data-card">
    <div class="ng-data-card__header"><h2>{{ 'pve.backups'|trans }}</h2></div>
    <div class="ng-data-card__body infra-operation-grid">
        <form method="post" action="{{ actionUrl }}" class="infra-form" data-pve-mutation>
            {% include 'proxmox/_action_fields.html.twig' with {action: 'backup'} %}
            <label>{{ 'pve.storage'|trans }}
                <select name="storage" class="form-input" required>
                    {% for storage in backupStorages %}<option value="{{ storage.storage }}">{{ storage.storage }}</option>{% endfor %}
                </select>
            </label>
            <label>{{ 'pve.backup_mode'|trans }}
                <select name="mode" class="form-input">
                    {% for mode in ['snapshot', 'suspend', 'stop'] %}<option value="{{ mode }}">{{ mode }}</option>{% endfor %}
                </select>
            </label>
            <p>{{ (backupStorages is empty ? 'pve.backup_unavailable' : 'pve.backup_hint')|trans }}</p>
            <button class="ui-button ui-button--primary" {{ backupStorages is empty ? 'disabled' : '' }}>{{ 'pve.action.backup'|trans }}</button>
        </form>
        <div class="infra-table-wrap">
            {% if not admin and detail.backups is not empty %}
                <p>{{ 'pve.restore_customer_hint'|trans }}</p>
                {% if activeTask %}<p role="status">{{ 'pve.error.task_active'|trans }}</p>
                {% elseif not stopped %}<p role="status">{{ 'pve.error.restore_running'|trans }}</p>
                {% elseif hasSnapshots %}<p role="status">{{ 'pve.error.restore_snapshots'|trans }}</p>
                {% endif %}
            {% endif %}
            <table class="infra-table"><tbody>
                {% for backup in detail.backups %}
                    <tr><td style="word-break:break-all;">{{ backup.volid }}</td><td>
                        <div class="infra-actions">
                            {% for action in (admin ? ['backup-restore', 'backup-delete'] : ['backup-restore']) %}
                                {% set restore = action == 'backup-restore' %}
                                {% set blocked = restore and (admin ? restoreStorages is empty : not stopped or hasSnapshots or activeTask) %}
                                <form method="post" action="{{ actionUrl }}" data-pve-mutation>
                                    {% include 'proxmox/_action_fields.html.twig' %}
                                    <input type="hidden" name="volume" value="{{ backup.volid }}">
                                    <input type="hidden" name="storage" value="{{ backup.storage }}">
                                    {% if restore and admin %}
                                        <label>{{ 'pve.restore_storage'|trans }}
                                            <select name="target_storage" class="form-input" required>
                                                {% for storage in restoreStorages %}<option value="{{ storage.storage }}">{{ storage.storage }}</option>{% endfor %}
                                            </select>
                                        </label>
                                    {% endif %}
                                    <label class="infra-span">
                                        <input type="checkbox" name="confirm" value="1" required {{ blocked ? 'disabled' : '' }}>
                                        {{ (restore ? 'pve.confirm_restore' : 'pve.confirm_delete_backup')|trans }}
                                    </label>
                                    <button class="ui-button ui-button--ghost" {{ blocked ? 'disabled' : '' }}>{{ ('pve.action.' ~ action)|trans }}</button>
                                </form>
                            {% endfor %}
                        </div>
                    </td></tr>
                {% else %}
                    <tr><td>{{ 'pve.no_backups'|trans }}</td></tr>
                {% endfor %}
            </tbody></table>
        </div>
    </div>
</section>
