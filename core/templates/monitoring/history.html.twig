{% extends admin ? 'admin/base.html.twig' : 'customer/base.html.twig' %}
{% trans_default_domain 'monitoring' %}
{% set pageTitle = 'monitor.history'|trans %}
{% block content %}
<link rel="stylesheet" href="{{ asset('infrastructure.css') }}">
<link rel="stylesheet" href="{{ asset('monitoring.css') }}">
<div class="infra-page"><header class="infra-hero"><div><span class="infra-eyebrow">{{ target.provider|upper }} · {{ target.kind|upper }}</span><h1>{{ 'monitor.history'|trans }}</h1><p>{{ target.label }}</p></div><div class="infra-actions"><a href="{{ admin ? target.adminUrl : target.customerUrl }}" class="ui-button ui-button--ghost">{{ 'monitor.back'|trans }}</a>{% if admin %}<a href="{{ path('admin_infrastructure_monitoring') }}" class="ui-button ui-button--ghost">{{ 'monitor.settings'|trans }}</a>{% endif %}</div></header>
{% if error %}<p class="infra-card" role="alert">{{ error|trans }}</p>{% endif %}
<section class="infra-card" data-monitor-history data-locale="{{ page_locale() }}" data-loading="{{ 'monitor.loading'|trans }}" data-failed="{{ 'monitor.failed'|trans }}" data-empty="{{ 'monitor.empty'|trans }}" data-summary="{{ 'monitor.summary'|trans }}" data-resolution="{{ 'monitor.resolution'|trans }}" data-source="{{ 'monitor.source'|trans }}" data-timezone="Europe/Berlin">
<form data-monitor-range class="infra-form"><label>{{ 'monitor.range'|trans }}<select class="form-input" name="hours">{% for value,label in {1:'hour',6:'six_hours',24:'day',168:'week',720:'month',2160:'quarter',8760:'year',custom:'custom'} %}<option value="{{ value }}" {{ value == 24 ? 'selected' : '' }}>{{ ('monitor.range.' ~ label)|trans }}</option>{% endfor %}</select></label><label data-monitor-custom hidden>{{ 'monitor.from'|trans }}<input type="datetime-local" name="from" class="form-input"></label><label data-monitor-custom hidden>{{ 'monitor.to'|trans }}<input type="datetime-local" name="to" class="form-input"></label><button class="ui-button ui-button--primary">{{ 'monitor.show'|trans }}</button><a data-monitor-export class="ui-button ui-button--ghost" href="?hours=24&amp;format=csv">{{ 'monitor.export'|trans }}</a></form>
<p>{{ 'monitor.retention_hint'|trans({'%days%':options.retention_days}) }}</p><p role="status" aria-live="polite" data-monitor-status></p><p data-monitor-summary></p>
<div class="infra-grid infra-grid--two">{% for chart in ['load','disk','network','io'] %}<section class="monitor-chart"><h2>{{ ('monitor.chart.' ~ chart)|trans }}</h2><svg data-monitor-chart="{{ chart }}" viewBox="0 0 640 200" role="img" aria-label="{{ ('monitor.chart.' ~ chart)|trans }}"></svg><p data-monitor-legend="{{ chart }}"></p></section>{% endfor %}</div>
<p>{{ 'monitor.average_hint'|trans }}</p><p>{{ 'monitor.utc_hint'|trans }}</p></section>
<section class="infra-card"><h2>{{ 'monitor.alarms'|trans }}</h2><p>{{ 'monitor.alarm_hint'|trans }}</p>
<div class="infra-grid">{% for field in ['cpu_percent','memory_percent','disk_percent','offline'] %}{% set alarm = policy.state[field]|default({}) %}<p>{{ ('monitor.' ~ field)|trans }}: <strong>{{ (alarm.active|default(false) ? 'monitor.active' : (alarm.unknown|default(false) or not alarm.last|default(0) ? 'monitor.unknown' : 'monitor.normal'))|trans }}</strong>{% if alarm.last|default(0) %}<br><small>{{ alarm.last|date('d.m.Y H:i:s', 'Europe/Berlin') }}</small>{% endif %}</p>{% endfor %}</div>
{% if admin %}<form method="post" class="infra-form"><input type="hidden" name="_token" value="{{ csrf_token('infrastructure-policy-' ~ target.key) }}"><label class="infra-span"><span><input type="checkbox" name="alerts_enabled" value="1" {{ policy.thresholds.alerts_enabled|default(options.alerts_enabled) ? 'checked' : '' }}> {{ 'monitor.alerts_enabled'|trans }}</span></label>{% for field in ['cpu_percent','memory_percent','disk_percent'] %}<label>{{ ('monitor.' ~ field)|trans }}<input type="number" class="form-input" name="{{ field }}" value="{{ policy.thresholds[field]|default(options[field]) }}" min="1" max="100" required></label>{% endfor %}<button class="ui-button ui-button--primary">{{ 'monitor.save'|trans }}</button></form>{% endif %}</section>
</div>
<script src="{{ asset('js/infrastructure-monitoring.js') }}" defer></script>
{% endblock %}
